  "steps": [
    {
      "text": "虾去头剥壳剪开背，去掉肠泥，用黑胡椒粉和一勺蚝油拌匀腌制,"
    },
    {
      "text": "葱和蒜都切碎，泡菜切小段,"
    },
    {
      "text": "锅中放油烧热，倒入虾仁，放一点点料酒，翻炒至变色，盛出备用,"
    },
    {
      "text": "用锅中余油爆香蒜末,"
    },
    {
      "text": "倒入切好的泡菜和少许泡菜汁，炒半分钟,"
    },
    {
      "text": "倒入步骤3的虾仁，翻炒片刻，放一点鸡精炒匀，撒上葱花出锅"
    }
  ],
