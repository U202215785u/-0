  "steps": [
    {
      "text": "全部材料混合后揉至大片有韧性的薄膜,"
    },
    {
      "text": "揉好的面团基础发酵至2倍大,"
    },
    {
      "text": "分成三等份，排气滚圆，松驰20分钟,"
    },
    {
      "text": "擀卷两次后放入吐司模最后发酵近8分满。（两次擀卷中间，让面团松驰8分钟）,"
    },
    {
      "text": "发酵好的面团放入预热好的烤箱180度烤45分钟"
    }
  ],
