  "steps": [
    {
      "text": "先把腊肉洗净，去除表面的浮土后，放入锅中蒸30分钟，蒸熟后切成薄片备用,"
    },
    {
      "text": "杭椒，红辣椒洗净后，斜切成段。洋葱切成细丝备用,"
    },
    {
      "text": "锅中倒入水，大火煮开后，倒入料酒，放入鸡胗焯烫1分钟后捞出，晾凉后切成薄片,"
    },
    {
      "text": "锅中倒入油，放入花椒和干红辣椒，炒出麻辣味后，放入鸡胗片炒20秒钟，然后洋葱丝，腊肉片和青红椒段,"
    },
    {
      "text": "倒入生抽和老抽，翻炒2分钟，最后加入一勺柱候酱搅匀即可出锅"
    }
  ],
