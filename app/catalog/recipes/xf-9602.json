  "steps": [
    {
      "text": "马蹄，胡萝卜去皮切小丁，卢笋切小段，西生菜修剪成碗状,"
    },
    {
      "text": "将三文鱼肉切成小方块状,"
    },
    {
      "text": "将鱼肉用腌鱼料拌匀，腌制15分钟,"
    },
    {
      "text": "锅内热油至180度，放入鱼肉丁，中火炸约2分钟,"
    },
    {
      "text": "捞起沥净油。（也可用快火炒的，但不能炒碎了）,"
    },
    {
      "text": "锅内热少许油，加入胡萝卜，马蹄，卢笋，盐1/4小匙，大火翻炒约1分钟,"
    },
    {
      "text": "加入三文鱼丁翻炒均匀,"
    },
    {
      "text": "最后洒上玉米脆片，装在西生菜碗内即可"
    }
  ],
