  "steps": [
    { "text": "和面：取一碗，将水分次加入面粉，边加边搅拌，直至看不到干粉，然后揉合成团，盖好静置 10 分钟，再揉至光滑。", "ingredientNames": ["中筋面粉", "水"], "timerSeconds": 600 },
    { "text": "继续盖好静置 30 至 60 分钟，让面团变软；若用厨师机：把面粉和水放入搅拌碗，低速揉约 8 分钟至光滑，盖好静置 30 至 60 分钟。", "ingredientNames": ["中筋面粉", "水"] },
    { "text": "调馅：猪肉末放入碗中，加入盐、香油和五香粉（或用花椒粉、白胡椒粉代替），朝同一方向搅拌，同时分次加入水（或高汤）；待水分完全被吸收、肉馅发粘后，加入韭菜拌匀。", "ingredientNames": ["猪肉末", "盐", "香油", "五香粉", "水", "韭菜"] },
    { "text": "分剂子：把面团分成三份，取一份搓成长条并切成 10 等份（其余两份盖好防干）；把面剂用手掌压成小圆饼，再用擀面杖擀成薄圆片，粘手时撒少许面粉，重复做完所有面团。", "ingredientNames": ["中筋面粉"] },
    { "text": "包制：取一勺馅料放在面皮中央，用顺手的方式折起并捏紧封口；若用冷冻饺子皮，需提前冷藏解冻，包制时边缘沾少许水再折叠捏紧。", "ingredientNames": ["猪肉末", "韭菜"] },
    { "text": "煎制：平底锅中放少量油（口径约 30 厘米的锅约 1 汤匙），放入锅贴（锅不够大可分两批），大火煎至底部金黄（可掀起一只查看）。", "ingredientNames": ["食用油"] },
    { "text": "加水焖蒸：向锅中倒入冷水，至没过锅贴高度约三分之一，盖上锅盖，保持大火，直至水分完全蒸发。", "ingredientNames": ["水"] },
    { "text": "收尾：揭开锅盖再煎约 20 秒，让底部更脆，盛盘；可单吃，或配辣椒油与黑米醋调成的蘸汁。", "ingredientNames": ["辣椒油", "黑米醋"], "timerSeconds": 20 }
  ],
  "durationMinutes": 90,
  "difficulty": "中等",
