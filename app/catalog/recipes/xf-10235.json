  "steps": [
    {
      "text": "烧一锅水，滴几滴油，水开后放进芥蓝灼烫至变青绿,"
    },
    {
      "text": "全部转色后，捞起沥干水分,"
    },
    {
      "text": "热油锅，爆香姜片,"
    },
    {
      "text": "放腊肠进锅，翻炒至腊肠变透明,"
    },
    {
      "text": "倒进沥干水分的芥蓝，爆炒1分钟,"
    },
    {
      "text": "加入白酒，翻炒均匀,"
    },
    {
      "text": "加入白糖、盐翻炒均匀,"
    },
    {
      "text": "装碟上桌"
    }
  ],
