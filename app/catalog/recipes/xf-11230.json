  "steps": [
    {
      "text": "熏豆腐干200克，腌豇豆100克，青红椒各一个，蒜3瓣，干红椒两三个,"
    },
    {
      "text": "豇豆切成1厘米长的小段，豆干和青红椒切成方块，蒜切末，干红椒切段,"
    },
    {
      "text": "热锅凉油，爆香蒜末和干红椒,"
    },
    {
      "text": "加入豇豆翻炒一分钟,"
    },
    {
      "text": "加入豆干翻炒一分钟，调入盐，花椒粉,"
    },
    {
      "text": "加入青红椒翻炒至断生，加入太太乐鸡精炒匀，以湿淀粉勾薄芡"
    }
  ],
