{
  "id": "xf-9763",
  "title": "手指饼干",
  "ingredients": [
    {
      "name": "低筋面粉",
      "mergeKey": "cake-flour",
      "amount": 70,
      "unit": "克",
      "category": "米面主食"
    },
    {
      "name": "蛋黄",
      "mergeKey": "egg-yolk",
      "amount": 3,
      "unit": "个",
      "category": "蛋类"
    },
    {
      "name": "蛋白",
      "mergeKey": "egg-white",
      "amount": 3,
      "unit": "个",
      "category": "蛋类"
    },
    {
      "name": "细砂糖",
      "mergeKey": "sugar",
      "amount": 55,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "蛋黄和蛋白分别盛入干净的碗里备用,"
    },
    {
      "text": "蛋白用打蛋器打至起粗泡的时候，分次加入35克的细砂糖，用打蛋器打发至干性发泡,"
    },
    {
      "text": "蛋黄里加入剩下的20克细砂糖，打至浓稠状,"
    },
    {
      "text": "取1/2的蛋白到蛋黄碗中，筛入一半的面粉,"
    },
    {
      "text": "轻轻翻拌均匀,"
    },
    {
      "text": "重复第四步，将剩余的蛋白和面粉加入，翻拌均匀,"
    },
    {
      "text": "烤盘垫锡纸或油纸,"
    },
    {
      "text": "将面糊装入裱花袋中，用中号圆孔花嘴在烤盘中挤出条状面糊，放入190度预热的烤箱，中层，烤10分钟"
    }
  ],
