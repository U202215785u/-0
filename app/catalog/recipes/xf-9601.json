  "steps": [
    {
      "text": "鱼头先用料酒，细盐涂抹腌制10分钟。豆腐切小方块、大蒜用刀拍裂、香葱切段、姜切片、红椒切片,"
    },
    {
      "text": "锅烧热，放入1大匙油烧热，放入沥净水的豆腐块小火慢煎,"
    },
    {
      "text": "中途用筷子翻动，让四面都煎成金黄色,"
    },
    {
      "text": "热锅热油，放入擦干水份的鱼头小火慢煎,"
    },
    {
      "text": "煎完一面后，反面煎并放入姜片同煎，煎好后加入清水煮开,"
    },
    {
      "text": "加入煎好的豆腐及所有调味料，大火煮开后转小火,"
    },
    {
      "text": "最后加入青葱段及水淀粉勾芡，装盘后表面摆上红椒装饰"
    }
  ],
