  "title": "荷兰豆炒腊肉",
  "ingredients": [
    {
      "name": "腊肉",
      "mergeKey": "cured-pork",
      "category": "肉类"
    },
    {
      "name": "荷兰豆",
      "mergeKey": "snow-pea",
