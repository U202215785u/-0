{
  "id": "xf-11336",
  "title": "南瓜浓汤",
  "ingredients": [
    {
      "name": "小南瓜",
      "mergeKey": "pumpkin",
      "amount": 1,
      "unit": "个",
      "category": "蔬菜"
    },
    {
      "name": "小葱",
      "mergeKey": "scallion",
      "amount": 30,
      "unit": "克",
      "category": "蔬菜"
    },
    {
      "name": "盐",
      "mergeKey": "salt",
      "quantityText": "适量",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "小南瓜去皮，洗净，切片，入锅蒸熟,"
    },
    {
      "text": "从锅里取出来，趁热用搅拌器搅成泥,"
    },
    {
      "text": "高汤慢慢拌入南瓜泥内调匀直至成稀糊状（不要太稀,"
    },
    {
      "text": "倒入锅中煮开，边煮边搅，并加盐调味，煮至汤汁粘稠时，加入芡汁勾芡，煮匀即关火。（使用芡汁可使南瓜泥凝聚，否则会发生分解，口感不好,"
    },
    {
      "text": "盛出后撒上碎葱花"
    }
  ],
