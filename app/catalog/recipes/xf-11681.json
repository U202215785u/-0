  "title": "辣白菜拌土豆丝",
  "ingredients": [
    {
      "name": "带汤汁发酵的辣白菜",
      "mergeKey": "kimchi",
      "amount": 0.5,
      "unit": "颗",
      "category": "蔬菜"
    },
    {
      "name": "青椒半个中等大小土豆",
