  "steps": [
    {
      "text": "将大蒜、姜、姜黄粉、葛拉姆马萨拉、香菜籽粉和孜然粉放入小碗混合。另取中碗，放入酸奶、粗盐和一半香料混合物搅匀，加入 907 克鸡胸肉翻拌裹匀，盖好冷藏腌制 4–6 小时。剩余香料混合物盖好冷藏备用。",
      "timerSeconds": 14400,
      "ingredientNames": [
        "大蒜",
        "姜",
        "姜黄粉",
        "葛拉姆马萨拉香料粉",
        "香菜籽粉",
        "孜然粉",
        "全脂酸奶",
        "粗盐（犹太盐）",
        "去皮去骨鸡胸肉"
      ]
    },
    {
      "text": "中火加热大厚底锅中的酥油。加入 1 个小洋葱（切薄丝）、60 毫升番茄膏、6 颗豆蔻荚（压碎）和干辣椒，经常翻动，炒至番茄膏颜色变深、洋葱变软，约 5 分钟。加入剩下的一半香料混合物，继续经常翻动，炒到锅底开始上色，约 4 分钟。",
      "timerSeconds": 300,
      "ingredientNames": [
        "酥油（澄清黄油）或植物油",
        "小洋葱",
        "番茄膏",
        "豆蔻荚",
        "干辣椒（树椒）"
      ]
    },
    {
      "text": "用手把去皮整番茄罐头中的番茄连汁捏碎放入锅中。煮沸后转小火，经常翻动并刮起锅底焦化物，煮到酱汁变稠，8–10 分钟。",
      "timerSeconds": 480,
      "ingredientNames": [
        "去皮整番茄罐头"
      ]
    },
    {
      "text": "加入淡奶油和 180 毫升香菜碎，不时搅拌，煮到酱汁变稠，30–40 分钟。",
      "timerSeconds": 1800,
      "ingredientNames": [
        "淡奶油",
        "香菜"
      ]
    },
    {
      "text": "同时，预热烤箱上火（炙烤档）。烤盘铺锡纸并放入金属网架，把鸡胸肉单层摆在架上。炙烤至鸡肉局部开始变黑（此时尚未全熟），约 10 分钟。",
      "timerSeconds": 600,
      "ingredientNames": [
        "去皮去骨鸡胸肉"
      ]
    },
    {
      "text": "把鸡肉切成入口大小，加入酱汁中，不时搅拌，煮至鸡肉全熟，8–10 分钟。配蒸好的印度香米饭上桌，用香菜整枝点缀。",
      "timerSeconds": 480,
      "ingredientNames": [
        "去皮去骨鸡胸肉",
        "印度香米",
        "香菜"
      ]
    }
  ],
  "baseServings": 6,
