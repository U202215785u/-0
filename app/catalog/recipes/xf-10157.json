  "steps": [
    {
      "text": "盐用一点点热水化开，兑到凉水中，用盐水和面，揉成面团，醒30分钟,"
    },
    {
      "text": "番茄去皮切块，虾处理干净去壳，去虾线加一点料酒拌匀去腥,"
    },
    {
      "text": "醒好的面团擀成大薄片,"
    },
    {
      "text": "折叠好切成宽条,"
    },
    {
      "text": "锅内烧热油下番茄炒软，加水烧开,"
    },
    {
      "text": "下面片，记得下面片的时候用手抻一下，拉薄,"
    },
    {
      "text": "面片出锅前一分钟下虾仁，盐，胡椒粉即可"
    }
  ],
