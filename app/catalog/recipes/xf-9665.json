  "steps": [
    {
      "text": "准备材料,"
    },
    {
      "text": "猪肝切片后，在水中清洗后，泡水30分钟,"
    },
    {
      "text": "将猪肝用5克淀粉，料酒，腌10分钟，葱切末，姜切末，蒜切末，黄瓜切片，胡萝卜切片,"
    },
    {
      "text": "锅中放油，倒入猪肝炒至8成熟取出,"
    },
    {
      "text": "锅中重新放油，倒入葱姜蒜末,"
    },
    {
      "text": "倒入黄瓜片,"
    },
    {
      "text": "倒入胡萝卜片,"
    },
    {
      "text": "小炒一下后，倒入猪肝,"
    },
    {
      "text": "加入盐，最后用5克淀粉和15毫升水和成的水淀粉液倒入锅中，收汁即可"
    }
  ],
