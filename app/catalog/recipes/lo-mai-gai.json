  "steps": [
    {
      "text": "荷叶放入温水中浸泡2小时；糯米至少淘洗三遍。",
      "ingredientNames": [
        "荷叶",
        "清水",
        "糯米"
      ]
    },
    {
      "text": "锅中水沸后放入咸蛋煮2分钟，捞入冷水中降温；鸡腿肉去皮并沿骨剖开去骨。",
      "ingredientNames": [
        "咸蛋",
        "清水",
        "鸡腿肉"
      ]
    },
    {
      "text": "干香菇温水泡10至15分钟，挤干后切片，保留泡香菇水；腊肠、叉烧和红葱头切好。",
      "ingredientNames": [
        "干香菇",
        "清水",
        "广式腊肠",
        "叉烧",
        "红葱头"
      ]
    },
    {
      "text": "鸡腿肉加入玉米淀粉抓匀；炒锅大火预热2至3分钟，加入食用油，炒香鸡肉、腊肠、叉烧、香菇和红葱头。",
      "ingredientNames": [
        "鸡腿肉",
        "玉米淀粉",
        "食用油",
        "广式腊肠",
        "叉烧",
        "干香菇",
        "红葱头"
      ]
    },
    {
      "text": "加入蚝油、生抽、老抽、鸡粉、白糖和食盐调味，翻炒至馅料熟透；咸蛋放凉后剥壳取蛋黄。",
      "ingredientNames": [
        "蚝油",
        "生抽",
        "老抽",
        "鸡粉",
        "白糖",
        "食盐",
        "咸蛋"
      ]
    },
    {
      "text": "将泡香菇水、清水、蚝油、生抽和食用油混合成拌米汁，倒入糯米拌匀。",
      "ingredientNames": [
        "干香菇",
        "清水",
        "蚝油",
        "生抽",
        "食用油",
        "糯米"
      ]
    },
    {
      "text": "荷叶摊开，铺糯米、馅料和咸蛋黄，再盖一层糯米，折叠包紧。",
      "ingredientNames": [
        "荷叶",
        "糯米",
        "咸蛋",
        "鸡腿肉",
        "广式腊肠",
        "叉烧",
        "干香菇"
      ]
    },
    {
      "text": "蒸锅加水大火烧沸，放入糯米鸡，盖盖蒸至糯米熟透、荷叶香味渗入。",
      "ingredientNames": [
        "清水",
        "荷叶",
        "糯米"
      ]
    },
    {
      "text": "出锅后趁热食用。",
      "ingredientNames": []
    }
  ],
  "baseServings": 4,
