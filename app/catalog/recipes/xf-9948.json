{
  "id": "xf-9948",
  "title": "鸭血豆腐羹",
  "ingredients": [
    {
      "name": "鸭血",
      "mergeKey": "duck-blood",
      "amount": 1,
      "unit": "块",
      "category": "肉类"
    },
    {
