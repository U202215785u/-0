  "steps": [
    {
      "text": "尖椒洗净去籽，擦干内外的水,"
    },
    {
      "text": "锅内烧热油下尖椒煸至表皮发皱,"
    },
    {
      "text": "尖椒盛出备用，锅内余油煸香蒜蓉，下肉末煸炒至焦黄，加生抽，糖炒匀,"
    },
    {
      "text": "倒入尖椒，翻炒均匀，倒入一大勺温水，翻炒至汤汁收干，加少许盐，胡椒粉炒匀即可"
    }
  ],
