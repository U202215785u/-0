  "steps": [
    {
      "text": "虾去壳去虾线，鱼柳擦干，分别拍剁成泥后拌匀。",
      "ingredientNames": [
        "虾",
        "鲶鱼柳"
      ]
    },
    {
      "text": "鱼虾泥加入食盐、白糖、白胡椒粉、玉米淀粉和清水，充分搅拌至黏稠，冷藏。",
      "ingredientNames": [
        "食盐",
        "白糖",
        "白胡椒粉",
        "玉米淀粉",
        "清水"
      ]
    },
    {
      "text": "嫩豆腐倒掉包装水，切成十块，擦干；表面撒少量玉米淀粉，葱切末。",
      "ingredientNames": [
        "嫩豆腐",
        "玉米淀粉",
        "葱"
      ]
    },
    {
      "text": "每块豆腐放约一汤匙鱼虾馅，表面抹食用油；鱼露、蚝油、白糖、清水和玉米淀粉调成酱汁。",
      "ingredientNames": [
        "嫩豆腐",
        "虾",
        "鲶鱼柳",
        "食用油",
        "鱼露",
        "蚝油",
        "白糖",
        "清水",
        "玉米淀粉"
      ]
    },
    {
      "text": "水沸后放入蒸盘，盖盖蒸8至10分钟至馅心凝固，撒葱。",
      "ingredientNames": [
        "嫩豆腐",
        "葱"
      ]
    },
    {
      "text": "清锅后倒入酱汁，加少量食用油煮沸并调至顺滑，浇在蒸酿豆腐上。",
      "ingredientNames": [
        "鱼露",
        "蚝油",
        "白糖",
        "清水",
        "玉米淀粉",
        "食用油"
      ]
    }
  ],
