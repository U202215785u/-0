  "steps": [
    {
      "text": "干香菇清洗两遍，放入40至50℃温水浸泡30分钟；小白菜去掉老根，逐片洗净。",
      "ingredientNames": [
        "干香菇",
        "清水",
        "小白菜"
      ]
    },
    {
      "text": "蒜去皮切片，姜切薄片；泡发香菇剪去蒂，挤出多余水分，保留泡香菇的水。",
      "ingredientNames": [
        "蒜",
        "姜",
        "干香菇",
        "清水"
      ]
    },
    {
      "text": "将蚝油、生抽、老抽、白糖、食盐和绍兴料酒混合成酱汁。",
      "ingredientNames": [
        "蚝油",
        "生抽",
        "老抽",
        "白糖",
        "食盐",
        "绍兴料酒"
      ]
    },
    {
      "text": "中火烧热炒锅，加食用油，放入小白菜翻炒至叶片变软，先盛出铺盘。",
      "ingredientNames": [
        "食用油",
        "小白菜"
      ]
    },
    {
      "text": "擦干炒锅，低火加入食用油、姜和蒜，炒40至50秒出香味；加入香菇和泡香菇水，再倒入酱汁焖煮至入味。",
      "ingredientNames": [
        "食用油",
        "姜",
        "蒜",
        "干香菇",
        "清水",
        "蚝油",
        "生抽",
        "老抽",
        "白糖",
        "食盐",
        "绍兴料酒"
      ]
    },
    {
      "text": "玉米淀粉加少量清水调匀，倒入锅中收汁，加入鸡粉和芝麻油调味；香菇摆在小白菜中央，淋上酱汁。",
      "ingredientNames": [
        "玉米淀粉",
        "清水",
        "鸡粉",
        "芝麻油"
      ]
    }
  ],
  "baseServings": 4,
