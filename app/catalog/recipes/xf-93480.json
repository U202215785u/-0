  "steps": [
    {
      "text": "将猪瘦肉洗净，切成均匀细丝"
    },
    {
      "text": "加入料酒、盐、湿淀粉、蛋清抓匀上浆"
    },
    {
      "text": "将葱白切成丝，码放盘子中"
    },
    {
      "text": "炒锅注油烧至五成热，下肉丝炒至变色，盛出待用"
    },
    {
      "text": "炒锅注少许油，下葱末爆香，放入甜面酱略炒，加入少许清水、料酒、白糖、味精不停炒动，待变色出香味，倒入肉丝翻炒均匀"
    },
    {
      "text": "出锅盛在葱丝上面，食时拌匀即成"
    }
  ],
