      "pantry": true
    },
    {
      "name": "蛋黄",
      "mergeKey": "egg-yolk",
      "amount": 5,
      "unit": "个",
      "category": "蛋类"
    },
    {
      "name": "细砂糖",
      "mergeKey": "sugar",
      "amount": 50,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "蛋白",
      "mergeKey": "egg-white",
      "amount": 4,
