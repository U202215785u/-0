  "steps": [
    {
      "text": "准备材料,"
    },
    {
      "text": "锅中放少许油,"
    },
    {
      "text": "倒入肉酱炒香后，加入葱末，甜面酱，豆瓣酱，和适量的水少煮片刻,"
    },
    {
      "text": "汤锅中放水煮开，水中加少许油和盐,"
    },
    {
      "text": "倒入通心粉,"
    },
    {
      "text": "煮好后，取出,"
    },
    {
      "text": "意面加入少许油搅拌,"
    },
    {
      "text": "搅拌好后，加入面酱搅拌好即可"
