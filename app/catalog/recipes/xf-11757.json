  "steps": [
    {
      "text": "白菜用海盐腌6个小时,"
    },
    {
      "text": "白萝卜、胡萝卜切丝，用海盐腌2小时,"
    },
    {
      "text": "把腌好的白菜、萝卜丝用冲洗一下，挤干水分,"
    },
    {
      "text": "白菜切成2厘米左右的段，再加入全部原料混合均匀,"
    },
    {
      "text": "最后装入密封的盒子，放在阴凉的地方，2天后就可以吃了"
    }
