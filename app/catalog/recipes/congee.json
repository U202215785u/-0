  "steps": [
    { "text": "淘米：把大米放在流动水下快速冲洗一下即可。", "ingredientNames": ["大米"] },
    { "text": "常规做法：锅中水烧至完全沸腾，放入大米；待水再次沸腾后转最小火并搅拌；待水面转为极轻的咕嘟状态后盖上锅盖，煮 35 至 40 分钟，至粥浓稠到自己喜欢的程度，期间搅拌数次。", "ingredientNames": ["水", "大米"], "timerSeconds": 2100 },
    { "text": "快捷做法：把冲洗过的大米放冷冻室冻过夜至完全冻结，将冻成块的米直接放入沸水（水量减至 6 杯，约 1440 毫升），按上述方法煮 10 至 15 分钟即可。", "ingredientNames": ["大米", "水"], "timerSeconds": 600 },
    { "text": "提前准备：若打算隔天食用，可稍微多放些水，因为粥放凉之后会变稠；剩余粥放入冰箱可保存最多 3 天，重新加热时用小火并时常搅拌，若显得过稠可加少许水。", "ingredientNames": ["水"] },
    { "text": "享用：可原味直接吃，也可按个人喜好加入生抽、香油、辣椒油、葱花、姜丝、香菜、榨菜、皮蛋、油条、肉松、烤花生米、芝麻等任意搭配的调味料和配料。", "ingredientNames": ["生抽", "香油", "辣椒油", "葱花", "姜丝", "香菜", "榨菜", "皮蛋", "油条", "肉松", "烤花生米", "芝麻"] }
  ],
