  "steps": [
    {
      "text": "红、黄柿子椒各一个（其实每个只用了一半），姜一小块，鸡胸肉一块,"
    },
    {
      "text": "鸡胸肉斜切薄片（如果是冷冻的， 半解冻状态容易切,"
    },
    {
      "text": "用盐、花椒粉、米酒、香油，一点点生抽，一小勺生粉，半个鸡蛋清拌匀，腌渍十分钟,"
    },
    {
      "text": "姜切片，柿子椒去籽切块,"
    },
    {
      "text": "锅下油，五分热，倒入鸡片滑散，炒至变色盛出,"
    },
    {
      "text": "重起锅热少量油，入姜片和椒块，调入盐，大火翻炒至断生,"
    },
    {
      "text": "把鸡片回锅，翻炒均匀，适量鸡精调味，关火"
    }
  ],
