  "steps": [
    { "text": "粉丝用温水泡发至软（约十分钟即可）；干香菇与木耳分别用热水泡十至十五分钟（若买到鲜木耳可省略泡发）。", "timerSeconds": 600, "ingredientNames": ["粉丝", "干香菇", "木耳"] },
    { "text": "卷心菜切掉中心硬梗，叠起菜叶切极细丝；泡发好的木耳与干香菇同样切细丝；芹菜先切约五厘米段再切细丝；荷兰豆切细丝；胡萝卜先削平一面便于稳定，切片后再切细丝；蒜拍碎去皮粗略切末。另取小碗将面粉与清水调成糊浆，作封口用。", "ingredientNames": ["卷心菜", "木耳", "干香菇", "芹菜", "荷兰豆", "胡萝卜", "蒜", "面粉", "清水"] },
    { "text": "大火烧热炒锅约一分钟，下一汤匙食用油润锅，再烧三十至四十秒；下蒜末爆香；下香菇炒二十至三十秒；下芹菜和卷心菜炒约三十秒；下胡萝卜和木耳炒三十至四十秒；加盐、白糖、白胡椒粉和蚝油炒匀；加入荷兰豆拌匀；将食材拨到锅边留出中心，放入剪短的粉丝吸收蔬菜汁水，再与馅料拌匀；加香油再炒三十至四十秒；关火盛出晾凉备用。", "timerSeconds": 220, "ingredientNames": ["蒜", "干香菇", "芹菜", "卷心菜", "胡萝卜", "木耳", "盐", "白糖", "白胡椒粉", "蚝油", "荷兰豆", "粉丝", "香油", "食用油"] },
    { "text": "春卷皮逐张揭开，未用的放回包装防干，取用时放入袋中保湿；取一张皮菱形摆放（一角朝向自己），在靠近己侧放约两汤匙馅料；翻起近端盖住馅料，卷紧并挤出空气；卷至中间时左右两侧向内折起；顶端抹上面粉糊浆，一直卷到底封口；全部包好后封口朝下摆放。", "ingredientNames": ["春卷皮"] },
    { "text": "深锅中高火烧热食用油至约一百六十五摄氏度（三百三十华氏度），转小火；每次下六只春卷，小火炸约一分半，翻动使其均匀；转大火再炸约一分半至金黄酥脆；用漏勺捞出沥油，装盘即成，稍晾凉后食用。", "timerSeconds": 180, "ingredientNames": ["食用油", "春卷皮"] }
  ],
  "baseServings": 4,
  "durationMinutes": 60,
  "difficulty": "中等",
