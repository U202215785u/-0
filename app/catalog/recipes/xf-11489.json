  "steps": [
    {
      "text": "将蛋白放入调理盘中隔水略微加热，加入细砂糖，用打蛋器混合拌溶后离火,"
    },
    {
      "text": "加入椰丝，用刮刀混合拌匀,"
    },
    {
      "text": "取适量用手捏成一个个圆形，间隔排入烤盘中,"
    },
    {
      "text": "烤盘中铺油纸，预热至170度,"
    },
    {
      "text": "上下火170度15分钟左右（需要自己随时观察，以免烤焦）"
    }
  ],
