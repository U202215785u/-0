  "title": "炝拌豇豆",
  "ingredients": [
    {
      "name": "豇豆",
      "mergeKey": "long-bean",
      "category": "蔬菜"
    },
    {
      "name": "大蒜",
      "mergeKey": "garlic",
      "category": "蔬菜"
    },
    {
      "name": "葱",
      "mergeKey": "scallion",
      "category": "蔬菜"
    },
    {
      "name": "干辣椒",
      "mergeKey": "dried-chili",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "盐",
      "mergeKey": "salt",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "鸡精",
      "mergeKey": "chicken-powder",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "食用油",
      "mergeKey": "cooking-oil",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "豇豆用淡盐水浸泡，冲洗干净，择去两头，从当中切一刀,"
    },
    {
      "text": "锅里烧开半锅水，放一小勺盐，滴两滴食用油,"
    },
    {
      "text": "把豇豆放入焯水大约两分钟,"
    },
    {
      "text": "焯好水的豇豆捞出，立即泡在凉开水中降温,"
    },
    {
      "text": "降温后的豇豆捞出沥干水分，切段,"
    },
    {
      "text": "切好的豇豆放大盆中，放盐和鸡精码味,"
    },
    {
      "text": "大蒜和葱切末，干辣椒剪成小段，放在码好味的豇豆上,"
    },
    {
      "text": "干净锅中放油烧至滚烫，迅速浇在豇豆上，让油的高温激发出葱蒜干辣椒香味后，装盘即可"
    }
  ],
