      "name": "低筋面粉",
      "mergeKey": "cake-flour",
      "amount": 420,
      "unit": "克",
      "category": "米面主食",
      "pantry": true
    },
    {
      "name": "酥油",
      "mergeKey": "shortening",
      "amount": 50,
      "unit": "克",
      "category": "乳制品",
      "pantry": true
    },
    {
      "name": "高筋面粉",
      "mergeKey": "bread-flour",
      "amount": 120,
      "unit": "克",
      "category": "米面主食",
      "pantry": true
    },
    {
      "name": "白糖",
      "mergeKey": "sugar",
      "amount": 20,
      "unit": "克",
