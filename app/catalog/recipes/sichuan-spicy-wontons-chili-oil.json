    { "name": "蒜末", "amount": 5, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "garlic" },
    { "name": "生抽", "amount": 15, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "soy-sauce" },
