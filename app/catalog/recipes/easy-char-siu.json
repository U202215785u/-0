  "steps": [
    {
      "text": "将猪肩肉放入可密封的塑料袋，加入叉烧酱、蚝油、生抽、五香粉、蒜片、姜片和辣椒粉（可选）全部腌料。",
      "ingredientNames": [
        "猪肩肉",
        "叉烧酱",
        "蚝油",
        "生抽",
        "五香粉",
        "大蒜",
        "姜",
        "辣椒粉"
      ]
    },
    {
      "text": "挤出袋内空气后封口，反复揉搓使腌料均匀包裹肉面，放入冰箱冷藏腌制至少六小时（最好过夜）。",
      "timerSeconds": 21600,
      "ingredientNames": [
        "猪肩肉"
      ]
    },
    {
      "text": "烘烤前取出猪肉，保留腌料备用。",
      "ingredientNames": [
        "猪肩肉"
      ]
    },
    {
      "text": "烤箱预热至二百二十摄氏度（风扇模式二百度）。若烤盘配烤架，盘内注入低于烤架的热水，肉放烤架上，烤盘置于烤箱中层；也可在烤箱底部放一只盛满热水的大烤盘，再把肉放中层烤架。",
      "ingredientNames": [
        "猪肩肉"
      ]
    },
    {
      "text": "烤十五分钟后取出翻面，刷一层腌料放回烤箱（确保盘内始终有足够的水）。",
      "timerSeconds": 900,
      "ingredientNames": [
        "猪肩肉",
        "叉烧酱"
      ]
    },
    {
      "text": "再烤十分钟；等待期间把两茶匙蜂蜜与两茶匙腌料拌匀。",
      "timerSeconds": 600,
      "ingredientNames": [
        "蜂蜜",
        "叉烧酱"
      ]
    },
    {
      "text": "将烤箱温度升至二百四十摄氏度（风扇二百二十度）。取出肉，刷上蜂蜜混合液。",
      "ingredientNames": [
        "猪肩肉",
        "蜂蜜"
      ]
    },
    {
      "text": "放回烤箱烤五分钟。",
      "timerSeconds": 300,
      "ingredientNames": [
        "猪肩肉"
      ]
    },
    {
      "text": "取出刷另一面蜂蜜混合液，再烤最后三分钟。",
      "timerSeconds": 180,
      "ingredientNames": [
        "猪肩肉",
        "蜂蜜"
      ]
    },
    {
      "text": "出炉静置五分钟再切片享用；也可把剩余腌料（捞出蒜片与姜片）加热后作蘸酱、汤底或拌面调味。",
      "timerSeconds": 300,
      "ingredientNames": [
        "大蒜",
        "姜"
      ]
    }
  ],
  "baseServings": 3,
