  ],
  "steps": [
    {
      "text": "碗中放入一大勺姜末，倒入20-30毫升广东米酒，浸泡30分钟左右制成姜汁酒备用,"
    },
    {
      "text": "海白虾洗净后去头,"
    },
    {
      "text": "用剪刀从背部把壳剪开，从中间剔除虾线,"
    },
    {
      "text": "包下虾皮保留虾肉,"
    },
    {
      "text": "用刀把虾肉背部片开，深及三分之二处不切断虾肉,"
    },
    {
      "text": "改刀后的虾仁用清水反复冲洗干净后控干水分,"
    },
    {
      "text": "在虾肉中加入2克盐，抓拌至虾肉产生黏性,"
    },
    {
      "text": "然后加入一大勺姜汁酒和少许白胡椒粉，淀粉抓拌均匀,"
    },
    {
      "text": "最后放入橄榄油拌匀后腌制15分钟左右,"
    },
    {
      "text": "秋葵洗净后去蒂改刀成段,"
    },
    {
      "text": "1"
    },
    {
      "text": "锅内做水，水中加一小勺盐（未计入材料内），水开后下入秋葵,"
    },
    {
      "text": "1"
    },
    {
      "text": "焯烫约20秒左右捞出控干水分,"
    },
    {
      "text": "1"
    },
    {
      "text": "锅内放少许橄榄油（未计入材料内），下入姜末爆香后下入腌好的虾仁翻炒,"
    },
    {
      "text": "1"
    },
    {
      "text": "炒至虾仁变色后下入秋葵快速翻炒,"
    },
    {
      "text": "1"
    },
    {
      "text": "出锅前淋入一小勺姜汁酒爆香后加少许盐调味后出锅完成制作"
    }
  ],
