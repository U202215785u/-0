  "steps": [
    {
      "text": "烤好的海绵蛋糕横切成2厘米的厚片，取2片重叠，备用,"
    },
    {
      "text": "用4寸慕思圈压出圆形作为小兔子的脸部；其余部分裁成树叶形状，作为耳朵；组合成兔子头部的形状,"
    },
    {
      "text": "黄油、黑巧隔热水，搅拌至融化,"
    },
    {
      "text": "盛出，稍稍晾凉，即为巧克力酱,"
    },
    {
      "text": "将巧克力酱均匀地涂抹在底层的蛋糕片上,"
    },
    {
      "text": "放上表层的蛋糕片，压紧，冷藏备用,"
    },
    {
      "text": "取200毫升淡奶油,"
    },
    {
      "text": "隔冰水搅打至八九分发，加入云尼拿香精油，拌匀,"
    },
    {
      "text": "将淡奶油均匀涂抹在蛋糕表面,"
    },
    {
      "text": "均匀地沾上椰蓉，草莓巧克力刨薄片，装饰在耳朵中心和腮红的位置,"
    },
    {
      "text": "1"
    },
    {
      "text": "用剩余的黑巧克力酱画出眼睛、嘴巴，即可"
    }
  ],
