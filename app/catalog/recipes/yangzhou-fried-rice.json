  "steps": [
    {
      "text": "锅或平底锅烧热至中大火，放 7.5 毫升油，转动锅子让锅底均匀裹上油，下叉烧和虾仁，静置煎 30 秒不翻动。",
      "ingredientNames": [
        "花生油",
        "叉烧",
        "虾仁"
      ],
      "timerSeconds": 30
    },
    {
      "text": "翻炒至虾仁变白，立即把叉烧和虾仁盛到盘中备用。",
      "ingredientNames": [
        "叉烧",
        "虾仁"
      ]
    },
    {
      "text": "锅中加入 15 毫升油和米饭，翻炒 1 分钟，让米粒均匀裹上油。",
      "ingredientNames": [
        "花生油",
        "白米饭"
      ],
      "timerSeconds": 60
    },
    {
      "text": "淋入生抽，继续翻炒至酱油分布均匀、米粒分开。",
      "ingredientNames": [
        "生抽"
      ]
    },
    {
      "text": "把米饭拨到锅的一侧，在空出的一侧加油和打散的蛋液，静置 30 秒至底部刚刚凝固。",
      "ingredientNames": [
        "花生油",
        "鸡蛋"
      ],
      "timerSeconds": 30
    },
    {
      "text": "轻轻翻炒鸡蛋，再与米饭混合，继续翻炒至鸡蛋散成小块，约 1 至 2 分钟。",
      "ingredientNames": [
        "鸡蛋",
        "白米饭"
      ]
    },
    {
      "text": "加入蔬菜丁和葱花，撒上盐和白胡椒粉，再翻炒 1 分钟。",
      "ingredientNames": [
        "冷冻蔬菜丁",
        "葱",
        "盐",
        "白胡椒粉"
      ],
      "timerSeconds": 60
    },
    {
      "text": "把煎好的虾仁和叉烧倒回锅中，最后翻拌均匀。",
      "ingredientNames": [
        "虾仁",
        "叉烧"
      ]
    },
    {
      "text": "转小火，小心尝一下米饭，按需调整调味；盛入碗中，趁热作为配菜或轻食主菜上桌。",
      "ingredientNames": [
        "盐",
        "白胡椒粉"
      ]
    }
  ],
  "baseServings": 4,
