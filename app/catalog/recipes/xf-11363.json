      "mergeKey": "white-pepper",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "大虾洗净剪去须子、背部开一刀去除虾线，用刀拍一下一会虾不会受热卷曲,"
    },
    {
      "text": "大虾用大蒜蓉、牛至碎、白葡萄酒、盐、胡椒粉腌渍,"
    },
    {
      "text": "撒上奶酪丝和一半的红椒碎,"
    },
    {
      "text": "放在烤盘上，烤箱提前预热200度,"
    },
    {
      "text": "放入烤箱上下火200度烤5分钟，撒上另一半红椒粒,"
    },
    {
      "text": "在入烤箱烤2分钟奶酪微微焦黄即可出锅装盘"
    }
  ],
