  "title": "奶酪焗大虾",
  "ingredients": [
    {
      "name": "马苏里拉奶酪丝",
      "mergeKey": "mozzarella",
      "category": "乳制品"
    },
    {
      "name": "大虾",
      "mergeKey": "shrimp",
      "amount": 2,
      "unit": "只",
      "category": "水产"
    },
    {
      "name": "红椒",
      "mergeKey": "red-pepper",
      "category": "蔬菜"
    },
    {
      "name": "大蒜",
      "mergeKey": "garlic",
      "category": "蔬菜"
    },
    {
      "name": "牛至碎",
      "mergeKey": "oregano",
