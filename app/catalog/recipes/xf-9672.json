{
  "id": "xf-9672",
  "title": "金沙南瓜",
  "ingredients": [
    {
      "name": "南瓜",
      "mergeKey": "pumpkin",
      "category": "蔬菜"
    },
    {
      "name": "咸蛋黄",
      "mergeKey": "salted-egg-yolk",
      "amount": 5,
      "unit": "颗",
      "category": "蛋类"
    },
    {
      "name": "低筋面粉",
      "mergeKey": "cake-flour",
      "amount": 50,
      "unit": "克",
      "category": "米面主食",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "将南瓜切成长条状,"
    },
    {
      "text": "咸蛋黄入上汽的锅内蒸熟后，用匙压成粉状,"
    },
    {
      "text": "锅内烧开水，放入南瓜条氽水，水再次沸腾时捞起沥干水,"
    },
    {
      "text": "放凉后粘上面粉,"
    },
    {
      "text": "平底锅内热油，放入南瓜煎至硬身,"
    },
    {
      "text": "锅内放一匙油，放入咸蛋黄炒至起泡,"
    },
    {
      "text": "煎好的南瓜条沥净油，放入炒好的咸蛋黄内,"
    },
    {
      "text": "抛动锅子，让南瓜条均匀的沾上蛋黄即可"
    }
  ],
