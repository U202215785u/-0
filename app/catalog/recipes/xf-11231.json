  "steps": [
    {
      "text": "准备鸡蛋4个，红绿尖椒（细细的那种）各两个,"
    },
    {
      "text": "把鸡蛋液加盐2克、米酒一小勺，打散。红绿尖椒切片,"
    },
    {
      "text": "锅烧油至五分热，倒入打好的蛋液。用筷子拌炒。筷子炒蛋会比较嫩哦,"
    },
    {
      "text": "蛋液炒到半凝固时，倒入辣椒片翻炒，炒至蛋液凝固。喜欢辣椒比较熟一点的话，可以早些放入，或和蛋液一同下锅"
    }
  ],
