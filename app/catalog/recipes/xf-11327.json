  "steps": [
    {
      "text": "制作豆沙：绿豆浸泡一晚（放冰箱里,"
    },
    {
      "text": "泡好的豆子放入锅中加水，煮至软烂，用勺子盛出放入纱布中。纱布放在纱网中，下面再垫个大碗，好操作一些,"
    },
    {
      "text": "用手挤出水份，至尽可能干,"
    },
    {
      "text": "过滤好的绿豆沙,"
    },
    {
      "text": "锅烧小火，放入黄油融化,"
    },
    {
      "text": "入豆沙和白糖，小火翻炒至水份蒸发，干湿适当,"
    },
    {
      "text": "制作烙饼：面粉和色拉油放入盆里，慢慢加入热水，用筷子搅匀，再加入冷水，揉成光滑面团。盖上保鲜膜，松弛30分钟,"
    },
    {
      "text": "分割成八等份，略滚圆。盖上保鲜膜，松弛十分钟,"
    },
    {
      "text": "用擀面杖擀成片状,"
    },
    {
      "text": "象包包子一样，包入绿豆沙馅，收口捏紧,"
    },
    {
      "text": "1"
    },
    {
      "text": "在案板上压成饼。表面刷水，粘上白芝麻,"
    },
    {
      "text": "1"
    },
    {
      "text": "锅内刷少量油（不粘锅可不刷），以小火两面都烙至金黄。也可以用烤箱烤，据说烤的叫做烧饼，烙出来的叫火烧"
    }
  ],
