  "steps": [
    {
      "text": "面粉300克、鸡蛋一个、牛奶120克、酵母粉3克、盐5克，揉成光滑的面团，发酵到3倍大,"
    },
    {
      "text": "面团擀成30厘米大小的方形，铺在烤盘里，边缘厚一点，先刷上批萨酱,"
    },
    {
      "text": "撒一层芝士，再铺上香菇、青椒、圆葱、培根,"
    },
    {
      "text": "撒上胡椒碎，烤箱预热220度，放中间一层，先烤20分钟,"
    },
    {
      "text": "取出后，铺满芝士片,"
    },
    {
      "text": "再进烤箱，220度烤10分钟左右即可"
    }
  ],
