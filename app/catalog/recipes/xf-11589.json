  "steps": [
    {
      "text": "水加入面粉中，一点点加，边加边用筷子搅拌成雪片状，用手揉成面团。放容器里蒙保鲜膜醒30分钟,"
    },
    {
      "text": "醒好的面团，再次揉和成光滑圆锥型面团,"
    },
    {
      "text": "锅中水烧开，放一小勺盐,"
    },
    {
      "text": "用剪刀边剪边转动面团，全部剪到锅中,"
    },
    {
      "text": "煮至剪刀面全部浮起,"
    },
    {
      "text": "把煮熟的剪刀面捞出用凉水冲凉沥干,"
    },
    {
      "text": "里脊肉切丁用一点点料酒和一勺蚝油拌匀腌制。胡萝卜、茭白、莴笋去皮切丁，泡发好的黑木耳切丝,"
    },
    {
      "text": "锅中放油烧热，入腌制好的里脊肉丁煸炒至变色，表面变白立即捞出装盘备用,"
    },
    {
      "text": "用锅中余油煸炒胡萝卜丁至身软,"
    },
    {
      "text": "入茭白丁煸炒至软,"
    },
    {
      "text": "1"
    },
    {
      "text": "倒入莴笋丁和黑木耳同炒，放盐和鸡精调味，在放一点点清水,"
    },
    {
      "text": "1"
    },
    {
      "text": "倒入熟的剪刀面条，翻炒片刻入味即可出锅"
    }
  ],
