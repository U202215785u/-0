  "title": "芒果西米露",
  "ingredients": [
    {
      "name": "-2个芒果",
      "mergeKey": "mango",
      "amount": 2,
      "unit": "个",
      "category": "其他"
    },
    {
      "name": "西米",
      "mergeKey": "sago",
