  "steps": [
    {
      "text": "猪里脊切丝，放蚝油、料酒抓匀后，加一汤匙色拉油拌匀（原因见文后的碎碎念,"
    },
    {
      "text": "龙口粉丝用温水泡软，沥干水份备用,"
    },
    {
      "text": "锅子烧热，放油，温油时放入腌制好的肉丝煸炒至变色,"
    },
    {
      "text": "放东北酸菜入锅翻炒一分钟,"
    },
    {
      "text": "撒点葱花，放一汤匙生抽翻炒均匀,"
    },
    {
      "text": "把粉丝放入锅中，加一点点盐，加点水翻炒均匀,"
    },
    {
      "text": "盖上锅盖，煮两分钟,"
    },
    {
      "text": "开盖，加适量鸡精快速翻炒均匀，关火，撒点葱花出锅"
    }
  ],
