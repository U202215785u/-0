{
  "id": "chinese-scrambled-eggs",
  "title": "中式炒鸡蛋",
  "ingredients": [
    {
      "name": "鸡蛋",
      "mergeKey": "egg",
      "amount": 5,
      "unit": "个",
      "category": "蛋类"
    },
    {
      "name": "食用油",
      "mergeKey": "cooking-oil",
      "amount": 30,
      "unit": "毫升",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "食盐",
      "mergeKey": "salt",
      "amount": 2.5,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "白糖",
      "mergeKey": "sugar",
      "amount": 2.5,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "鸡粉",
      "mergeKey": "chicken-powder",
      "amount": 2.5,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "白胡椒粉",
      "mergeKey": "white-pepper",
      "amount": 1.25,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "鸡蛋打入碗中，加入食用油、食盐、白糖、鸡粉和白胡椒粉。",
      "ingredientNames": [
        "鸡蛋",
        "食用油",
        "食盐",
        "白糖",
        "鸡粉",
        "白胡椒粉"
      ]
    },
    {
      "text": "用叉子快速有力地沿波浪方向打蛋1至2分钟，直到蛋液均匀起泡。",
      "ingredientNames": [
        "鸡蛋"
      ]
    },
    {
      "text": "锅烧至很热，加入食用油转匀；下锅前再搅动蛋液，倒入锅中后转中小火。",
      "ingredientNames": [
        "食用油",
        "鸡蛋"
      ]
    },
    {
      "text": "蛋液底部开始凝固时从边缘向中心推拌，炒至仍然湿润、刚熟即关火装盘。",
      "ingredientNames": [
        "鸡蛋"
      ]
    }
  ],
  "baseServings": 4,
  "sourceUrl": "https://www.madewithlau.com/recipes/scrambled-eggs",
  "author": "Daddy Lau / Made With Lau",
  "fidelity": "structured-transcription",
  "sourceNote": "逐页核验来源页面公开的4人份、6分钟总时长和5段方法；保留快速打蛋、锅体预热与湿润刚熟出锅。",
  "tags": [
    "炒"
  ],
  "durationMinutes": 6,
  "difficulty": "中等"
}
