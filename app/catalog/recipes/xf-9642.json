  "steps": [
    {
      "text": "口蘑洗净切片，培根切小片,"
    },
    {
      "text": "通粉煮熟过凉备用，口蘑过滚水煮熟捞出沥干水份,"
    },
    {
      "text": "锅内少许橄榄油，下培根煎至表面泛黄，下口蘑炒匀,"
    },
    {
      "text": "倒入沥去水份的通粉，加少许味极鲜，盐炒匀，出锅前撒少许香芹碎"
    }
  ],
