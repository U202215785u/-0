  "steps": [
    {
      "text": "猪肋骨切块，洗干净"
    },
    {
      "text": "打开麻辣蒸肉粉，取出调料包和米粉包"
    },
    {
      "text": "排骨中倒入料酒、花椒粒、豆瓣、酱油、4/5的调料包，腌10分钟"
    },
    {
      "text": "土豆去皮、洗净、切块"
    },
    {
      "text": "土豆中加入1/5的米粉个刚才剩下的调料包，加少许盐，搅匀，扑在准备蒸的碗底"
    },
    {
      "text": "排骨裹上上面剩下的米粉，均匀铺在土豆上面"
    },
    {
      "text": "上锅，大火蒸1个小时"
    },
    {
      "text": "出锅时撒上葱花，就搞定了"
    }
  ],
