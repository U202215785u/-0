  "steps": [
    {
      "text": "洋葱切丝、胡萝卜切片,"
    },
    {
      "text": "鱿鱼、盐、胡椒粉、辣椒面、辣椒酱、孜然、白酒抓匀腌渍10分钟,"
    },
    {
      "text": "用烧烤酱加少许白糖、面酱抓匀鱿鱼,"
    },
    {
      "text": "烤箱提前预热180度，将黄油放在烤盘上融化，铺上洋葱丝、胡萝卜片最后放上鱿鱼，进烤箱上下火180度烤10分钟即可用夹子盛盘切开即可"
    }
  ],
