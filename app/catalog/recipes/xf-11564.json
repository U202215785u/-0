    {
      "name": "美极鲜酱油",
      "mergeKey": "soy-sauce",
      "quantityText": "几滴",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "芹菜和胡萝卜洗净，胡萝卜去皮切成丝，芹菜切段。熟的猪肚切丝,"
    },
    {
      "text": "锅烧热放油，油温烧热放胡萝卜丝，煸炒至身软,"
    },
    {
      "text": "放入芹菜丝，翻炒一分钟,"
    },
    {
      "text": "放入肚丝翻炒片刻后，加盐、滴几滴美极鲜酱油翻炒均匀出锅"
    }
  ],
