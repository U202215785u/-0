  "steps": [
    {
      "text": "把鱼柳斜刀切片，用盐、白胡椒粉、绍兴料酒和玉米淀粉抓匀腌制。",
      "ingredientNames": [
        "鱼柳（去皮去骨）",
        "盐",
        "白胡椒粉",
        "绍兴料酒",
        "玉米淀粉"
      ]
    },
    {
      "text": "炒锅（或深煎锅）中放油，小火把干辣椒和花椒炸出香味（不要炸糊）。放凉后粗略切碎，盛出备用。",
      "ingredientNames": [
        "食用油",
        "干辣椒",
        "花椒"
      ]
    },
    {
      "text": "同一口锅中火烧热油，放入芹菜（或豆芽）翻炒约一分半钟（若用豆芽则约三十秒），盛入碗中备用。",
      "timerSeconds": 90,
      "ingredientNames": [
        "食用油",
        "芹菜（或豆芽）"
      ]
    },
    {
      "text": "锅中倒油烧热，放入蒜、姜末和葱花炒香，加入郫县豆瓣酱和辣椒粉，倒入清水（或鸡汤），大火煮开。",
      "ingredientNames": [
        "食用油",
        "蒜",
        "姜末",
        "葱",
        "郫县豆瓣酱",
        "辣椒粉",
        "清水（或鸡汤）"
      ]
    },
    {
      "text": "轻轻把鱼片滑入锅中，煮熟后连同汤汁倒入盛有蔬菜的碗中。",
      "ingredientNames": [
        "鱼柳（去皮去骨）"
      ]
    },
    {
      "text": "把炸香的干辣椒花椒和香菜铺在鱼上。另起锅把油烧热，淋在香料上激出香味，立即趁热配白米饭食用。",
      "ingredientNames": [
        "香菜",
        "食用油"
      ]
    }
  ],
