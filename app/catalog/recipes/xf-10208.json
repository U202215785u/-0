  "steps": [
    {
      "text": "锅中倒水加少许油，放入豌豆煮开三分钟,"
    },
    {
      "text": "锅烧热后倒油，倒入用盐、料酒、鸡精、老抽、淀粉腌制好的瘦肉丁,"
    },
    {
      "text": "瘦肉炒至变色，肉发紧时倒入煮好的豌豆翻炒两分钟,"
    },
    {
      "text": "加入红椒粒、葱白末后放入宜宾芽菜翻炒均匀即可"
    }
