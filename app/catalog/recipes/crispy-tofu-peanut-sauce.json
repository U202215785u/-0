  "steps": [
    {
      "text": "老豆腐沥干并擦干，切成约1.3厘米方块。平底锅中火加热1汤匙食用油，豆腐煎至金黄，约5至7分钟，盛出。",
      "ingredientNames": [
        "老豆腐",
        "食用油"
      ]
    },
    {
      "text": "原锅中加入剩余食用油，放入切碎的红葱头、擦碎的姜和蒜，中火翻炒5至7分钟，至红葱头变透明、边缘开始上色。",
      "ingredientNames": [
        "食用油",
        "红葱头",
        "姜",
        "蒜"
      ]
    },
    {
      "text": "加入孜然粉、红椒碎和姜黄粉，炒约1分钟至出香味；加入椰浆、花生酱和蜂蜜，煮沸后再煮约5分钟至酱汁变稠。",
      "ingredientNames": [
        "孜然粉",
        "红椒碎",
        "姜黄粉",
        "无糖椰浆",
        "天然花生酱",
        "蜂蜜"
      ]
    },
    {
      "text": "加入半杯清水和食盐调味，将豆腐放回锅中，小火煮约2分钟至热透；酱汁过稠时少量补水。关火拌入青柠汁。",
      "ingredientNames": [
        "老豆腐",
        "食盐",
        "青柠汁"
      ]
    },
    {
      "text": "撒香菜和墨西哥辣椒，搭配米饭与青柠角食用。",
      "ingredientNames": [
        "香菜",
        "墨西哥辣椒",
        "米饭",
        "青柠角"
      ]
    }
  ],
