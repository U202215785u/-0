  "steps": [
    {
      "text": "黄油软化后加入细砂糖搅拌至羽毛状,"
    },
    {
      "text": "加入黄金糖浆和麦芽糖,"
    },
    {
      "text": "糖浆和黄油搅打均匀,"
    },
    {
      "text": "下入粉类（面粉，肉桂粉，黄姜粉，肉蔻粉）抓拌均匀,"
    },
    {
      "text": "揉搓成团后装袋放入冰箱冷藏一小时,"
    },
    {
      "text": "从冰箱取出面团分成小份,"
    },
    {
      "text": "面团下面垫油纸，上面覆保鲜膜擀成薄片入冰箱冷藏20分钟冻硬后取出,"
    },
    {
      "text": "去掉保鲜膜用饼干压模在面片上压出形状,"
    },
    {
      "text": "取出案放在烤盘上下垫油纸或油布烘烤,"
    },
    {
      "text": "烤好后取出放在烤网上晾凉,"
    },
    {
      "text": "1"
    },
    {
      "text": "制作蛋白糖霜，蛋白中加入塔塔粉打至出现粗泡,"
    },
    {
      "text": "1"
    },
    {
      "text": "下入5分之一糖粉继续搅拌,"
    },
    {
      "text": "1"
    },
    {
      "text": "搅拌均匀后分两次下入剩余的糖粉搅拌至抬起抬起打蛋器流下液体可以停留在蛋白霜表面即可,"
    },
    {
      "text": "1"
    },
    {
      "text": "在小碗中倒入蛋白糖霜加入色素调好颜色后倒入一次性裱花袋,"
    },
    {
      "text": "1"
    },
    {
      "text": "调好你需要的颜色备用,"
    },
    {
      "text": "1"
    },
    {
      "text": "下面，用裱花袋在饼干随意涂鸦吧"
    }
  ],
