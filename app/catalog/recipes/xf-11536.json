    },
    {
      "name": "糖粉",
      "mergeKey": "sugar",
      "amount": 15,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "黄油",
      "mergeKey": "butter",
      "amount": 8,
      "unit": "克",
      "category": "乳制品"
    }
  ],
  "steps": [
    {
      "text": "鸡蛋1个放碗里打散，然后取半个的量加入一个大的碗里加入糖粉用打蛋器搅打均匀,"
    },
    {
      "text": "倒入牛奶，搅拌均匀,"
    },
    {
      "text": "筛入低筋面粉用打蛋器慢慢的搅打均匀，成为稀的面糊,"
    },
    {
      "text": "将黄油隔水加热融化成液态以后，倒入面糊里，搅拌均匀,"
    },
    {
      "text": "将稀面糊过筛，然后放入冰箱冷藏静置半个小时,"
    },
    {
      "text": "平底锅刷上薄薄的一层油，用小火加热。倒入两大勺（30毫升）的面糊，转动平底锅使面糊摊成圆形。小火一直煎到面糊凝固。可以用锅铲帮助把整张面皮轻易的揭下来，放入盘中冷却,"
    },
    {
      "text": "将冷藏过的动物性或植物性淡奶油分次加入糖粉用电动打蛋器打发到可以保持花纹并且奶油直立的程度,"
    },
    {
      "text": "将班戟皮表皮（煎的时候没有贴着平底锅的一面）朝下铺好，在班戟皮上放入适量打发好的鲜奶油，放上少许芒果丁，再放上适量打发好的鲜奶油。将馅完全包在皮里面，把班戟皮包成四方形即可食用"
    }
  ],
