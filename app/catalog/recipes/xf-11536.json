      "amount": 100,
      "unit": "毫升",
      "category": "乳制品"
    },
    {
      "name": "低筋面粉",
      "mergeKey": "low-gluten-flour",
      "amount": 40,
      "unit": "克",
      "category": "米面主食",
      "pantry": true
    },
    {
      "name": "鸡蛋",
      "mergeKey": "egg",
      "amount": 0.5,
