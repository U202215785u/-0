  "steps": [
    {
      "text": "葱、姜切末，小辣椒切段,"
    },
    {
      "text": "用酱油、绍酒、白糖、盐、水淀粉、醋提前调好碗芡,"
    },
    {
      "text": "将切好丁的杏鲍菇丁焯水捞出待用,"
    },
    {
      "text": "热锅温油，放入花椒煸香,"
    },
    {
      "text": "放入葱、姜、红辣椒,"
    },
    {
      "text": "放入焯好的杏鲍菇丁,"
    },
    {
      "text": "煸炒两分钟后倒入提前调好的碗芡,"
    },
    {
      "text": "倒入炸好的花生米"
    }
  ],
