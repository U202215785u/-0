  "steps": [
    {
      "text": "猪肩肉切成长条，每条约2.5厘米厚，尽量保持厚度均匀，使其同时成熟；用叉子反复扎透两面，帮助入味。",
      "ingredientNames": [
        "猪肩肉"
      ]
    },
    {
      "text": "把蒜盐、红糖、蚝油、生抽、海鲜酱、红葡萄酒、绍兴酒、红腐乳和五香粉混合至顺滑；想要颜色更红时，可加入红色色素。",
      "ingredientNames": [
        "蒜盐",
        "红糖",
        "蚝油",
        "生抽",
        "海鲜酱",
        "红葡萄酒",
        "绍兴酒",
        "红腐乳",
        "五香粉",
        "红色色素"
      ]
    },
    {
      "text": "猪肉放入密封袋，倒入腌汁，按摩约2分钟后挤出空气封袋。放入冰箱腌过夜，至少6至8小时，不要超过24小时；烹调前取出回温约1小时。",
      "ingredientNames": [
        "猪肩肉"
      ]
    },
    {
      "text": "烤箱预热至218摄氏度。烤盘铺锡纸，放上烤架，把猪肉平铺在烤架上，烤盘底部加1至2汤匙清水防止滴油烧焦。",
      "ingredientNames": [
        "猪肩肉",
        "清水"
      ]
    },
    {
      "text": "将蜂蜜与清水调匀作为刷汁。猪肉先烤15分钟，取出两面刷剩余腌汁；再烤15分钟并重复刷腌汁；再烤10分钟后改刷蜂蜜水；最后升至232摄氏度烤5分钟，两面刷蜂蜜水。总烤制时间约50分钟。",
      "ingredientNames": [
        "蜂蜜",
        "清水",
        "猪肩肉"
      ]
    },
    {
      "text": "出炉后再刷一次蜂蜜水，静置约5分钟再切片食用。",
      "ingredientNames": [
        "蜂蜜",
        "清水"
      ]
    }
  ],
  "baseServings": 6,
