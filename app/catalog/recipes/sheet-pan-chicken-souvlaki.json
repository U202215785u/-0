  "steps": [
    { "text": "烤箱预热至 218 摄氏度。大碗中混合 4 瓣磨泥大蒜、2 汤匙干牛至、1 茶匙糖、80 毫升特级初榨橄榄油和 1 茶匙半粗盐，撒入现磨黑胡椒调味。加入 680 克去皮去骨鸡腿肉（切约 5 厘米块），拌匀裹料，静置 15 分钟。", "timerSeconds": 900, "ingredientNames": ["大蒜（磨泥）", "干牛至", "糖", "特级初榨橄榄油", "粗盐（犹太盐）", "现磨黑胡椒", "去皮去骨鸡腿肉"] },
    { "text": "同时，把鹰嘴豆罐头沥水后铺在带边烤盘上，撒 2 茶匙孜然粉和 2 茶匙烟熏甜椒粉，淋一些橄榄油，加盐调味，拌匀裹料。", "ingredientNames": ["鹰嘴豆罐头", "孜然粉", "烟熏甜椒粉", "特级初榨橄榄油", "粗盐（犹太盐）"] },
    { "text": "准备烤制时，往鸡肉里加 3 汤匙柠檬汁拌匀。把鸡肉穿到竹签上，架放在鹰嘴豆上。烤至鸡肉完全变白熟透，6–8 分钟。然后开启烤箱上火炙烤，烤到鸡肉和鹰嘴豆局部上色，约 5 分钟。取出烤盘，把剩下 1 汤匙特级初榨橄榄油淋在鸡肉和鹰嘴豆上。", "timerSeconds": 360, "ingredientNames": ["柠檬汁", "去皮去骨鸡腿肉", "竹签（泡水）或金属串签", "特级初榨橄榄油"] },
    { "text": "大碗中放入小红洋葱（切薄丝）、454 克混合番茄（切块）和 120 毫升去核卡拉马塔橄榄，淋上橄榄油和柠檬汁，加盐调味，拌匀。", "ingredientNames": ["小红洋葱", "混合番茄", "去核卡拉马塔橄榄", "特级初榨橄榄油", "柠檬汁", "粗盐（犹太盐）"] },
    { "text": "把沙拉铺在鸡肉和鹰嘴豆上，再铺上 170 克菲达奶酪（切薄片）和香芹叶（带嫩茎），配皮塔饼和柠檬角上桌。", "ingredientNames": ["菲达奶酪", "香芹叶（带嫩茎）", "皮塔饼", "柠檬角"] }
  ],
  "baseServings": 4,
