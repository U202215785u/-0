{
  "id": "xf-10255",
  "title": "南乳汁脆藕片",
  "ingredients": [
    {
      "name": "一节约150克莲藕",
      "mergeKey": "lotus-root",
      "amount": 150,
      "unit": "克",
      "category": "蔬菜"
    },
    {
      "name": "南乳汁",
      "mergeKey": "fermented-tofu-sauce",
      "amount": 30,
      "unit": "毫升",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "小勺白砂糖",
      "mergeKey": "sugar",
      "amount": 5,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "葱花",
      "mergeKey": "scallion",
      "quantityText": "若干",
      "category": "蔬菜"
    }
  ],
  "steps": [
    {
      "text": "莲藕削皮，切薄片，放进清水里泡10分钟,"
    },
    {
      "text": "捞起沥干水分，热油锅，把莲藕片放进去大火爆炒5分钟左右，感觉粘锅就洒点水,"
    },
    {
      "text": "倒进南乳汁，加入2汤匙水，翻炒均匀，让每片藕片都粘上南乳汁，炒至收干汁,"
    },
    {
      "text": "加入1小勺白糖，翻炒均匀即可，装碟，撒上葱花"
    }
  ],
