  "steps": [
    {
      "text": "米洗净，放少量水，连皮南瓜切大块铺在表面，放入电饭锅按煮饭键至熟,"
    },
    {
      "text": "锅内热少许油，放入切碎香菇，洋葱，胡萝卜炒至出香味,"
    },
    {
      "text": "放入切碎香肠，炒至熟,"
    },
    {
      "text": "加入煮好的南瓜及饭，加入清水2大匙，翻炒均匀，炒至水干,"
    },
    {
      "text": "加入所有调味料翻炒均匀。撒上葱花即可"
    }
  ],
