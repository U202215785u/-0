      "name": "丝瓜",
      "mergeKey": "luffa",
      "category": "蔬菜",
      "pantry": false,
      "amount": 2,
      "unit": "根"
    },
    {
      "name": "鸡蛋",
      "mergeKey": "egg",
      "category": "蛋类",
      "pantry": false,
      "amount": 3,
      "unit": "个"
    },
    {
      "name": "盐",
      "mergeKey": "salt",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "油",
      "mergeKey": "cooking-oil",
      "category": "调味料",
