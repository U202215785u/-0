  "steps": [
    {
      "text": "黄瓜斜刀切片，再切成约 5 厘米长的细丝，无需去皮去籽。",
      "ingredientNames": [
        "黄瓜"
      ]
    },
    {
      "text": "小葱葱白和辣椒斜切成与黄瓜大小相近的丝。",
      "ingredientNames": [
        "小葱（只用葱白）",
        "青尖椒（长绿辣椒）",
        "红辣椒（新鲜）"
      ]
    },
    {
      "text": "香菜连梗带叶切成相近长度。",
      "ingredientNames": [
        "香菜"
      ]
    },
    {
      "text": "小碗中混合黑米醋、生抽、蒜末、香油和糖，搅拌至糖融化，尝味后按需加盐。",
      "ingredientNames": [
        "黑米醋（宜用镇江香醋）",
        "生抽",
        "大蒜（切末）",
        "熟香油（芝麻油）",
        "糖",
        "盐"
      ]
    },
    {
      "text": "所有蔬菜放入大碗，上桌前淋入酱汁，充分拌匀使酱汁均匀裹上，立即食用。",
      "ingredientNames": [
        "黄瓜",
        "小葱（只用葱白）",
        "青尖椒（长绿辣椒）",
        "红辣椒（新鲜）",
        "香菜"
      ]
    }
  ],
