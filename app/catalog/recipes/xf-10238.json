  "steps": [
    {
      "text": "小鲜虾洗净用盐、绍酒、胡椒粉腌上,"
    },
    {
      "text": "韭菜切段，姜切丝、蒜切末、香葱切末、红彩椒切丝,"
    },
    {
      "text": "锅内做油放入葱、姜、蒜末煸炒,"
    },
    {
      "text": "煸炒出香味放入小虾,"
    },
    {
      "text": "大火煸炒，眼见虾由透明煸炒成红色烹入绍酒,"
    },
    {
      "text": "放上红彩椒丝、另一半蒜末翻炒加盐、白糖、酱油调味,"
    },
    {
      "text": "放上韭菜，迅速翻炒,"
    },
    {
      "text": "继续煸炒均匀出锅即可（韭菜不用煸炒时间过长）"
    }
  ],
