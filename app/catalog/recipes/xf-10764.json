  "steps": [
    {
      "text": "粉丝用温水泡软 ，沥干水分，剪成小段，虾洗净沥干，剪去须,"
    },
    {
      "text": "烧热油锅，放葱姜煸炒出香味,"
    },
    {
      "text": "放虾进去煸炒至完全变色,"
    },
    {
      "text": "加一汤匙料酒，两汤匙蚝油，一汤匙白糖，一汤匙生抽,"
    },
    {
      "text": "加一小碗水，煮开,"
    },
    {
      "text": "移入沙锅，放粉丝进去，盖上盖子，煮开，转小火煲,"
    },
    {
      "text": "小火煲个十多分钟，至锅内汤汁收干即可"
    }
  ],
