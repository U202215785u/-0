  "steps": [
    {
      "text": "香肠煮熟，切丁。洋葱洗净，切丁，备用,"
    },
    {
      "text": "白锅内放入香肠丁，小火不断翻炒出香味,"
    },
    {
      "text": "加入洋葱丁，转中火，翻炒至洋葱透明，盛出备用,"
    },
    {
      "text": "蛋+糖，蛋抽搅拌均匀,"
    },
    {
      "text": "加入葵花子油，搅拌均匀,"
    },
    {
      "text": "分三次加入牛奶，每次要搅拌至完全融合后再继续加,"
    },
    {
      "text": "低粉+泡打粉+小苏打混合过筛，加入6中，用刮刀切拌至无干粉粒,"
    },
    {
      "text": "加入炒好的香肠洋葱，切拌均匀,"
    },
    {
      "text": "将面糊装入裱花袋，挤入纸杯中八分满,"
    },
    {
      "text": "在面糊表面滴上一滴老抽,"
    },
    {
      "text": "1"
    },
    {
      "text": "用牙签画出大理石花纹,"
    },
    {
      "text": "1"
    },
    {
      "text": "放入预热180度的烤箱，中层30分钟即可"
    }
  ],
