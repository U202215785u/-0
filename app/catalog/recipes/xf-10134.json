  "steps": [
    {
      "text": "将三黄鸡斩成小块，用盐、绍酒、胡椒粉腌渍,"
    },
    {
      "text": "干木耳泡清水，泡开,"
    },
    {
      "text": "葱切段、姜切片、青蒜斜切段、冬笋洗净切滚刀块,"
    },
    {
      "text": "锅中放油，煸香调味料,"
    },
    {
      "text": "放入腌好的鸡块煸炸出香味,"
    },
    {
      "text": "将鸡肉煎炸出油、紧实,"
    },
    {
      "text": "烹入酱油，将鸡肉炒上色出香味,"
    },
    {
      "text": "倒入煮开的香菇水和香菇，开锅盖盖改小火焖30分钟、加盐、黄冰糖调味,"
    },
    {
      "text": "开盖放入冬笋,"
    },
    {
      "text": "待冬笋入味，加入泡好的黑木耳，略烧,"
    },
    {
      "text": "1"
    },
    {
      "text": "最后加入青蒜段,"
    },
    {
      "text": "1"
    },
    {
      "text": "水淀粉勾薄芡，待汤汁全部裹在原料上出锅"
    }
  ],
