  "steps": [
    {
      "text": "熟香蕉切碎捣成泥备用,"
    },
    {
      "text": "全蛋加细砂糖用打蛋器搅匀，再加入色拉油搅拌均匀,"
    },
    {
      "text": "加入牛奶，搅拌均匀,"
    },
    {
      "text": "加入柠檬皮屑和柠檬汁，接着加入香蕉泥，搅拌均匀,"
    },
    {
      "text": "筛入低粉，用橡皮刮刀以不规则方向轻轻搅拌均匀,"
    },
    {
      "text": "装入纸膜内7分满，并在表面放上适量的核桃碎,"
    },
    {
      "text": "烤箱预热后，180度中层烤25-30分钟"
    }
  ],
