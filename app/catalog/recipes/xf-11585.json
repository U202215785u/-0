{
  "id": "xf-11585",
  "title": "辣白菜焗饭",
  "ingredients": [
    {
      "name": "隔夜饭",
      "mergeKey": "rice",
      "amount": 200,
      "unit": "克",
      "category": "米面主食"
    },
    {
      "name": "约一小把马苏里拉奶酪",
      "mergeKey": "mozzarella",
      "amount": 50,
      "unit": "克",
      "category": "乳制品"
    },
    {
      "name": "泡菜汤也要一点辣白菜",
      "mergeKey": "kimchi",
      "amount": 80,
      "unit": "克",
      "category": "蔬菜"
    },
    {
      "name": "胡萝卜",
      "mergeKey": "carrot",
      "amount": 75,
      "unit": "克",
      "category": "蔬菜"
    },
    {
      "name": "约40根黄豆芽",
      "mergeKey": "bean-sprout",
      "amount": 50,
      "unit": "克",
      "category": "蔬菜"
    },
    {
      "name": "30毫升植物油",
      "mergeKey": "cooking-oil",
      "amount": 30,
      "unit": "毫升",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "/2茶匙约3克盐",
      "mergeKey": "salt",
      "amount": 2.5,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "胡萝卜去皮切成丝，黄豆芽洗净沥干，辣白菜切碎备用,"
    },
    {
      "text": "炒锅中放入植物油，大火加热，待油温5成热时，放入胡萝卜丝和黄豆芽，改成用中火煸炒至胡萝卜和黄豆芽变软（约2分钟）,"
    },
    {
      "text": "然后加入辣白菜（连汤一起）翻炒2分钟，接着将米饭倒入锅中，用铲子轻轻压散，翻炒均匀后加入盐，再多翻炒几下使盐能均匀,"
    },
    {
      "text": "将炒好的辣白菜米饭放入焗碗中（高度为焗碗的3/4即可），在饭的表面撒上一层马苏里拉奶酪丝，放入预热好的烤箱，用180度的温度，烤约12-15分钟即可"
    }
  ],
