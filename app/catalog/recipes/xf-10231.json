{
  "id": "xf-10231",
  "title": "奶油花菜蘑菇浓汤",
  "ingredients": [
    {
      "name": "西兰花",
      "mergeKey": "broccoli",
      "category": "蔬菜"
    },
    {
      "name": "白花菜",
