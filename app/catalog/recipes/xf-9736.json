  "steps": [
    {
      "text": "海虾解冻后，洗净剪去须，用剪刀剪开背部，挑出肠泥,"
    },
    {
      "text": "干豆豉压碎切成末，葱切葱花，姜蒜切成末,"
    },
    {
      "text": "烧热油锅，倒入色拉油，用小火煸炒豆豉末，葱花和姜蒜末至出香味,"
    },
    {
      "text": "转大火，把海虾倒进去翻炒，至完全变色后，加少许料酒盖锅盖焖几秒钟,"
    },
    {
      "text": "开盖，放半汤匙老抽和半汤匙白糖，加半碗水，盖上盖子转中火煮三五分钟，开盖把汤汁收干即可"
    }
  ],
