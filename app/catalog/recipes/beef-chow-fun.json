  "steps": [
    {
      "text": "牛肉切成中等厚度或约半厘米的薄片，用常温水冲洗后沥干，并挤去多余水分。",
      "ingredientNames": [
        "牛肉"
      ]
    },
    {
      "text": "洋葱切成约半厘米厚的条；豆芽洗净；葱切成约2.5厘米的段，葱白和葱绿分开。",
      "ingredientNames": [
        "黄洋葱",
        "豆芽",
        "葱"
      ]
    },
    {
      "text": "把腌料中的食用油以外的材料混合，拌匀牛肉后再加入食用油。",
      "ingredientNames": [
        "食用油",
        "牛肉"
      ]
    },
    {
      "text": "开火前先把鲜河粉完全拆散；另取小碗调好炒河粉的碗汁。",
      "ingredientNames": [
        "鲜河粉"
      ]
    },
    {
      "text": "炒锅大火预热约1分30秒，加入食用油，继续加热约30秒至油面出现流动感。下牛肉炒约40至60秒，仍略带生色时盛出。",
      "ingredientNames": [
        "食用油",
        "牛肉"
      ]
    },
    {
      "text": "擦净炒锅。下洋葱和葱白炒20至30秒至出香，加入河粉，尽量少翻动。",
      "ingredientNames": [
        "黄洋葱",
        "葱",
        "鲜河粉"
      ]
    },
    {
      "text": "河粉炒约2分钟至边缘金黄、香气明显，加入调好的碗汁，再炒约1分钟使其均匀裹上酱汁。",
      "ingredientNames": [
        "鲜河粉",
        "老抽",
        "生抽",
        "蚝油"
      ]
    },
    {
      "text": "加入豆芽和葱绿炒30至45秒；倒回牛肉再炒约1分钟，关火后淋入芝麻油。",
      "ingredientNames": [
        "豆芽",
        "葱",
        "牛肉",
        "芝麻油"
      ]
    }
  ],
