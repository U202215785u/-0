  ],
  "steps": [
    { "text": "把牛里脊肉切成中等厚度（约 0.6 厘米）的片。用室温水冲洗后沥干，挤掉多余水分。", "ingredientNames": ["牛里脊肉"] },
    { "text": "黄洋葱切成 0.6 厘米厚的片；洗净绿豆芽；小葱切成 2.5 厘米长的段，葱白和葱绿分开。", "ingredientNames": ["黄洋葱", "绿豆芽", "小葱"] },
    { "text": "把除食用油外的腌料混合，裹匀牛肉，然后拌入食用油。", "ingredientNames": ["食用油", "牛里脊肉"] },
    { "text": "下锅前把新鲜河粉完全抖散；在小碗里调好牛河酱汁。", "ingredientNames": ["新鲜河粉"] },
    { "text": "炒锅开最大火预热约 1.5 分钟；下食用油，再烧约 30 秒至油面起波纹。下牛肉炒 40 到 60 秒，肉还略带红色时就盛出。", "ingredientNames": ["食用油", "牛里脊肉"] },
    { "text": "擦净炒锅。下洋葱和葱白炒 20 到 30 秒至出香；加入河粉，尽量少翻动。", "ingredientNames": ["黄洋葱", "小葱", "新鲜河粉"] },
    { "text": "河粉煎制约 2 分钟至金黄出香；加入调好的酱汁，炒约 1 分钟至均匀裹上酱色。", "ingredientNames": ["新鲜河粉", "老抽", "生抽", "蚝油"] },
    { "text": "加入绿豆芽和葱绿，炒 30 到 45 秒；回锅牛肉，再炒约 1 分钟，关火后淋入香油。", "ingredientNames": ["绿豆芽", "小葱", "牛里脊肉", "香油"] }
  ],
  "baseServings": 4,
  "durationMinutes": 45,
  "difficulty": "中等",
