{
  "id": "beef-chow-fun",
  "title": "干炒牛河",
  "ingredients": [
    { "name": "牛里脊肉", "amount": 280, "unit": "克", "category": "肉类", "mergeKey": "beef" },
    { "name": "黄洋葱", "quantityText": "半个", "category": "蔬菜", "mergeKey": "onion" },
    { "name": "绿豆芽", "quantityText": "1 把", "category": "蔬菜" },
    { "name": "小葱", "quantityText": "3 根", "category": "蔬菜", "mergeKey": "scallion" },
    { "name": "新鲜河粉", "amount": 454, "unit": "克", "category": "米面主食", "mergeKey": "rice-noodles" },
    { "name": "小苏打", "amount": 1, "unit": "茶匙", "category": "调味料", "pantry": true },
    { "name": "玉米淀粉", "amount": 1, "unit": "汤匙", "category": "调味料", "pantry": true },
    { "name": "蚝油", "amount": 2, "unit": "汤匙", "category": "调味料", "pantry": true },
    { "name": "生抽", "amount": 2, "unit": "汤匙", "category": "调味料", "pantry": true },
    { "name": "老抽", "amount": 2, "unit": "茶匙", "category": "调味料", "pantry": true },
    { "name": "白胡椒粉", "amount": 0.25, "unit": "茶匙", "category": "调味料", "pantry": true },
    { "name": "清水", "amount": 2, "unit": "汤匙", "category": "调味料", "pantry": true },
    { "name": "料酒", "amount": 1, "unit": "茶匙", "category": "调味料", "pantry": true },
    { "name": "糖", "amount": 1, "unit": "茶匙", "category": "调味料", "pantry": true },
    { "name": "食用油", "amount": 4, "unit": "汤匙", "category": "调味料", "pantry": true, "mergeKey": "cooking-oil" },
