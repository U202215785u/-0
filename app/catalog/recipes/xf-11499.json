  "steps": [
    {
      "text": "南瓜切成丝，与盐放入盘中搅拌，然后腌制1小时,"
    },
    {
      "text": "把面粉与1搅拌均匀备用,"
    },
    {
      "text": "把2取在手中，然后压成饼状,"
    },
    {
      "text": "将3放入不粘锅中，以小火将两面煎成金黄即可"
    }
