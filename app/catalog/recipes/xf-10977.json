  "title": "西芹炒百合",
  "ingredients": [
    {
      "name": "西芹",
      "mergeKey": "celery",
      "category": "蔬菜"
    },
    {
      "name": "百合",
      "mergeKey": "lily-bulb",
      "category": "蔬菜"
    },
    {
      "name": "食用油",
      "mergeKey": "cooking-oil",
