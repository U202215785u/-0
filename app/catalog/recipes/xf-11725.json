  "steps": [
    {
      "text": "苹果去核，切成薄片备用,"
    },
    {
      "text": "面团擀成长方形备用,"
    },
    {
      "text": "在面团上铺上苹果，淋上蜂蜜,"
    },
    {
      "text": "烤箱预热180度，放中层烤20分钟,"
    },
    {
      "text": "出炉后，撒上蓝莓即可"
    }
