  "steps": [
    { "text": "制馅：虾去壳去虾线（从尾部拧下，剥掉虾壳，用牙签挑出虾线），清水快速洗净，挤干水分备用。鱼柳用厨房纸吸干，切薄片，用最宽大的菜刀放平，从高处向下拍打鱼片成鱼泥，边拍边聚拢，再以正常握刀姿势剁一剁，切碎残余筋膜，使鱼泥柔软。", "ingredientNames": ["虾仁", "龙利鱼柳"] },
    { "text": "制虾泥与混合：虾不必切片，直接拍打成虾泥后再剁匀，越拍越细越黏。把鱼泥和虾泥合在一起，折叠拌匀，再彻底拍打一遍。想省事也可只选鱼肉或只选虾肉，或用猪肉、牛肉等其他蛋白质替代。", "ingredientNames": ["虾仁", "龙利鱼柳"] },
    { "text": "腌馅：小碗中混合白胡椒粉、盐、糖、玉米淀粉和清水，搅匀后倒在鱼虾泥上，非常彻底地搅拌，直到馅料吸收腌料、变得有黏性、起胶（多搅打会更有弹性）。放入冰箱冷藏备用。", "ingredientNames": ["白胡椒粉", "盐", "糖", "玉米淀粉", "清水"] },
    { "text": "切茄子：茄子去蒂去尾。斜刀切出约 1.3 厘米厚的夹片：第一刀距端部约 0.6 厘米处切入，切入约四分之三深度留作缝口，第二刀切断，整片约 1.3 厘米厚。重复切完所有茄子。", "ingredientNames": ["长茄子"] },
    { "text": "酿馅：取出冷藏的馅料，用勺子把馅填入茄子夹缝中，再用勺沿把两侧抹平弄干净。鱼虾熟得快，可尽量多塞馅。", "ingredientNames": ["长茄子", "虾仁", "龙利鱼柳"] },
    { "text": "备料头与酱汁：大蒜拍裂去皮剁末；姜拍裂剁末；辣椒去蒂剖开，切细丝再剁成细末；料头放一旁。另碗混合糖、生抽、老抽、蚝油、醋和清水，尝味调整；加入玉米淀粉和辣椒酱拌匀。", "ingredientNames": ["大蒜", "姜", "辣椒", "糖", "生抽", "老抽", "蚝油", "醋", "清水", "玉米淀粉", "辣椒酱"] },
    { "text": "煎茄子：平底锅或煎锅大火烧热，下油晃开，转中小火；逐块放入酿茄子，全部下完后可沿锅边补点油帮助煎上色。盖盖小火煎 1 分钟，其间可晃动锅让受热均匀。", "ingredientNames": ["玉米油", "长茄子"], "timerSeconds": 60 },
    { "text": "翻面再煎：开盖检查，若底部已金黄就翻面，补油并晃动锅让油分布开，盖盖再煎 30 秒。", "ingredientNames": ["玉米油", "长茄子"], "timerSeconds": 30 },
    { "text": "蒸汽焖熟：转大火，往锅里加清水；水一烧开就关火、盖盖，利用余热蒸汽焖 2 至 3 分钟，让茄子与馅料彻底熟透。", "ingredientNames": ["清水"], "timerSeconds": 150 },
    { "text": "收水装盘：开盖把火调回大火烧 15 至 20 秒，收掉部分水汽，盛盘备用。", "timerSeconds": 18 },
    { "text": "煮酱汁：洗净擦干锅（或换新锅），小火下油晃匀；下蒜末、姜末和辣椒末炒香约 20 至 30 秒；倒入酱汁边搅边煮，大火使酱汁煮沸即好；若太稠可加水调稀。", "ingredientNames": ["玉米油", "大蒜", "姜", "辣椒"], "timerSeconds": 30 },
    { "text": "收尾：关火，拌入香油。酱汁可淋在酿茄子上，或装碗蘸食。", "ingredientNames": ["香油"] }
  ],
  "baseServings": 4,
  "durationMinutes": 50,
  "difficulty": "较难",
