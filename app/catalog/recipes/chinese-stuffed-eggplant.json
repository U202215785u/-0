  "steps": [
    {
      "text": "虾和龙利鱼柳剁成鱼虾胶。将白胡椒粉、食盐、白糖、玉米淀粉、清水和芝麻油加入鱼虾胶，搅拌至黏稠后冷藏。",
      "ingredientNames": [
        "虾",
        "龙利鱼柳",
        "白胡椒粉",
        "食盐",
        "白糖",
        "玉米淀粉",
        "清水",
        "芝麻油"
      ]
    },
    {
      "text": "茄子切去头尾，再切成可夹馅的斜片；把冷藏好的鱼虾胶填入茄子片之间。",
      "ingredientNames": [
        "中国茄子",
        "虾",
        "龙利鱼柳"
      ]
    },
    {
      "text": "蒜拍碎切末，姜切片，辣椒切碎。将生抽、老抽、蚝油、米醋、辣椒酱、白糖、玉米淀粉和清水调成酱汁。",
      "ingredientNames": [
        "蒜",
        "姜",
        "辣椒",
        "生抽",
        "老抽",
        "蚝油",
        "米醋",
        "辣椒酱",
        "白糖",
        "玉米淀粉",
        "清水"
      ]
    },
    {
      "text": "平底锅大火烧热，加入食用油后转中小火，放入酿茄子，煎至两面定型并熟透。",
      "ingredientNames": [
        "食用油",
        "中国茄子"
      ]
    },
    {
      "text": "另起锅或擦干原锅，放入姜、蒜和辣椒炒香，倒入酱汁煮至顺滑，再放入酿茄子裹匀后装盘。",
      "ingredientNames": [
        "姜",
        "蒜",
        "辣椒",
        "清水",
        "玉米淀粉",
        "中国茄子"
      ]
    }
  ],
