  "steps": [
    {
      "text": "豆腐、姜末、蒜末、葱花,"
    },
    {
      "text": "将豆腐用手抓成大块（直接将整块豆腐下锅用锅铲压碎也可以）,"
    },
    {
      "text": "炒锅烧热，放入比炒菜略多一点的油，放入姜末和蒜末炒香,"
    },
    {
      "text": "放入豆腐用中小火翻炒，一直要炒到豆腐水分散干，表面呈金黄色，如果觉得豆腐的块太大可以用锅铲修整,"
    },
    {
      "text": "根据口味加入适量花椒面和辣椒面以及盐,"
    },
    {
      "text": "加入葱花起锅成盘，最后撒上适量葱花做装饰"
    }
  ],
