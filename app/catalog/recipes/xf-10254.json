  "steps": [
    {
      "text": "土豆去皮，切小方块，五花肉切成小方块，青椒切块，姜切片,"
    },
    {
      "text": "锅内热少许油，放入五花肉块及姜片,"
    },
    {
      "text": "小火煸炒至出油，（不要煸的太干）,"
    },
    {
      "text": "加入土豆块，盐1茶匙翻炒均匀,"
    },
    {
      "text": "加盖小火焖烧，中途常常翻动,"
    },
    {
      "text": "直至土豆块表面略金黄色，水份被完全烧干时，加入青椒块及鸡精，生抽，炒至水份收干即可"
    }
  ],
