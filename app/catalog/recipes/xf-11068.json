{
  "id": "xf-11068",
  "title": "酸奶蔓越莓天使蛋糕",
  "ingredients": [
    {
      "name": "酸奶",
      "mergeKey": "yogurt",
      "amount": 120,
      "unit": "克",
      "category": "乳制品"
    },
    {
      "name": "低筋面粉",
      "mergeKey": "flour",
      "amount": 10,
      "unit": "克",
      "category": "米面主食",
      "pantry": true
    },
    {
      "name": "酒浸蔓越莓",
      "mergeKey": "cranberry",
      "amount": 60,
      "unit": "克",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "色拉油",
      "mergeKey": "cooking-oil",
      "amount": 40,
      "unit": "毫升",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "香草香精",
      "mergeKey": "vanilla",
      "amount": 2,
      "unit": "毫升",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "约150克蛋白",
      "mergeKey": "egg-white",
      "amount": 5,
      "unit": "个",
      "category": "蛋类"
    },
    {
      "name": "细砂糖",
      "mergeKey": "sugar",
      "amount": 75,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "酸奶中加入色拉油搅拌均匀，加入香草精搅拌均匀,"
    },
    {
      "text": "低粉过筛后加入酸奶中，混和搅拌均匀；这时候烤箱160度预热,"
    },
    {
      "text": "蛋白中分三次加入砂糖，用电动打蛋器打发，打至接近硬性发泡,"
    },
    {
      "text": "打好的蛋白分二至三次加入到面糊中，每次加入之后都翻拌均匀,"
    },
    {
      "text": "蔓越莓沥干酒，再用10克面粉裹匀在表面，加入面糊中，然后倒入模中,"
    },
    {
      "text": "放入烤箱的中下层，烤约50分钟，烤好后，立即取出倒扣，晾透后脱模"
    }
  ],
