  "steps": [
    {
      "text": "罗非鱼去鳞、去鳃和内脏，洗净擦干；姜一半切丝、一半切片，葱切段，香菜切段。",
      "ingredientNames": [
        "罗非鱼",
        "姜",
        "葱",
        "香菜"
      ]
    },
    {
      "text": "将生抽、老抽、料酒、白胡椒粉、清水、白糖和食盐混合成蒸鱼汁。",
      "ingredientNames": [
        "生抽",
        "老抽",
        "料酒",
        "白胡椒粉",
        "清水",
        "白糖",
        "食盐"
      ]
    },
    {
      "text": "鱼身铺姜片，蒸锅加水烧沸，放入鱼盘，盖盖蒸至鱼肉熟透。",
      "ingredientNames": [
        "罗非鱼",
        "姜"
      ]
    },
    {
      "text": "取出鱼盘，倒掉盘中蒸出的水分，淋上蒸鱼汁，铺姜丝、葱段和香菜。",
      "ingredientNames": [
        "罗非鱼",
        "姜",
        "葱",
        "香菜",
        "生抽",
        "老抽",
        "料酒",
        "清水"
      ]
    },
    {
      "text": "食用油和芝麻油大火烧至微微冒烟，均匀浇在姜葱上即可。",
      "ingredientNames": [
        "食用油",
        "芝麻油"
      ]
    }
  ],
