  "steps": [
    { "text": "将罗非鱼去鳞去内脏（购买时通常已处理，如未处理需自行清理），剪去腹部脂肪、刮净脊骨上的干血，里外冲洗干净后用厨房纸吸干；剪去两侧鱼鳍，沿鱼背切一道长口以便蒸汽渗入均匀蒸熟；放入能进蒸锅的盘中。", "ingredientNames": ["罗非鱼"] },
    { "text": "姜分两半：一半切薄片后切极细的姜丝备用；另一半切薄片再对半切开，沿鱼身从头到尾铺在鱼背上。葱切三段，中段纵向切细丝备用，葱绿部分垫在鱼身下面增香。香菜洗净。", "ingredientNames": ["姜", "葱", "香菜"] },
    { "text": "小碗中混合生抽、老抽、料酒、白胡椒粉、清水、白糖和盐，调成酱汁备用。", "ingredientNames": ["生抽", "老抽", "料酒", "白胡椒粉", "清水", "白糖", "盐"] },
    { "text": "蒸锅加水烧至完全沸腾，放入鱼盘，盖盖大火蒸十二分钟（鱼较小约十分钟即可）；鱼眼变白即表示熟透。关火取出鱼盘，倒出鱼汁，取掉姜片，把姜丝和葱丝铺在鱼身上。", "timerSeconds": 720, "ingredientNames": ["罗非鱼", "姜", "葱"] },
    { "text": "另起锅高火热油约一分钟至油面微烟，小心浇在鱼身的姜丝葱丝上激出香味；撒上香菜，淋上香油和调好的酱汁即成。", "timerSeconds": 60, "ingredientNames": ["食用油", "香菜", "香油"] }
  ],
  "baseServings": 4,
  "durationMinutes": 25,
