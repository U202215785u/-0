  "steps": [
    { "text": "备鸡肉：鸡胸肉切成约 2.5 厘米厚的片，再切条、切丁，得到约 2.5 厘米见方的鸡丁。鸡肉放入碗中，加盐、糖、蚝油、生抽、老抽、料酒、白胡椒粉、玉米淀粉和清水，搅匀腌制备用。", "ingredientNames": ["鸡胸肉", "盐", "糖", "蚝油", "生抽", "老抽", "料酒", "白胡椒粉", "玉米淀粉", "清水"] },
    { "text": "备蔬菜：西兰花切下花蕾留作他用，这道菜只用脆嫩的茎，去老筋后切小丁；芹菜去头尾对半剖开再切丁；胡萝卜对半剖开、每半再各切三长条后切丁；绿甜椒对半去芯去籽切条再切丁，红甜椒同样处理；红葱头去皮后用刀侧拍裂；大蒜拍裂去皮剁末；干辣椒整根保留，可去蒂。", "ingredientNames": ["西兰花茎", "芹菜", "胡萝卜", "绿甜椒", "红甜椒", "红葱头", "大蒜", "干辣椒"] },
    { "text": "调酱汁与芡汁：碗中混合盐、糖、蚝油、生抽、老抽、料酒、磨豉酱和辣椒酱，搅匀。另取一碗，把玉米淀粉和清水拌匀成芡汁备用。", "ingredientNames": ["盐", "糖", "蚝油", "生抽", "老抽", "料酒", "磨豉酱", "辣椒酱", "玉米淀粉", "清水"] },
    { "text": "炸花生：炒锅中火烧热，下 1 汤匙食用油，转小火；油温合适（起波纹即可，冒烟则先降温）后下花生，不时翻动，小火炸约 2 分钟，捞出晾凉（此时还不脆，凉透后即酥脆）。", "ingredientNames": ["食用油", "花生"], "timerSeconds": 120 },
    { "text": "炒鸡肉：用炸花生的同一口锅和油，转大火再下 1 汤匙食用油；油起波纹后把腌好的鸡肉搅一下下锅，开始会粘锅，等底层煎熟自然脱锅后再轻翻，炒 40 至 50 秒让鸡丁各面均匀受热，盛出。", "ingredientNames": ["食用油", "鸡胸肉"], "timerSeconds": 40 },
    { "text": "焯蔬菜之胡萝卜：锅中加约 4 杯水（约 960 毫升）或没过所有蔬菜的水量，盖盖烧开，加盐调味；水开后先下胡萝卜焯 30 至 40 秒。", "ingredientNames": ["清水", "盐", "胡萝卜"], "timerSeconds": 35 },
    { "text": "焯蔬菜之芹菜与西兰花茎：下芹菜和西兰花茎，焯约 1 分半钟。", "ingredientNames": ["芹菜", "西兰花茎"], "timerSeconds": 90 },
    { "text": "焯蔬菜之彩椒：下红、绿甜椒，焯约 1 分钟。捞出一点尝一下软硬度是否合适，然后全部捞出沥干。若马上接着炒可留在漏勺里；若稍后再炒，用冰水或冷水冲凉。", "ingredientNames": ["红甜椒", "绿甜椒"], "timerSeconds": 60 },
    { "text": "炝锅：洗净擦干炒锅回炉，大火烧热下 1 汤匙食用油；下干辣椒段炒出香味，拨到锅边腾出位置，下红葱头。若锅太热怕香料烧焦，可关火降温片刻再开火。", "ingredientNames": ["食用油", "干辣椒", "红葱头"] },
    { "text": "爆香大蒜：下蒜末炒 30 秒出香。", "ingredientNames": ["大蒜"], "timerSeconds": 30 },
    { "text": "合炒：回入炒好的鸡肉，快速翻一下让香料分布均匀；下焯好的蔬菜，大火一起炒 30 秒；倒入酱汁翻拌均匀；约 30 秒后往锅中加水，帮助鸡肉吸收酱汁、保持多汁。", "ingredientNames": ["鸡胸肉", "西兰花茎", "芹菜", "胡萝卜", "红甜椒", "绿甜椒", "清水"], "timerSeconds": 30 },
    { "text": "勾芡收尾：转小火，把芡汁搅匀后边倒边不停搅拌，汤汁会迅速浓稠成顺滑的酱汁；最后淋入香油拌匀，关火装盘，撒上酥脆的炸花生即可。", "ingredientNames": ["玉米淀粉", "清水", "香油", "花生"] }
  ],
  "baseServings": 4,
  "durationMinutes": 45,
  "difficulty": "中等",
