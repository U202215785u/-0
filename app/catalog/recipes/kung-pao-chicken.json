  "steps": [
    {
      "text": "鸡胸肉切成约2.5厘米厚的片，再切成条，最后切成约2.5厘米见方的丁。把鸡丁推到碗边，在碗中加入食盐、白糖、蚝油、生抽、老抽、料酒、白胡椒粉、玉米淀粉和清水调成腌料，再与鸡肉拌匀。",
      "ingredientNames": [
        "鸡胸肉",
        "食盐",
        "白糖",
        "蚝油",
        "生抽",
        "老抽",
        "料酒",
        "白胡椒粉",
        "玉米淀粉",
        "清水"
      ]
    },
    {
      "text": "西兰花去掉花朵，只取脆嫩的梗，削去粗纤维后切小丁；芹菜去头尾、纵向剖开后切丁；胡萝卜、红甜椒和青甜椒切丁。红葱头拍松，蒜拍碎切末，干辣椒去蒂。",
      "ingredientNames": [
        "西兰花梗",
        "芹菜",
        "胡萝卜",
        "红甜椒",
        "青甜椒",
        "红葱头",
        "蒜",
        "干辣椒"
      ]
    },
    {
      "text": "将食盐、白糖、蚝油、生抽、老抽、料酒、磨碎豆瓣酱和辣椒酱混合成炒汁；另取小碗把玉米淀粉和清水调成水淀粉。",
      "ingredientNames": [
        "食盐",
        "白糖",
        "蚝油",
        "生抽",
        "老抽",
        "料酒",
        "磨碎豆瓣酱",
        "辣椒酱",
        "玉米淀粉",
        "清水"
      ]
    },
    {
      "text": "炒锅中火加食用油，油热后转小火，加入花生米，偶尔翻动，小火炸约2分钟后捞出，放凉后会变脆。",
      "ingredientNames": [
        "食用油",
        "花生米"
      ]
    },
    {
      "text": "沿用锅中炸花生的油，转大火并补入食用油。油面出现流动感时把腌好的鸡肉快速拌匀下锅，待底部定型后轻轻翻动，每面均匀加热约40至50秒，盛出备用。",
      "ingredientNames": [
        "鸡胸肉",
        "食用油"
      ]
    },
    {
      "text": "锅中加清水，盖盖烧开并用食盐调味。先下胡萝卜焯30至40秒，再下芹菜和西兰花梗焯约1分30秒，最后下红甜椒和青甜椒焯约1分钟，捞出沥水。",
      "ingredientNames": [
        "清水",
        "食盐",
        "胡萝卜",
        "芹菜",
        "西兰花梗",
        "红甜椒",
        "青甜椒"
      ]
    },
    {
      "text": "洗净并擦干炒锅，大火加食用油，先下干辣椒炒出香气，把辣椒拨到锅边，加入红葱头；加入蒜炒约30秒，再倒回鸡肉，加入焯好的蔬菜，大火翻炒约30秒。",
      "ingredientNames": [
        "食用油",
        "干辣椒",
        "红葱头",
        "蒜",
        "鸡胸肉",
        "西兰花梗",
        "芹菜",
        "胡萝卜",
        "红甜椒",
        "青甜椒"
      ]
    },
    {
      "text": "倒入炒汁翻匀，约30秒后加入清水。转小火，把水淀粉重新搅匀后边搅拌边慢慢倒入，收成顺滑的薄芡。关火淋入芝麻油，装盘后撒上炸花生。",
      "ingredientNames": [
        "食盐",
        "白糖",
        "蚝油",
        "生抽",
        "老抽",
        "料酒",
        "磨碎豆瓣酱",
        "辣椒酱",
        "清水",
        "玉米淀粉",
        "芝麻油",
        "花生米"
      ]
    }
  ],
  "baseServings": 4,
