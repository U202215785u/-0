  "steps": [
    {
      "text": "低粉、可可粉、泡打粉混合过筛备用,"
    },
    {
      "text": "鸡蛋打入碗里，倒入细砂糖，用手动打蛋器搅拌均匀即可，不需要打发,"
    },
    {
      "text": "倒入蜂蜜，搅拌均匀,"
    },
    {
      "text": "倒入少许香草精，搅拌均匀,"
    },
    {
      "text": "倒入过筛后的低筋面粉，用打蛋器慢慢搅拌均匀,"
    },
    {
      "text": "黄油融化后，倒入5中搅拌均匀,"
    },
    {
      "text": "搅拌均匀后的面糊放入冰箱冷藏1小时,"
    },
    {
      "text": "冷藏后的面糊稍微回温后倒入模中，烤箱中层，上下火190度，13-15分钟"
    }
  ],
