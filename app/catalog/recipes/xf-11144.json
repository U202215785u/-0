{
  "id": "xf-11144",
  "title": "蒜香番茄炒土豆片",
  "sourceUrl": "https://www.xiachufang.com/recipe/11144/",
  "author": "文怡",
  "fidelity": "verbatim-public",
  "sourceNote": "直接读取下厨房公开菜谱页面的结构化食材、份量和做法，未补写来源未提供的内容。",
  "ingredients": [
    {
      "name": "土豆",
      "mergeKey": "potato",
      "amount": 1,
      "unit": "个",
      "category": "蔬菜"
    },
    {
      "name": "番茄",
      "mergeKey": "tomato",
      "amount": 1,
      "unit": "个",
      "category": "蔬菜"
    },
    {
      "name": "大蒜",
      "mergeKey": "garlic",
      "amount": 20,
      "unit": "克",
      "category": "蔬菜"
    },
    {
      "name": "随意香菜",
      "mergeKey": "cilantro",
      "category": "蔬菜"
    },
    {
      "name": "/2茶匙3克盐",
      "mergeKey": "salt",
      "amount": 3,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "把土豆去皮，切成薄片放入清水中浸泡。番茄洗净后去蒂，切成块。大蒜去皮，切成片备用。香菜洗净后，切成1厘米长的段,"
    },
    {
      "text": "锅中倒入油大火加热，待油4成热时放入一半的大蒜片，煸炒出香味后，放入土豆片翻炒，一直炒到土豆片变成透明色,"
    },
    {
      "text": "放入番茄块，炒到番茄变软出汤后，放入盐翻炒均匀，关火后放入香菜段，和另一半的大蒜片翻炒几下出锅即可"
    }
  ],
  "tags": [
    "炒",
    "烧焖"
  ],
  "durationMinutes": 15,
  "difficulty": "中等"
}
