  "steps": [
    {
      "text": "麻鸡洗干净放入冷水，姜片，葱段，十粒花椒，烧开后转小火煮五分钟"
    },
    {
      "text": "再关火焖熟，大约十五分钟左右"
    },
    {
      "text": "用筷子撮一下鸡腿最厚的部位，能流出清澈汁水的表示鸡熟透"
    },
    {
      "text": "捞出放入冰水中泡冷"
    },
    {
      "text": "洗干净锅，放入少许两汤匙油，剩余花椒，小火爆香后捞出花椒"
    },
    {
      "text": "舀入一小勺到装有辣椒粉的碗中，拌均匀辣椒粉，继续烧热剩余的油，冒烟的时候可以关火，倒入辣椒粉中"
    },
    {
      "text": "迅速拌均匀"
    },
    {
      "text": "然后加入蒜末，生抽，鸡汤，盐，糖，香醋调成酱汁"
    },
    {
      "text": "炒香花生米，去衣压碎成粗颗粒，炒香芝麻，备用"
    },
    {
      "text": "鸡捞出切块码放碟中，倒入酱汁"
    },
    {
      "text": "1"
    },
    {
      "text": "撒上芝麻和花生碎，撒上葱花即成"
    }
  ],
