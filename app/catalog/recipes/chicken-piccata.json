  "steps": [
    {
      "text": "鸡胸肉横向剖成4块，用保鲜膜夹住轻轻拍薄至约1.3厘米，撒少量粗盐；面粉放浅盘，鸡排逐块裹粉并抖掉多余面粉。",
      "ingredientNames": [
        "去皮鸡胸肉",
        "粗盐",
        "面粉"
      ]
    },
    {
      "text": "平底锅中火加2汤匙橄榄油，鸡排分批下锅，不移动煎约2分钟至底面深褐，翻面再煎约30秒，盛出。",
      "ingredientNames": [
        "特级初榨橄榄油",
        "去皮鸡胸肉"
      ]
    },
    {
      "text": "锅中加入剩余橄榄油和拍碎的蒜，中火炒约2分钟至金黄；加入白葡萄酒和酸豆，刮起锅底焦香，煮约3分钟至酒液将干。",
      "ingredientNames": [
        "特级初榨橄榄油",
        "蒜",
        "干白葡萄酒",
        "酸豆"
      ]
    },
    {
      "text": "加入清水和黄油，快速转动锅子约1分钟，使黄油与水乳化成酱汁。",
      "ingredientNames": [
        "清水",
        "无盐黄油"
      ]
    },
    {
      "text": "鸡排回锅，小火煮约2分钟至熟透、酱汁能挂勺；离火拌入柠檬汁，尝味补盐，撒欧芹并配柠檬角。",
      "ingredientNames": [
        "去皮鸡胸肉",
        "鲜柠檬汁",
        "粗盐",
        "欧芹",
        "柠檬角"
      ]
    }
  ],
