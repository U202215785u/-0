  "steps": [
    {
      "text": "粉条提前剪短，用温水提前泡软,"
    },
    {
      "text": "排骨洗净血污，锅中冷水烧开，放排骨进去煮三分钟,"
    },
    {
      "text": "捞出排骨，洗净沥干,"
    },
    {
      "text": "干净锅中放冷水，把焯好水的排骨放入，开大火煮,"
    },
    {
      "text": "锅中煮开后转小火，撇去浮沫后，加料酒，生姜片和葱结，小火炖1个小时,"
    },
    {
      "text": "酸菜用清水洗洗沥干水份，炒锅放猪油，把酸菜丝倒入煸炒透，放入排骨汤内一起炖，10分钟后放粉条，煮几分钟看到粉条变透明，加适量盐和鸡精调好味，即可"
    }
  ],
