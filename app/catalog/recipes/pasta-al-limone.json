  ],
  "steps": [
    {
      "text": "用削皮器削下两条约5厘米长的柠檬皮，切成细丝留作装饰；剩余柠檬皮擦入厚底锅，柠檬挤出约2汤匙汁备用。",
      "ingredientNames": [
        "柠檬"
      ]
    },
    {
      "text": "另一口大锅盐水煮意面至很有嚼劲，面条会在酱汁中继续成熟。",
      "ingredientNames": [
        "意面",
        "食盐"
      ]
    },
    {
      "text": "柠檬皮锅中加入淡奶油，中火加热并常搅拌，约2分钟至刚开始沸腾。转中小火，每次加入1汤匙黄油并搅拌至融化，分次加入至酱汁乳化。",
      "ingredientNames": [
        "柠檬",
        "淡奶油",
        "无盐黄油"
      ]
    },
    {
      "text": "意面将熟时取出约1.5杯面汤；奶油锅加入四分之三杯面汤回中火，用夹子把意面移入锅中，逐步加入帕玛森奶酪并翻拌约3分钟至奶酪融化、酱汁顺滑。离火拌入柠檬汁，酱汁过稠时补1至2汤匙面汤。",
      "ingredientNames": [
        "意面",
        "帕玛森奶酪",
        "柠檬"
      ]
    },
    {
      "text": "盛盘，撒现磨黑胡椒和预留的柠檬皮丝。",
      "ingredientNames": [
        "黑胡椒",
        "柠檬"
      ]
    }
  ],
  "baseServings": 4,
  "durationMinutes": 15,
