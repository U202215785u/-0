    },
    {
      "name": "生粉",
      "mergeKey": "cornstarch",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "食用油",
      "mergeKey": "cooking-oil",
      "category": "调味料",
      "pantry": true
    },
    {
