{
  "id": "xf-10671",
  "title": "炒鸡丁",
  "ingredients": [
    {
      "name": "鸡脯肉",
      "mergeKey": "chicken-breast",
      "category": "肉类"
    },
    {
      "name": "胡萝卜",
      "mergeKey": "carrot",
      "category": "蔬菜"
    },
    {
      "name": "黄瓜",
      "mergeKey": "cucumber",
      "category": "蔬菜"
    },
    {
      "name": "姜片",
      "mergeKey": "ginger",
      "category": "蔬菜"
    },
    {
      "name": "胡椒粉",
      "mergeKey": "white-pepper",
      "category": "调味料",
