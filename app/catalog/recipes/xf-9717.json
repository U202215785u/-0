{
  "id": "xf-9717",
  "title": "杨梅果酱",
  "ingredients": [
    {
      "name": "新鲜杨梅",
      "mergeKey": "bayberry",
      "amount": 400,
      "unit": "克",
      "category": "蔬菜"
    },
    {
      "name": "麦芽糖",
      "mergeKey": "maltose",
      "amount": 180,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "白砂糖",
      "mergeKey": "sugar",
      "amount": 80,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "柠檬柠檬汁",
      "mergeKey": "lemon",
      "amount": 0.5,
      "unit": "个",
      "category": "蔬菜"
    }
  ],
  "steps": [
    {
      "text": "把杨梅用盐水浸泡15分钟，洗干净沥干水分,"
    },
    {
      "text": "用小刀把杨梅的果肉部分削下来。我取下来的果肉称了下，400克左右,"
    },
    {
      "text": "取一个耐酸的锅子（我用不锈钢锅），把杨梅果肉部分放在锅子里，放80克白砂糖，中小火，边煮边用木铲把杨梅果肉捣碎,"
    },
    {
      "text": "融化后会发现水很多，比我前面做过的水分都要多。所以这次麦芽糖我多加了点，倒入180克左右的麦芽糖，边煮边搅拌。前半程可以用中火煮，省时间,"
    },
    {
      "text": "煮到果酱稍有转浓稠的迹象，半个柠檬挤汁加入果酱中，再边煮边搅拌，直到比你想要的果酱稠度稍稀的状态，关火,"
    },
    {
      "text": "煮好的杨梅果酱在锅里稍凉，准备一个耐热防爆的容器（最好用超市买来的瓶装果酱吃完，空瓶洗净）,"
    },
    {
      "text": "在果酱温度不低于85度的时候，装瓶，盖紧。放在室温下凉透后放冰箱冷藏保存"
    }
  ],
