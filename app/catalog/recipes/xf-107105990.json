  "steps": [
    {
      "text": "碗里放两勺生抽，1勺蚝油，半勺老抽，少许盐和糖，1勺淀粉，半碗水搅拌均匀，备用"
    },
    {
      "text": "茄子洗净切成细条"
    },
    {
      "text": "加1勺盐，腌制10分钟左右"
    },
    {
      "text": "挤出水分"
    },
    {
      "text": "加1勺淀粉，搅拌均匀"
    },
    {
      "text": "油热放入茄子，煎至两面微黄"
    },
    {
      "text": "捞出备用"
    },
    {
      "text": "再放入肉末翻炒，炒至变色"
    },
    {
      "text": "放入葱蒜末炒香"
    },
    {
      "text": "加入1勺豆瓣酱"
    },
    {
      "text": "炒出红油"
    },
    {
      "text": "加入茄子翻炒"
    },
    {
      "text": "倒入调好的料汁，"
    },
    {
      "text": "翻炒均匀，烧至汤汁浓稠"
    },
    {
      "text": "放入小米椒，葱花即可出锅"
    }
  ],
