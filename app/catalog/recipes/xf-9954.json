      "amount": 120,
      "unit": "毫升",
      "category": "其他"
    },
    {
      "name": "酵母",
      "mergeKey": "yeast",
      "amount": 3,
      "unit": "克",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "盐",
      "mergeKey": "salt",
      "quantityText": "少许",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "香菜",
      "mergeKey": "cilantro",
      "quantityText": "少许",
