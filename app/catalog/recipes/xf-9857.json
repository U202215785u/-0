  "steps": [
    {
      "text": "鸡蛋加一小勺清水，打散备用（加点水炒出来的鸡蛋会比较嫩），蒜苗切小段,"
    },
    {
      "text": "扇贝、虾仁去壳洗净，放沸水中滚几分钟，捞出沥干水分备用,"
    },
    {
      "text": "将蒜苗、鸡蛋、扇贝、虾仁混合，加少许盐、鸡精、糖、胡椒粉搅拌均匀,"
    },
    {
      "text": "热锅热油，倒入混合好的蛋糊（不要急于翻炒），等蛋糊成形后，加少许料酒，再炒一会，出锅前淋少许香油"
    }
  ],
