    },
    {
      "name": "水发香菇",
      "mergeKey": "shiitake",
      "amount": 3,
      "unit": "朵",
      "category": "菌菇"
    },
    {
      "name": "/2小匙姜蓉",
      "mergeKey": "ginger",
      "amount": 2.5,
      "unit": "克",
      "category": "蔬菜"
    },
    {
      "name": "饭碗(200毫升)高汤",
