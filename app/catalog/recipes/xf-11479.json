{
  "id": "xf-11479",
  "title": "韭菜银芽炒鳝丝",
  "ingredients": [
    {
      "name": "中等黄鳝",
      "mergeKey": "eel",
      "amount": 1,
      "unit": "条",
      "category": "水产"
    },
    {
      "name": "绿豆芽",
      "mergeKey": "bean-sprout",
      "quantityText": "少许",
      "category": "蔬菜"
    },
    {
      "name": "韭菜",
      "mergeKey": "chives",
      "quantityText": "少许",
