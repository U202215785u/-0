    },
    {
      "name": "鸡精",
      "mergeKey": "chicken-powder",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "料酒",
      "mergeKey": "cooking-wine",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "湿淀粉",
      "mergeKey": "cornstarch",
      "category": "干货",
