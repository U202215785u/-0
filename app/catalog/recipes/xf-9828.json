  "steps": [
    {
      "text": "蒜、圆葱切末，鹅肝沾少许淀粉备用,"
    },
    {
      "text": "锅内放少许橄榄油，稍热，放入蒜末、圆葱末炒香,"
    },
    {
      "text": "放入鹅肝，小火慢慢煎，煎至两面焦黄，加少许盐调味,"
    },
    {
      "text": "煎鹅肝的中间，放入面包片（鹅肝油性大，面包有吸油的作用，吸收了油的面包很好吃），煎至金黄盛出，随即锅内放入少量红酒，待鹅肝吸收后，盛出,"
    },
    {
      "text": "盘内放入苹果片（苹果的作用主要是解油腻），摆上煎好的鹅肝和面包片，撒上莳萝叶即可"
    }
  ],
