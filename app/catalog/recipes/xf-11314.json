  "steps": [
    {
      "text": "锅内入油（比炒菜少一点，因为鸭子会很油），油热放入花椒粒爆香，捞出不用．,"
    },
    {
      "text": "放入两颗冰糖，蒜瓣，姜片，干椒段，八角炒出香味．,"
    },
    {
      "text": "放入鸭肉，煸炒至出油．,"
    },
    {
      "text": "调入盐，生抽，一点点老抽，倒入啤酒．大火烧开转小火，煮至收汁，加入青红椒片翻炒至断生．"
    }
  ],
