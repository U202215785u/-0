  "steps": [
    { "text": "粉丝用冷水浸泡 10 分钟（或热水 5 分钟）至变软，用剪刀剪短。", "timerSeconds": 600, "ingredientNames": ["粉丝（绿豆淀粉）"] },
    { "text": "锅中烧足量水，放入沥干的粉丝煮约 2 分半钟，至能用指甲掐断但仍带脆感。", "timerSeconds": 150, "ingredientNames": ["粉丝（绿豆淀粉）"] },
    { "text": "捞出放入冷水过凉（有冰水更佳），充分沥干后备用。", "ingredientNames": ["粉丝（绿豆淀粉）"] },
    { "text": "蒜末、辣椒碎和熟白芝麻放入小碗，油烧热后淋在上面，可见剧烈冒泡，立即搅拌使其受热均匀。", "ingredientNames": ["大蒜（切末）", "辣椒碎", "熟白芝麻", "食用油（味道中性）"] },
    { "text": "拌匀后加入生抽、黑米醋、香油、盐和糖，混合均匀。", "ingredientNames": ["生抽", "黑米醋", "香油", "盐", "糖"] },
    { "text": "粉丝、胡萝卜、黄瓜、鲜辣椒和香菜（若用）放入大碗，淋入调好的酱汁，充分拌匀后装盘享用。", "ingredientNames": ["粉丝（绿豆淀粉）", "胡萝卜（擦丝）", "黄瓜（擦丝）", "红辣椒（剁碎）", "香菜（可选）"] }
  ],
