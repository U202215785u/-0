  "steps": [
    {
      "text": "淮山削皮后切厚片，乳鸽清洗干净斩成4件，枸杞清洗干净，生姜削皮拍扁,"
    },
    {
      "text": "把所以材料放进汤锅里，加入适量清水，大火煮开，撇干净浮沫,"
    },
    {
      "text": "转中小火煲"
    },
    {
      "text": "5小时，放盐调味即可"
    }
  ],
