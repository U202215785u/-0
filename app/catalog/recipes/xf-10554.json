  "title": "春韭炒蛏子",
  "ingredients": [
    {
      "name": "韭菜",
      "mergeKey": "chive",
      "category": "蔬菜"
    },
    {
      "name": "蛏子",
      "mergeKey": "razor-clam",
      "category": "水产"
    },
    {
      "name": "红椒",
      "mergeKey": "red-pepper",
      "category": "蔬菜"
    },
    {
      "name": "姜片",
      "mergeKey": "ginger",
      "category": "蔬菜"
    },
    {
      "name": "食用油",
      "mergeKey": "cooking-oil",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "盐",
      "mergeKey": "salt",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "鸡精",
      "mergeKey": "chicken-powder",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "韭菜摘洗干净后切成段，红椒洗净去籽切片，姜切片,"
    },
    {
      "text": "蛏子买回来，水里养半天，让其吐尽沙泥，洗净捞出沥干。锅中水烧开后，把蛏子投入焯水，至蛏子开口立刻捞出，取肉并拉去边上的黑条备用,"
    },
    {
      "text": "锅烧热，放油，油热后下姜片炒出香味,"
    },
    {
      "text": "先把韭菜梗放入煸炒一会儿,"
    },
    {
      "text": "再放韭菜叶和红椒片，煸炒片刻,"
    },
    {
      "text": "把蛏子肉倒入，加适量盐和鸡精调味，翻炒均匀后迅速出锅"
    }
  ],
