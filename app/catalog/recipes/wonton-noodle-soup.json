  ],
  "steps": [
    { "text": "洗净小白菜，沿菜茎切成四瓣；小葱切小段；虾若已去壳去虾线则无需处理。", "ingredientNames": ["小白菜", "小葱", "虾"] },
    { "text": "灶开大火烧开一大锅水（水多一点面条熟得更快，口感更弹韧）。把云吞面抖散下锅，避免粘连。保持大火煮约六十秒。", "timerSeconds": 60, "ingredientNames": ["云吞面", "水"] },
    { "text": "捞出面条在冷水中浸几秒，再放回锅中煮约十五到二十秒。", "timerSeconds": 20, "ingredientNames": ["云吞面", "水"] },
    { "text": "把面条转入碗中，加一点橄榄油拌匀防粘。", "ingredientNames": ["橄榄油"] },
    { "text": "做汤底：锅中加入水和鸡汤烧开；水开后加入橄榄油和盐（气泡可能快速上涌，小心），下入小白菜稍搅后加盖，保持大火煮约一至两分钟直到重新烧开。", "timerSeconds": 90, "ingredientNames": ["水", "鸡汤", "橄榄油", "盐", "小白菜"] },
    { "text": "加入鱼露、香油和白胡椒粉，尝味调整。", "ingredientNames": ["鱼露", "香油", "白胡椒粉"] },
    { "text": "下入虾，同时开始把小白菜捞到面条上摆盘；虾约一分钟即熟，变橙红色即可捞出摆盘。", "timerSeconds": 60, "ingredientNames": ["虾"] },
    { "text": "生云吞放入滚水中煮约三至五分钟直到浮起。", "timerSeconds": 240, "ingredientNames": ["云吞"] },
    { "text": "把云吞放到面条碗上，小心倒入汤底，撒上葱花即可享用。", "ingredientNames": ["小葱"] }
  ],
  "baseServings": 4,
  "durationMinutes": 30,
  "difficulty": "中等",
  "tags": ["煮", "汤羹", "主食", "家常菜"],
  "sourceUrl": "https://www.madewithlau.com/recipes/wonton-noodle-soup",
