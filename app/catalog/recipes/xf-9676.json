  "steps": [
    {
      "text": "五花肉洗净用刀子刮净肉皮，切大块,"
    },
    {
      "text": "大白菜洗净切块,"
    },
    {
      "text": "土豆粉条提前用温水泡软,"
    },
    {
      "text": "五花肉凉水下锅，烧开，焯水祛除血末，捞出待用,"
    },
    {
      "text": "锅中做开水加入葱姜蒜、八角、茴香、花椒、烧开,"
    },
    {
      "text": "烧开后放入五花肉，大火烧开，烹入绍酒,"
    },
    {
      "text": "烧开后盖盖，改中火烧40分钟，待汤汁变白,"
    },
    {
      "text": "加入酱油盐、白糖调味,"
    },
    {
      "text": "捞去葱姜蒜，待五花肉入味大约10分钟，捞出一些肉,"
    },
    {
      "text": "放入粉条子炖5分钟,"
    },
    {
      "text": "1"
    },
    {
      "text": "加入切好的白菜炖3分钟,"
    },
    {
      "text": "1"
    },
    {
      "text": "放入捞出的肉搅拌将猪肉，粉条、白菜在锅中拌匀即可装碗出锅"
    }
  ],
