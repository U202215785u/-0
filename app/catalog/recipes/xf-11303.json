  "steps": [
    {
      "text": "材料处理：豆腐切块，鸭血氽烫过切块，瘦肉、木耳、胡萝卜、姜、干红椒切成丝,"
    },
    {
      "text": "肉丝用胡椒粉、盐、鸡精、少许淀粉拌匀，稍腌一下,"
    },
    {
      "text": "热锅凉油，小火把姜丝和干椒丝爆香,"
    },
    {
      "text": "放入肉丝炒散至变色,"
    },
    {
      "text": "加入清水或高汤烧开，依次下入鸭血和豆腐块。再次烧开时加入胡萝卜丝和木耳丝，烧至断生,"
    },
    {
      "text": "调入酱油、盐和鸡精，用湿生粉勾芡,"
    },
    {
      "text": "出锅前加入陈醋和胡椒粉，撒上葱花粒"
    }
  ],
