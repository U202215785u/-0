  "title": "虾仁蛋炒饭",
  "ingredients": [
    {
      "name": "隔夜米饭",
      "mergeKey": "rice",
      "category": "米面主食"
    },
    {
      "name": "虾仁",
      "mergeKey": "shrimp",
      "category": "水产"
    },
    {
      "name": "鸡蛋",
      "mergeKey": "egg",
      "category": "蛋类"
    },
    {
      "name": "食用油",
      "mergeKey": "cooking-oil",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "西芹",
      "mergeKey": "celery",
      "category": "蔬菜"
    },
    {
      "name": "葱花",
      "mergeKey": "scallion",
      "category": "蔬菜"
    },
    {
      "name": "盐",
      "mergeKey": "salt",
      "category": "调味料",
