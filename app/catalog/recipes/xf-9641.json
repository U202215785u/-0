  "steps": [
    {
      "text": "鸡翅洗净，放入大碗备用，葱姜蒜切小粒,"
    },
    {
      "text": "鸡翅中加入葱姜蒜粒，撒入百里香、加料酒、蚝油、生抽、老抽、蜂蜜、鸡粉，按摩3分钟,"
    },
    {
      "text": "放入冰箱冷藏腌制12小时以上,"
    },
    {
      "text": "烤盘铺上锡纸，摆上鸡翅，烤箱温度200度，烤制20分钟即可"
    }
  ],
