  "steps": [
    {
      "text": "将洋葱、迷迭香切碎；南瓜去皮切小块,"
    },
    {
      "text": "锅中放入橄榄油和牛油，待牛油融合后放入洋葱炒香,"
    },
    {
      "text": "放入南瓜和意大利米拌炒，加入盐、黑胡椒、迷迭香、高汤调味,"
    },
    {
      "text": "放入清水，使其水超过锅中的所有食材，加盖小火慢炖18分钟,"
    },
    {
      "text": "待水分略有收干后，关火，加入意大利干酪拌匀，盛入盘中，最后再撒一些干酪即可"
    }
  ],
