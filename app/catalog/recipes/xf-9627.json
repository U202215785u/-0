  "steps": [
    {
      "text": "准备材料,"
    },
    {
      "text": "鸡切成块，葱切成段，姜切成片备用,"
    },
    {
      "text": "水烧开，将鸡放入,"
    },
    {
      "text": "水烧开后至7成熟,"
    },
    {
      "text": "取出洗净,"
    },
    {
      "text": "锅中放油，倒入葱姜,"
    },
    {
      "text": "倒入干辣椒爆香葱姜,"
    },
    {
      "text": "下入鸡块,"
    },
    {
      "text": "大火炒后,"
    },
    {
      "text": "放入料酒，老抽，胡椒粉,"
    },
    {
      "text": "1"
    },
    {
      "text": "最后倒入盐即可出锅"
    }
