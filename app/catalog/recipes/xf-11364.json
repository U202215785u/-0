{
  "id": "xf-11364",
  "title": "蒜蓉辣子鸡",
  "ingredients": [
    {
      "name": "琵琶腿",
      "mergeKey": "chicken",
      "amount": 3,
      "unit": "个",
      "category": "肉类"
    },
    {
      "name": "姜片或者姜粉",
      "mergeKey": "ginger",
      "quantityText": "少许",
      "category": "蔬菜"
    },
    {
      "name": "半袋蒜蓉辣酱",
      "mergeKey": "garlic-chili-sauce",
      "amount": 50,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "小葱",
      "mergeKey": "scallion",
      "quantityText": "少许",
      "category": "蔬菜"
    }
  ],
  "steps": [
    {
      "text": "鸡腿去骨，切成小块。鸡脆骨，鸡皮单独剔下备用,"
    },
    {
      "text": "锅中加入少量的油，加入鸡腿肉翻炒，待其变色后加入生姜或者姜粉中火翻炒，尽量逼出鸡皮里面的油,"
    },
    {
      "text": "带鸡肉完全变白后，加入少许黄酒翻炒，烧制没有那么浓烈的黄酒味道时，加入50克蒜蓉辣酱拌匀，中火焖5分钟后装盘撒上葱花即可"
    }
  ],
