  "steps": [
    {
      "text": "红甜椒、青甜椒切丁，葱切段，红辣椒切圈，蒜切末。",
      "ingredientNames": [
        "红甜椒",
        "青甜椒",
        "葱",
        "红辣椒",
        "蒜"
      ]
    },
    {
      "text": "玉米淀粉、小苏打、料酒、蚝油、生抽、清水、白糖和食盐调成腌料，猪扒抓匀腌制。",
      "ingredientNames": [
        "玉米淀粉",
        "小苏打",
        "料酒",
        "蚝油",
        "生抽",
        "清水",
        "白糖",
        "食盐",
        "猪里脊扒"
      ]
    },
    {
      "text": "猪扒裹半个鸡蛋和玉米淀粉。中火加食用油至约193℃，猪扒分批下锅炸至熟透并定型。",
      "ingredientNames": [
        "猪里脊扒",
        "鸡蛋",
        "玉米淀粉",
        "食用油"
      ]
    },
    {
      "text": "小碗混合蒜盐、食盐和白胡椒粉。炒锅中火烧热，加少量食用油，放蒜、葱、红绿椒和红辣椒炒香。",
      "ingredientNames": [
        "蒜盐",
        "食盐",
        "白胡椒粉",
        "食用油",
        "蒜",
        "葱",
        "红甜椒",
        "青甜椒",
        "红辣椒"
      ]
    },
    {
      "text": "放回炸好的猪扒，撒入椒盐粉快速翻匀，尝味后装盘。",
      "ingredientNames": [
        "猪里脊扒",
        "蒜盐",
        "食盐",
        "白胡椒粉"
      ]
    }
  ],
