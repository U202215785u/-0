  "steps": [
    { "text": "红甜椒与青甜椒先切条再转九十度切成小丁；葱粗略切成中等大小的段；蒜去皮拍碎后切成末；红辣椒横切成薄圆片。猪排切成手掌大小并横剖成薄片，逆着肉纹切，再用刀背两面拍松嫩化。", "ingredientNames": ["红甜椒", "青甜椒", "葱", "蒜", "红辣椒", "猪里脊肉排"] },
    { "text": "腌料碗中混合玉米淀粉、小苏打、料酒、蚝油、生抽和清水，快速拌匀后加入白糖和盐。", "ingredientNames": ["玉米淀粉", "小苏打", "料酒", "蚝油", "生抽", "清水", "白糖", "盐"] },
    { "text": "用手把猪肉与腌料抓拌约一分钟，然后静置腌制三十分钟至一小时。", "timerSeconds": 1800, "ingredientNames": ["猪里脊肉排"] },
    { "text": "锅中加入玉米油，中火加热至约一百九十三摄氏度（三百八十华氏度）；等待油热时，在小碗中打散鸡蛋倒入腌好的猪肉拌匀（蛋液吸收淀粉后炸出来更酥脆）；把玉米淀粉铺在大盘上，油温到位后将猪排逐块裹上淀粉。", "ingredientNames": ["玉米油", "鸡蛋", "玉米淀粉"] },
    { "text": "将猪排逐块下油锅分批炸制，炸至外壳浅金黄色（约一分半）后捞出沥油；把油温升到约二百三十二摄氏度（四百五十华氏度）复炸约三十秒，口感更酥脆；炸油留出备用。", "timerSeconds": 90, "ingredientNames": ["猪里脊肉排", "玉米油"] },
    { "text": "小碗中混合蒜盐、盐和白胡椒粉，调成椒盐调味粉。", "ingredientNames": ["蒜盐", "盐", "白胡椒粉"] },
    { "text": "中火烧热炒锅，加入约一茶匙刚才的炸油，放入蒜末和红辣椒煸出香味；转大火加入甜椒炒约三十秒；加入葱段和全部猪排翻炒约三十秒；分次撒入调味粉使其均匀裹上猪排；再炒十五至二十秒后关火，继续翻拌二十至三十秒至均匀，即可装盘。", "timerSeconds": 110, "ingredientNames": ["蒜", "红辣椒", "红甜椒", "青甜椒", "葱", "猪里脊肉排", "蒜盐", "盐", "白胡椒粉"] },
    { "text": "尝味调整咸淡，装盘上桌。", "ingredientNames": [] }
  ],
  "baseServings": 4,
  "durationMinutes": 50,
  "difficulty": "中等",
  "tags": ["炸", "炒", "家常菜"],
