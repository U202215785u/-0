{
  "id": "chicken-corn-soup",
  "title": "鸡肉玉米汤",
  "ingredients": [
    { "name": "鸡胸肉", "amount": 84.0, "unit": "克", "category": "肉类", "pantry": false, "mergeKey": "chicken-breast" },
