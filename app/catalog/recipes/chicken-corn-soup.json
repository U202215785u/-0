  "steps": [
    {
      "text": "鸡胸肉切成小丁。"
    },
    {
      "text": "无糖玉米与等量清水放入搅拌机打碎。"
    },
    {
      "text": "玉米淀粉与清水混合，搅拌至完全溶解。"
    },
    {
      "text": "大锅调至最高火，加入清水并盖盖烧开。"
    },
    {
      "text": "最后加入食盐、鸡粉、白胡椒粉和芝麻油，增加鲜味。"
    }
  ],
  "baseServings": 4,
