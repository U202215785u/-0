  "title": "豆豉烧青椒",
  "ingredients": [
    {
      "name": "青椒",
      "mergeKey": "green-pepper",
      "amount": 5,
      "unit": "个",
      "category": "蔬菜"
    },
    {
      "name": "大蒜",
      "mergeKey": "garlic",
      "amount": 25,
      "unit": "克",
      "category": "蔬菜"
    },
    {
      "name": "豆豉",
      "mergeKey": "douchi",
      "amount": 15,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "/2小匙盐",
      "mergeKey": "salt",
      "amount": 2.5,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "青椒去蒂，用刀拍松；豆豉和大蒜切碎，豆豉先用水冲洗一下。如果太硬要泡十分钟,"
    },
    {
      "text": "锅内热2大匙油，放入青椒中火煸炒,"
    },
    {
      "text": "放入盐，加盖收小火，中途常常翻面,"
    },
    {
      "text": "至青椒两面煎至起皱皮时，放入大蒜及豆豉,"
    },
    {
      "text": "继续翻炒至青椒完全软烂即可"
    }
  ],
