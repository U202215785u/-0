  "steps": [
    {
      "text": "用温水将面粉活成面团，盖上屉布饧半小时,"
    },
    {
      "text": "将葱姜切末（葱多放一点）打一个鸡蛋，拌在猪肉馅里,"
    },
    {
      "text": "放入酱油、盐、绍酒花椒水调味,"
    },
    {
      "text": "加高汤、顺时针朝一个方向将肉馅打散即可（以前老妈做都加一点白菜捣碎汲去汤的白菜馅）,"
    },
    {
      "text": "将饧好的面的揉成长条,"
    },
    {
      "text": "揪成大小均匀的剂子,"
    },
    {
      "text": "将剂子揉圆擀成长方形面皮,"
    },
    {
      "text": "放入调好的猪肉馅抹平,"
    },
    {
      "text": "像叠被子一样左边叠一下,"
    },
    {
      "text": "右边叠一下,"
    },
    {
      "text": "1"
    },
    {
      "text": "两头稍稍捏劳，防止馅露出来,"
    },
    {
      "text": "1"
    },
    {
      "text": "依照以上办法多做一些,"
    },
    {
      "text": "1"
    },
    {
      "text": "电饼铛上倒入少量的油,"
    },
    {
      "text": "1"
    },
    {
      "text": "将做好的褡里火烧坯子在电饼铛里码放整齐,"
    },
    {
      "text": "1"
    },
    {
      "text": "一面煎成金黄色，出油,"
    },
    {
      "text": "1"
    },
    {
      "text": "翻至另一面也煎至出油，变成金黄色出锅即可"
    }
  ],
