  "steps": [
    {
      "text": "青椒、黑木耳、红椒洗干净切细，肉沫用料酒腌制下，臭豆腐捣碎备用,"
    },
    {
      "text": "起油锅，肉沫爆一下盛出,"
    },
    {
      "text": "锅里放油把辣椒爆香，再放黑木耳炒一下,"
    },
    {
      "text": "放臭豆腐和肉沫炒熟，加点酱油，盐、味精、糖最后放葱花就可以了"
    }
  ],
