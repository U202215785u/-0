  "steps": [
    {
      "text": "锅内放少许油，油热后，放入鲫鱼，两面煎成金黄色,"
    },
    {
      "text": "加入适量冷水，姜片，开锅后，转小火，30分钟,"
    },
    {
      "text": "加入适量盐调味，撒上香菜即可"
    }
