  "steps": [
    {
      "text": "半根胡萝卜洗净削皮切细丝,"
    },
    {
      "text": "水开后下入胡萝卜丝焯熟捞出过凉水后控干备用,"
    },
    {
      "text": "白菜心洗净切细丝备用,"
    },
    {
      "text": "豆腐丝用开水稍烫一下捞出控干晾凉切成和菜丝一样长的段备用,"
    },
    {
      "text": "香椿苗洗净后控干水,"
    },
    {
      "text": "将香椿苗和三丝混合，加入蚝油，糖，醋调味，制作完成"
    }
  ],
