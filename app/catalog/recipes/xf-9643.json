  "steps": [
    {
      "text": "草鱼背肉及腩肉切成小段,"
    },
    {
      "text": "用腌制材料将鱼块拌匀，密封放入冰箱冷藏过夜,"
    },
    {
      "text": "平底锅烧热，放油烧热，将腌好的鱼块（沥干水份），放入中小火慢煎,"
    },
    {
      "text": "煎至表面金黄色，再翻面煎至表面金黄，鱼8成熟即可,"
    },
    {
      "text": "生姜切丝，京葱切段，泡椒切小段,"
    },
    {
      "text": "锅内冷油，放入泡椒，生姜丝炒出香味，再加入京葱炒出香味,"
    },
    {
      "text": "锅内加入鱼块及清水，中火煮开后继续煮至水快干,"
    },
    {
      "text": "将调味料和水淀粉分别在碗内调匀,"
    },
    {
      "text": "将调味料（白糖必须溶化了）倒入锅内,"
    },
    {
      "text": ","
    },
    {
      "text": "1"
    },
    {
      "text": "煮至鱼块吸收酱汁后，加入水淀粉至起芡的效果即可"
    }
  ],
