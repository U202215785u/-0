  "steps": [
    {
      "text": "材料集合图,"
    },
    {
      "text": "豆腐切小块，海带嫩芽用清水泡发20分钟，再换水冲洗净盐份,"
    },
    {
      "text": "味噌1大匙 + 冷开水2大匙 调匀,"
    },
    {
      "text": "锅内注入清水，加入姜末煮开，再投入海带嫩芽煮约2分钟,"
    },
    {
      "text": "放入豆腐块,"
    },
    {
      "text": "倒入味噌调味料，再小火煮约3分钟,"
    },
    {
      "text": "洒上葱花，滴几滴麻油即可"
    }
  ],
