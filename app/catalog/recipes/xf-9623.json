  "steps": [
    {
      "text": "茄子洗净切长条,"
    },
    {
      "text": "咸鱼切碎粒,"
    },
    {
      "text": "锅内烧热油，下茄子炸软捞出，沥去油份,"
    },
    {
      "text": "锅内少许底油烧热，放蒜末炒香，下咸鱼粒煸炒至微黄,"
    },
    {
      "text": "倒入炸好的茄子翻炒均匀,"
    },
    {
      "text": "加入生抽和少许水焖3分钟，出锅勾芡即可"
    }
