  "steps": [
    {
      "text": "冻海参300克（用水发海参也行的），干香菇四五朵，姜一小块，小葱两根，青红椒各半个,"
    },
    {
      "text": "海参解冻，洗干净,"
    },
    {
      "text": "海参切成条，香菇泡软切片，姜切片，青红椒切片，小葱切段,"
    },
    {
      "text": "锅入油烧热，下姜片略炒,"
    },
    {
      "text": "加入海参、香菇、米酒中火翻炒片刻,"
    },
    {
      "text": "加入高汤或清水，加入盐、生抽、花椒粉，少量白糖，中小火烧5分钟。下葱段，青红椒片翻炒至断生,"
    },
    {
      "text": "加少量湿生粉勾芡收汁"
    }
  ],
