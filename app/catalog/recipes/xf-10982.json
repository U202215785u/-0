  "steps": [
    {
      "text": "将明虾去头、壳、纱线、留尾，开背、洗净待用,"
    },
    {
      "text": "将番茄、长豆角、红葱头改刀,"
    },
    {
      "text": "锅烧热倒入色拉油，放入红葱头、大蒜爆香,"
    },
    {
      "text": "放入鲜胡椒、柠檬叶和番茄，待番茄炒至出水，放入长豆角和调味料,"
    },
    {
      "text": "最后放入虾，拌炒至虾肉8成熟后，挤一些柠檬汁调味，出盘后撒一些柠檬碎叶即可"
    }
  ],
