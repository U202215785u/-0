    },
    {
      "name": "香叶",
      "mergeKey": "bay-leaf",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "锅子烧热，放色拉油，把香叶和八角放入小火炸香后捞出扔掉,"
    },
    {
      "text": "把蒜片放入爆出香味,"
    },
    {
      "text": "鸡翅放入，中大火不断煸炒至鸡翅表皮收紧并稍呈金黄色,"
    },
    {
      "text": "放点料酒翻炒几下后，马上放半汤匙老抽翻炒均匀,"
    },
    {
      "text": "倒入番茄沙司（我用了大概100毫升左右的番茄沙司，330毫升瓶装的番茄沙司三分之一瓶），加水和鸡翅齐平,"
    },
    {
      "text": "盖上盖子，转小火焖煮十分钟左右（喜欢吃酥烂点的就煮个二十分钟），开盖加鸡精，把汁收浓稠即可出锅"
    }
  ],
