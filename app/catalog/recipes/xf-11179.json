  "steps": [
    {
      "text": "海米冲洗干净后，温水泡发半小时,"
    },
    {
      "text": "丝瓜去皮后，切滚刀块备用,"
    },
    {
      "text": "起油锅，油热后，炒香海米,"
    },
    {
      "text": "下入蒜末、姜丝炒香,"
    },
    {
      "text": "下入丝瓜大火翻炒,"
    },
    {
      "text": "添加高汤和泡发海米的水，煮开后小火慢炖,"
    },
    {
      "text": "煮至丝瓜透明后，调入适量盐和味精,"
    },
    {
      "text": "勾薄芡，大火收汁,"
    },
    {
      "text": "撒上枸杞和葱花即可"
    }
  ],
