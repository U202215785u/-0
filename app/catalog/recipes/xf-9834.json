  "steps": [
    {
      "text": "冰鲜牛肚用温水浸泡20分钟,"
    },
    {
      "text": "将牛肚斜切成条状,"
    },
    {
      "text": "锅内烧开水，放入牛肚氽汤至水再度开，捞出,"
    },
    {
      "text": "马上放入冰水中浸泡10分钟，捞起完全沥干水份,"
    },
    {
      "text": "碗内放入所有调味料及红椒丝，香菜丝，芝麻，花生碎,"
    },
    {
      "text": "放入牛肚拌均匀即可上菜"
    }
  ],
