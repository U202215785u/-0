  "steps": [
    {
      "text": "锅内热油，放入生鸡块中火翻炒,"
    },
    {
      "text": "炒至鸡块变色后，加入姜片，蒜片继续翻炒至鸡块紧缩。烹入料酒炒至酒气散去,"
    },
    {
      "text": "将柱侯酱，砂糖，水调好后倒入锅内翻炒至出香味,"
    },
    {
      "text": "倒入清水约半杯，水量至鸡块的2/3处,"
    },
    {
      "text": "加盖小火焖煮至汤汁剩1/4时，加入青红椒块,"
    },
    {
      "text": "炒至青红椒块八成熟即可"
    }
  ],
