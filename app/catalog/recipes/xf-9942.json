    },
    {
      "name": "一小把蒜薹",
      "mergeKey": "suantai",
      "category": "蔬菜"
    },
    {
      "name": "蚝油",
      "mergeKey": "oyster-sauce",
      "amount": 15,
      "unit": "毫升",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "/2小勺盐",
      "mergeKey": "salt",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "/2小勺胡椒粉",
      "mergeKey": "white-pepper",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "几个干辣椒",
      "mergeKey": "dried-chili",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "几粒蒜",
      "mergeKey": "garlic",
      "category": "蔬菜"
    }
  ],
  "steps": [
    {
      "text": "土豆洗净去皮切薄片，蒜薹切段，鸡腿切块用少许盐和胡椒粉腌制一下，蒜粒去皮切片,"
    },
    {
      "text": "锅内烧热油放蒜薹煸炒至表面发皱捞出,"
    },
    {
      "text": "放土豆片煎至表面泛黄盛出,"
    },
    {
      "text": "鸡腿煎八成熟，倒入蒜片，干辣椒翻炒,"
    },
    {
      "text": "把土豆片，蒜薹回锅，加入蚝油，盐，胡椒粉翻炒均匀,"
    },
    {
      "text": "转入干锅，加热上桌即可"
    }
  ],
