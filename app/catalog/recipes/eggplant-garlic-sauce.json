  "steps": [
    {
      "text": "茄子切段；香菇、小甜椒、蒜、姜、葱和干辣椒切好。锅中蒸架加清水烧沸。",
      "ingredientNames": [
        "中国茄子",
        "鲜香菇",
        "小甜椒",
        "蒜",
        "姜",
        "葱",
        "干辣椒",
        "清水"
      ]
    },
    {
      "text": "茄子放蒸架蒸15分钟，蒸到柔软但不烂。",
      "ingredientNames": [
        "中国茄子"
      ]
    },
    {
      "text": "生抽、老抽、蚝油、醋、红糖、豆瓣酱、玉米淀粉、绍兴酒和清水混合成鱼香汁。",
      "ingredientNames": [
        "生抽",
        "老抽",
        "蚝油",
        "醋",
        "红糖",
        "豆瓣酱",
        "玉米淀粉",
        "绍兴酒",
        "清水"
      ]
    },
    {
      "text": "锅烧热加食用油，分批炒香蒜、姜、干辣椒、香菇和甜椒，再放入蒸好的茄子。",
      "ingredientNames": [
        "食用油",
        "蒜",
        "姜",
        "干辣椒",
        "鲜香菇",
        "小甜椒",
        "中国茄子"
      ]
    },
    {
      "text": "倒入鱼香汁翻拌至沸腾收浓，装盘撒葱，淋芝麻油。",
      "ingredientNames": [
        "生抽",
        "老抽",
        "蚝油",
        "醋",
        "红糖",
        "豆瓣酱",
        "玉米淀粉",
        "绍兴酒",
        "清水",
        "葱",
        "芝麻油"
      ]
    }
  ],
