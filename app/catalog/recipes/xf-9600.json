  "steps": [
    {
      "text": "将鱼肉切成2厘米大小方块，用鱼腌料拌匀腌制15分钟,"
    },
    {
      "text": "将菠萝切成小方块，青红椒切成小块,"
    },
    {
      "text": "将鱼肉先沾上蛋黄液,"
    },
    {
      "text": "锅内烧热油，再逐块沾上干玉米淀粉,"
    },
    {
      "text": "将鱼块放入170度油锅内，中火炸至表面微黄色,"
    },
    {
      "text": "捞起沥干油,"
    },
    {
      "text": "将酱料材料先在碗内混合。锅内热1小匙油，放入酱料烧至浓稠,"
    },
    {
      "text": "下入菠萝块及青红椒块翻炒至断生,"
    },
    {
      "text": "加入炸好的鱼块,"
    },
    {
      "text": "切勿在锅内停留过久，鱼块均匀裹上酱汁即可出锅"
    }
  ],
