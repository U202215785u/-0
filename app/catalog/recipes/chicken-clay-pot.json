  "steps": [
    {
      "text": "云耳和干香菇分别用温水泡发；鸡腿去骨切块，鸡骨留作高汤。姜、红葱头和蒜切片，葱白切段，腊肠切片。",
      "ingredientNames": [
        "云耳",
        "干香菇",
        "鸡腿",
        "姜",
        "红葱头",
        "蒜",
        "葱白",
        "广式腊肠"
      ]
    },
    {
      "text": "将蚝油、生抽、老抽、料酒、食盐和白糖混合，倒入鸡块中拌匀，再加入玉米淀粉和白胡椒粉抓匀腌制。",
      "ingredientNames": [
        "鸡腿",
        "蚝油",
        "生抽",
        "老抽",
        "料酒",
        "食盐",
        "白糖",
        "玉米淀粉",
        "白胡椒粉"
      ]
    },
    {
      "text": "炒锅大火烧热，加食用油；砂锅加盖小火预热。",
      "ingredientNames": [
        "食用油"
      ]
    },
    {
      "text": "炒锅中把鸡块煎至表面上色；砂锅中放姜、红葱头、蒜和葱白炒香，再放入鸡块、香菇、云耳和腊肠。",
      "ingredientNames": [
        "鸡腿",
        "食用油",
        "姜",
        "红葱头",
        "蒜",
        "葱白",
        "干香菇",
        "云耳",
        "广式腊肠"
      ]
    },
    {
      "text": "加入热水和剩余料酒、蚝油、生抽、老抽、白糖、食盐及水淀粉，盖盖焖至鸡肉熟透，开盖收至酱汁浓稠。",
      "ingredientNames": [
        "热水",
        "料酒",
        "蚝油",
        "生抽",
        "老抽",
        "白糖",
        "食盐",
        "玉米淀粉"
      ]
    }
  ],
