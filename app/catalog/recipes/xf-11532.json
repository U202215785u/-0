    },
    {
      "name": "黄油",
      "mergeKey": "butter",
      "amount": 10,
      "unit": "克",
      "category": "乳制品"
    },
    {
      "name": "糖粉",
      "mergeKey": "sugar",
      "amount": 25,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "(1个)鸡蛋",
      "mergeKey": "egg",
      "amount": 50,
      "unit": "克",
      "category": "蛋类"
    }
  ],
  "steps": [
    {
      "text": "黄油隔水加热融化成液态，和打散的鸡蛋混合在一起搅拌均匀，再加入糖粉搅拌均匀,"
    },
    {
      "text": "倒入过筛后的低筋面粉,"
    },
    {
      "text": "搅拌均匀（用打蛋器直接搅拌即可）,"
    },
    {
      "text": "倒入亚麻籽,"
    },
    {
      "text": "继续搅拌均匀成为面糊,"
    },
    {
      "text": "烤盘上铺油纸。用小勺挖适量面糊铺在烤盘上。每块面糊间留出足够大的距离。再用勺子背把面糊推平，要摊得足够薄。将烤盘放入预热好175度的烤箱，烤10-15分钟，直到表面变为金黄色即可出炉"
    }
  ],
