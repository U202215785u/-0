  "steps": [
    {
      "text": "将芒果去皮去核，取出果肉，放入搅拌机内搅打成泥状,"
    },
    {
      "text": "先制作底部的布丁层，在奶锅中倒入淡奶油，加入150克芒果泥和25克白糖,"
    },
    {
      "text": "小火煮至白糖融化，并搅拌均匀,"
    },
    {
      "text": "吉利丁放入冷水中泡软,"
    },
    {
      "text": "奶锅中倒入50克牛奶，将泡软的吉利丁片沥干水分，加入牛奶中，小火煮至吉利丁融化,"
    },
    {
      "text": "将步骤3与5混合，搅拌均匀,"
    },
    {
      "text": "倒入布丁瓶中，5分满，放入冰箱冷藏至凝固,"
    },
    {
      "text": "将剩余的130克芒果泥倒入锅中，加100克水，30克糖，煮至糖化，并搅拌均匀,"
    },
    {
      "text": "吉利丁片放入冷水中泡软,"
    },
    {
      "text": "泡软的吉利丁片沥干水分放入1中，小火煮至吉利丁融化,"
    },
    {
      "text": "1"
    },
    {
      "text": "倒入布丁层已经凝固的瓶中至9分满，盖上盖子，继续放入冰箱待果冻层凝固即可"
    }
  ],
