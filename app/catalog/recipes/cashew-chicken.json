  "steps": [
    { "text": "鸡胸肉洗净沥水，剔除白筋，切成约一厘米见方的丁；加入盐、生粉和两汤匙清水，用手抓捏按摩均匀，最好放入冰箱冷藏腌制过夜。", "ingredientNames": ["鸡胸肉", "盐", "生粉", "清水"] },
    { "text": "西芹撕去老筋，洗净切丁；用开水快速烫一下，捞出过冷水沥干备用。", "ingredientNames": ["西芹"] },
    { "text": "将生抽、老抽、葡萄醋、红糖、香油、白胡椒、鸡粉和一大汤匙清水放入小碗，搅匀成调味汁。", "ingredientNames": ["生抽", "老抽", "葡萄醋", "红糖", "香油", "白胡椒", "鸡粉", "清水"] },
    { "text": "不粘锅烧热，倒入食用油，油温热时放入葱段和姜丝翻炒约三十秒，然后下鸡丁翻炒至鸡肉表面变白。", "timerSeconds": 30, "ingredientNames": ["食用油", "葱", "姜丝", "鸡胸肉"] },
    { "text": "加入腰果翻炒约二十秒，倒入调味汁，翻炒均匀即可出锅。", "timerSeconds": 20, "ingredientNames": ["腰果"] }
  ],
