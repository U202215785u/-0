  "steps": [
    {
      "text": "将榴莲、泰国米粉、木薯粉、盐、椰浆和适量水一起搅拌均匀，揉匀面团，醒30分钟,"
    },
    {
      "text": "将拌混好的原料、做成手指大小的粉团,"
    },
    {
      "text": "将椰糖加适量水，熬煮成糖浆待用,"
    },
    {
      "text": "将粉团放入沸水中，煮至浮起后，加3次冷水，至粉团浮起，捞出,"
    },
    {
      "text": "趁热裹上椰丝，稍凉后撒上金色绿豆，淋上椰糖浆食用即可"
    }
  ],
