  "steps": [
    {
      "text": "虾去壳去虾线，鱼柳擦干；把虾和鱼分别切片后用刀拍剁成细腻鱼虾泥，拌匀。",
      "ingredientNames": [
        "虾",
        "鲶鱼柳"
      ]
    },
    {
      "text": "鱼虾泥加入玉米淀粉、料酒、食盐、白糖、白胡椒粉和清水，充分搅拌至黏稠，冷藏备用。",
      "ingredientNames": [
        "玉米淀粉",
        "料酒",
        "食盐",
        "白糖",
        "白胡椒粉",
        "清水"
      ]
    },
    {
      "text": "青甜椒和红甜椒切开，去掉籽和内膜；将冷藏鱼虾馅填入椒内，表面抹平。",
      "ingredientNames": [
        "青甜椒",
        "红甜椒"
      ]
    },
    {
      "text": "把豆豉酱、蚝油、生抽、白糖、玉米淀粉和清水调成黑豆酱汁。",
      "ingredientNames": [
        "豆豉酱",
        "蚝油",
        "生抽",
        "白糖",
        "玉米淀粉",
        "清水"
      ]
    },
    {
      "text": "平底锅加食用油，中火把酿椒两面煎至上色并熟透；必要时加少量清水，盖盖焖至馅心完全凝固。",
      "ingredientNames": [
        "食用油",
        "青甜椒",
        "红甜椒",
        "清水"
      ]
    },
    {
      "text": "原锅小火炒香余油中的椒汁，倒入黑豆酱汁煮至顺滑，淋芝麻油后浇在酿椒上。",
      "ingredientNames": [
        "豆豉酱",
        "蚝油",
        "生抽",
        "白糖",
        "玉米淀粉",
        "清水",
        "芝麻油"
      ]
    }
  ],
  "baseServings": 4,
