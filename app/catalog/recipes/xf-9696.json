  "steps": [
    {
      "text": "黄油室温软化后，加红糖打发,"
    },
    {
      "text": "加入鸡蛋打匀,"
    },
    {
      "text": "加入过筛的粉类用橡皮刮刀切拌均匀成面团,"
    },
    {
      "text": "分割成小面团，搓圆放入垫油纸的烤盘，用叉子按压扁,"
    },
    {
      "text": "度预热好的烤箱上层，180度烤制18分钟左右"
    }
