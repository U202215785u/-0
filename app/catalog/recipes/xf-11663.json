  "title": "粽香蚝油蒸排骨",
  "ingredients": [
    {
      "name": "肋排",
      "mergeKey": "pork-ribs",
      "category": "肉类"
    },
    {
      "name": "棕叶",
      "mergeKey": "zongzi-leaf",
      "category": "其他"
    },
    {
      "name": "蚝油",
