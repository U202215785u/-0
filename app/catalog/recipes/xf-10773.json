{
  "id": "xf-10773",
  "title": "酿虾肉豆腐",
  "ingredients": [
    {
      "name": "活虾",
      "mergeKey": "shrimp",
      "quantityText": "少量",
      "category": "水产"
    },
    {
      "name": "嫩豆腐",
      "mergeKey": "tofu",
      "amount": 1,
      "unit": "盒",
      "category": "豆制品"
    },
    {
      "name": "葱末",
      "mergeKey": "scallion",
      "category": "蔬菜"
    },
    {
      "name": "姜末",
      "mergeKey": "ginger",
      "category": "蔬菜"
    },
    {
      "name": "盐",
      "mergeKey": "salt",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "料酒",
      "mergeKey": "cooking-wine",
