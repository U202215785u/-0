  "steps": [
    {
      "text": "黑豆先泡胀,"
    },
    {
      "text": "将骨筒焯水，洗干净,"
    },
    {
      "text": "将骨筒、黑豆、土豆（可以用土豆粉替代）加水、白酒、糖、盐用高压锅压熟,"
    },
    {
      "text": "待食材全熟后，再加入奶油和黑胡椒调味,"
    },
    {
      "text": "将黑豆和土豆与汤用搅拌机打碎,"
    },
    {
      "text": "把步骤5倒入汤盘中，放少许鱼籽和植物点缀即可"
    }
  ],
