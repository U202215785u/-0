  "steps": [
    {
      "text": "鲈鱼洗净后，在两侧鱼背上斜着划上几刀，鱼身抹一层薄薄的盐，表面撒上适量豆豉,"
    },
    {
      "text": "蒸锅里的水煮沸后，放入鱼大火蒸8分钟关火，撒上葱花,"
    },
    {
      "text": "另起油锅，倒入2小勺油，2小勺生抽，将油和生抽混合煮沸后淋在鱼上即可"
    }
  ],
