  "steps": [
    {
      "text": "连皮猪肉，去毛洗净，放入冷水锅内煮至熟，变硬身"
    },
    {
      "text": "将煮好的猪肉冲洗干净放凉，切成薄而大的肉片"
    },
    {
      "text": "锅内仅放一茶匙油，放入肉片和姜片，用小火慢慢煎炒至出油，表面色泽变金黄色"
    },
    {
      "text": "加入1又1/2大匙红油豆瓣酱"
    },
    {
      "text": "翻炒至出红油后，再放入一匙生抽，料酒翻炒片刻。（如豆瓣酱放的多，也可免放生抽，不然会太咸）"
    },
    {
      "text": "投入青蒜白及红，青椒"
    },
    {
      "text": "翻炒至青蒜白及红，青椒断生即可"
    },
    {
      "text": "最后放入青蒜叶，翻炒片刻即可出锅"
    }
  ],
