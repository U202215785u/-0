  "steps": [
    {
      "text": "切牛肉：找到牛肉纹理并逆纹切，不要切得太薄，否则烹煮时容易散碎。切好后放入清水碗中抓洗，洗去血水（抓洗可加快），用漏勺沥去多余的水和血水。",
      "ingredientNames": [
        "牛肉"
      ]
    },
    {
      "text": "调腌料：小苏打是中式嫩肉常用手法。碗中加小苏打、蚝油、生抽、清水、玉米淀粉、白胡椒粉、糖和料酒，搅匀。",
      "ingredientNames": [
        "小苏打",
        "蚝油",
        "生抽",
        "清水",
        "玉米淀粉",
        "白胡椒粉",
        "糖",
        "料酒"
      ]
    },
    {
      "text": "腌牛肉：牛肉放入腌料中，揉抓至两面都裹满腌料，静置 30 分钟。",
      "ingredientNames": [
        "牛肉"
      ],
      "timerSeconds": 1800
    },
    {
      "text": "备蔬菜：西兰花切成一口大小的朵，主茎单独分开便于煮熟；胡萝卜切薄片；姜切小粒，几片就够；小葱斜切成小段；大蒜剁末。",
      "ingredientNames": [
        "西兰花",
        "胡萝卜",
        "姜",
        "小葱",
        "大蒜"
      ]
    },
    {
      "text": "调酱汁：小碗中混合蚝油、生抽、老抽、清水、料酒、糖、玉米淀粉和白胡椒粉，搅匀。",
      "ingredientNames": [
        "蚝油",
        "生抽",
        "老抽",
        "清水",
        "料酒",
        "糖",
        "玉米淀粉",
        "白胡椒粉"
      ]
    },
    {
      "text": "焯西兰花：中锅把水烧开，加入少许油和一大撮盐，保持西兰花翠绿；下西兰花煮至你喜欢的软硬度（本菜谱约煮 2 分钟），捞出沥干；若不会马上炒，用流水冲凉。",
      "ingredientNames": [
        "西兰花",
        "盐",
        "食用油"
      ],
      "timerSeconds": 120
    },
    {
      "text": "炒牛肉：腌好的牛肉拌入 1 汤匙食用油，锁住肉汁。炒锅烧到最高火，下 2 汤匙食用油晃开润满锅底和锅壁，倒掉多余油；转中火下牛肉，煎约 30 至 60 秒或等边缘变褐就翻面，再煎 60 至 90 秒至大部分变褐（微红没关系，之后还要和菜同炒），关火盛出。",
      "ingredientNames": [
        "牛肉",
        "食用油"
      ],
      "timerSeconds": 60
    },
    {
      "text": "炒香料与蔬菜：锅内下蒜末和姜粒，炒 20 至 30 秒；下小葱段和胡萝卜片，再炒 20 至 30 秒；下西兰花，炒 30 至 40 秒；回入牛肉，全部一起炒 30 至 45 秒。西兰花很吸水，如需要可加约 1 汤匙清水。",
      "ingredientNames": [
        "大蒜",
        "姜",
        "小葱",
        "胡萝卜",
        "西兰花",
        "牛肉",
        "清水"
      ],
      "timerSeconds": 30
    },
    {
      "text": "下酱汁收尾：倒入酱汁，持续翻炒约 1 分钟；淋入香油翻匀；最后可再补少许油裹在西兰花上，显得油亮好看，尝味调整后装盘。",
      "ingredientNames": [
        "蚝油",
        "生抽",
        "老抽",
        "清水",
        "料酒",
        "糖",
        "玉米淀粉",
        "白胡椒粉",
        "香油"
      ],
      "timerSeconds": 60
    }
  ],
