  "title": "东坡肉",
  "ingredients": [
    {
      "name": "五花肉",
      "mergeKey": "pork-belly",
      "category": "肉类"
    },
    {
      "name": "香葱",
      "mergeKey": "scallion",
      "category": "蔬菜"
    },
    {
      "name": "老抽",
      "mergeKey": "dark-soy-sauce",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "生抽",
      "mergeKey": "soy-sauce",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "料酒",
      "mergeKey": "cooking-wine",
      "category": "调味料",
