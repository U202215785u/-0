  "steps": [
    {
      "text": "锅内烧开水，放入切块猪肉氽烫至水开，捞起洗净，沥干水,"
    },
    {
      "text": "锅内放1小匙油，放入猪肉块，小火煸至微黄出油脂,"
    },
    {
      "text": "捞起肉块放入冰糖，小火炒成焦糖色,"
    },
    {
      "text": "放入肉块炒至均匀上色，加入京葱段，八角，姜片，花雕酒炒出香味,"
    },
    {
      "text": "加入清水1200毫升及所有调味料，加盖大火煮开后转小火炖约60分钟,"
    },
    {
      "text": "煮至中途，把葱段和姜片捞起,"
    },
    {
      "text": "粉条提前用温水浸泡至软,"
    },
    {
      "text": "当锅内的水炖至1/3时，放入泡软粉条,"
    },
    {
      "text": "中小火开盖煮制，粉条煮的时间要略长些,"
    },
    {
      "text": "最后煮至粉条软化即可"
    }
  ],
