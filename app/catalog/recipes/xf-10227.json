  "steps": [
    {
      "text": "将肉切成长薄片（肉稍冻一下再切，就比较好切了）,"
    },
    {
      "text": "青蒜切段、红彩椒切段,"
    },
    {
      "text": "炒锅内放油，七成热时下肉片煸炒,"
    },
    {
      "text": "煸炒至肉片吐油四周微微焦黄，捞出备用,"
    },
    {
      "text": "锅内做油放姜末葱花煸炒出香味，下豆瓣酱、豆豉炒香并上色再放酱油、糖炒匀,"
    },
    {
      "text": "再放入刚才煸炒的肉片,"
    },
    {
      "text": "下青蒜和红彩椒炒至断生,"
    },
    {
      "text": "煸炒均匀即可起锅"
    }
  ],
