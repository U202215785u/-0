  "steps": [
    {
      "text": "将高粉和低粉混合过筛，加入所有原料揉成光滑的面团,"
    },
    {
      "text": "发酵至2倍大,"
    },
    {
      "text": "排气后分割成均等的2份，再次发酵30分钟,"
    },
    {
      "text": "发酵好的面团擀成皮萨盘的大小,"
    },
    {
      "text": "用叉子在饼上叉些小孔，防止烤的时候面团膨胀,"
    },
    {
      "text": "烤箱200度预热，将饼皮先烤10分钟，表面上色后取出,"
    },
    {
      "text": "饼皮上第一层刷上番茄酱,"
    },
    {
      "text": "第二层放马苏里拉奶酪,"
    },
    {
      "text": "再依次放入青椒、洋葱和培根，最后再撒上一层马苏里拉奶酪,"
    },
    {
      "text": "烤箱200度中层再烤10分钟即可"
    }
  ],
