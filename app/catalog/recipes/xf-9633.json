  "steps": [
    {
      "text": "绿豆粉丝用冷水泡软,"
    },
    {
      "text": "带子洗净，用牙刷把壳刷干净,"
    },
    {
      "text": "锅内烧热油，放入蒜蓉，盐马上熄火翻炒片刻制成蒜蓉备用,"
    },
    {
      "text": "将带子开壳，去内脏洗净,"
    },
    {
      "text": "将带子肉取出，粉丝放带子底,"
    },
    {
      "text": "表面淋上蒜蓉,"
    },
    {
      "text": "锅内水烧开将带子放上蒸4分钟,"
    },
    {
      "text": "在每个带子上淋上生抽及糖，最后烧热少许油，乘热淋在带子上即可"
    }
  ],
