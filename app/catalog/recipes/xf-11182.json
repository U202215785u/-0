{
  "id": "xf-11182",
  "title": "椒麻辣藕丁",
  "ingredients": [
    {
      "name": "莲藕",
      "mergeKey": "lotus-root",
      "category": "蔬菜"
    },
    {
      "name": "大蒜",
      "mergeKey": "garlic",
      "category": "蔬菜"
    },
    {
      "name": "干辣椒",
      "mergeKey": "dried-chili",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "花椒",
      "mergeKey": "sichuan-peppercorn",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "葱",
      "mergeKey": "scallion",
      "category": "蔬菜"
    },
    {
      "name": "醋",
      "mergeKey": "vinegar",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "蒸鱼酱油",
      "mergeKey": "fish-soy-sauce",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "盐",
      "mergeKey": "salt",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "莲藕削皮后切成丁,"
    },
    {
      "text": "藕丁放入清水中浸泡，可加入少许白醋，以防炒制时变黑，还可去除较多淀粉，使其口感更脆嫩,"
    },
    {
      "text": "泡藕丁时，可将大蒜拍碎切末、葱切段,"
    },
    {
      "text": "锅中倒油，开小火炸香干辣椒段和花椒,"
    },
    {
      "text": "倒入大蒜末后倒入藕丁翻炒2分钟,"
    },
    {
      "text": "淋入蒸鱼酱油翻炒均匀，再撒入盐、葱段，沿锅边淋入少许醋再翻炒均匀即可"
    }
  ],
