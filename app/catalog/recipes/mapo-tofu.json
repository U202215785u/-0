  "steps": [
    {
      "text": "将北豆腐切成约2.5厘米见方的小块，轻轻滑入盛水的锅中，加盐，水烧开后小火煮1分钟，捞出沥干备用。",
      "timerSeconds": 60,
      "ingredientNames": ["北豆腐（嫩或中硬度）", "盐"]
    },
    {
      "text": "空锅烧热后倒入油，放入牛肉末（或猪肉末）和姜，大火翻炒至肉色变浅。",
      "ingredientNames": ["食用油", "牛肉末（或猪肉末）", "姜"]
    },
    {
      "text": "加入四川辣豆瓣酱（郫县豆瓣）、豆豉、辣椒粉和大蒜，炒出香味。",
      "ingredientNames": ["四川辣豆瓣酱（郫县豆瓣）", "豆豉", "辣椒粉", "大蒜"]
    },
    {
      "text": "倒入绍兴料酒和400毫升清水（或无盐高汤），煮开后轻轻滑入豆腐，不盖锅盖煮约5分钟。",
      "timerSeconds": 300,
      "ingredientNames": ["绍兴料酒", "清水", "北豆腐（嫩或中硬度）"]
    },
    {
      "text": "转中火，先倒入一半调匀的水淀粉（玉米淀粉加3汤匙水调成），煮约10秒，再倒入剩下的一半。",
      "timerSeconds": 10,
      "ingredientNames": ["玉米淀粉"]
    },
    {
      "text": "待酱汁浓稠到能挂住锅铲时，加入花椒粉和葱花，轻轻拌匀后立即关火。趁热配白米饭食用。",
      "ingredientNames": ["花椒粉", "小葱"]
    }
  ],
  "baseServings": 2,
  "durationMinutes": 20,
  "difficulty": "中等",
  "tags": ["家常菜", "烧", "快手菜"],
