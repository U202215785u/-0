  "steps": [
    {
      "text": "猪龙骨斩小块，洗净,"
    },
    {
      "text": "入锅绰水后，捞出洗净,"
    },
    {
      "text": "龙骨放入锅中，放足量冷水，入姜片，大火烧开转小火，撇去浮末，放料酒，盖上盖子小火煲一个小时,"
    },
    {
      "text": "一个小时候后，加去皮切成块的胡萝卜，继续用小火煲半个小时,"
    },
    {
      "text": "半小时后，加切成小段的玉米，继续煲半小时,"
    },
    {
      "text": "玉米入锅半小时后，加洗净的蘑菇和芹菜粒，加盐，再小火煲十分钟加鸡精调好味即可"
    }
  ],
