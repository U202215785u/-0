  "steps": [
    {
      "text": "青红椒，酸笋切丝，瘦肉切丝用腌肉料腌制10分钟,"
    },
    {
      "text": "锅内放一大匙油，3成熟时放入瘦肉炒至变色，捞起备用,"
    },
    {
      "text": "剩下的油，放入姜、蒜蓉爆香,"
    },
    {
      "text": "将青红椒丝，酸笋丝炒入炒至断生,"
    },
    {
      "text": "加入炒好的肉丝翻炒均匀,"
    },
    {
      "text": "临出锅前加入少许鸡精炒匀即可"
    }
  ],
