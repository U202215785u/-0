  "steps": [
    { "text": "黄瓜切去两端；间隔削皮（保留青皮条纹可减轻苦味与韧感）；对半剖开，挖掉带籽的水分中心，保持爽脆、避免酱汁被稀释。", "ingredientNames": ["黄瓜"] },
    { "text": "用菜刀刀面或其他重物把黄瓜拍裂（力度要使其裂开但别拍成泥），全部拍完后斜切成厚块放入碗中。", "ingredientNames": ["黄瓜"] },
    { "text": "红甜椒切条；小葱切小段；香菜粗略切碎；大蒜拍碎去皮切末。", "ingredientNames": ["红甜椒", "小葱", "香菜", "大蒜"] },
    { "text": "黄瓜中加入盐和糖充分拌匀，再加入红甜椒条拌匀，静置五到六分钟让盐逼出水分；趁这段时间调酱汁。", "timerSeconds": 330, "ingredientNames": ["黄瓜", "盐", "糖", "红甜椒"] },
    { "text": "把辣椒酱、生抽、蚝油、醋和糖混合成酱汁，加入蒜末拌匀。", "ingredientNames": ["辣椒酱", "生抽", "蚝油", "醋", "糖", "大蒜"] },
    { "text": "倒掉黄瓜和红甜椒腌出的水。", "ingredientNames": ["黄瓜", "红甜椒"] },
    { "text": "加入葱花和酱汁拌匀；再加入香菜、白芝麻、香油和食用油拌匀（用量可按喜好调整），装盘即可，也可冷藏后冰凉享用。", "ingredientNames": ["小葱", "香菜", "白芝麻", "香油", "食用油"] }
  ],
  "baseServings": 4,
  "durationMinutes": 10,
  "difficulty": "简单",
  "tags": ["凉拌", "快手菜", "家常菜", "素菜"],
  "sourceUrl": "https://www.madewithlau.com/recipes/smashed-cucumber-salad",
