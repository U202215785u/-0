  "steps": [
    {
      "text": "黄瓜去头尾后拍裂，切成小段；红甜椒切条，蒜切末，葱和香菜切碎。",
      "ingredientNames": [
        "黄瓜",
        "红甜椒",
        "蒜",
        "葱",
        "香菜"
      ]
    },
    {
      "text": "黄瓜和红甜椒加入食盐、白糖，拌匀后静置出水，再沥干。",
      "ingredientNames": [
        "黄瓜",
        "红甜椒",
        "食盐",
        "白糖"
      ]
    },
    {
      "text": "辣椒酱、生抽、蚝油、醋和白糖调匀，加入蒜末。",
      "ingredientNames": [
        "辣椒酱",
        "生抽",
        "蚝油",
        "醋",
        "白糖",
        "蒜"
      ]
    },
    {
      "text": "把酱汁、葱和香菜加入黄瓜与红甜椒，拌匀后撒白芝麻。",
      "ingredientNames": [
        "黄瓜",
        "红甜椒",
        "葱",
        "香菜",
        "白芝麻"
      ]
    },
    {
      "text": "食用油烧热后浇在白芝麻和蒜末上，淋芝麻油即可。",
      "ingredientNames": [
        "食用油",
        "白芝麻",
        "蒜",
        "芝麻油"
      ]
    }
  ],
