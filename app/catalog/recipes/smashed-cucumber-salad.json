    { "name": "盐", "amount": 5.0, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "salt" },
    { "name": "糖", "amount": 35.0, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "sugar" },
    { "name": "辣椒酱", "amount": 2.5, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "chili-sauce" },
    { "name": "生抽", "amount": 19.5, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "soy-sauce" },
    { "name": "蚝油", "amount": 15.0, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "oyster-sauce" },
    { "name": "醋", "amount": 30.0, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "vinegar" },
    { "name": "白芝麻", "amount": 15.0, "unit": "毫升", "category": "干货", "pantry": false, "mergeKey": "sesame-seeds" },
    { "name": "香油", "amount": 2.5, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "sesame-oil" },
