{
  "id": "smashed-cucumber-salad",
  "title": "拍黄瓜",
  "ingredients": [
    { "name": "黄瓜", "amount": 560.0, "unit": "克", "category": "蔬菜", "pantry": false, "mergeKey": "cucumber" },
    { "name": "红甜椒", "amount": 56.0, "unit": "克", "category": "蔬菜", "pantry": false, "mergeKey": "bell-pepper" },
