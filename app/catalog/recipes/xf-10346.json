{
  "id": "xf-10346",
  "title": "纽约芝士蛋糕",
  "ingredients": [
    {
      "name": "黄油",
      "mergeKey": "butter",
      "amount": 20,
      "unit": "克",
      "category": "乳制品"
    },
    {
      "name": "奶油奶酪",
      "mergeKey": "cream-cheese",
      "amount": 400,
      "unit": "克",
      "category": "乳制品"
    },
    {
      "name": "酸奶油",
      "mergeKey": "sour-cream",
      "amount": 200,
      "unit": "克",
      "category": "乳制品"
    },
    {
      "name": "消化饼干",
      "mergeKey": "digestive-biscuit",
      "amount": 50,
      "unit": "克",
      "category": "米面主食",
      "pantry": true
    },
    {
      "name": "白糖",
      "mergeKey": "sugar",
      "amount": 15,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "鸡蛋",
      "mergeKey": "egg",
      "amount": 3,
      "unit": "个",
      "category": "蛋类"
    },
    {
      "name": "/2小勺香草精",
      "mergeKey": "vanilla-extract",
      "amount": 2.5,
      "unit": "毫升",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "消化饼干碾碎后，加入黄油拌匀，在模底压实备用,"
    },
    {
      "text": "自制酸奶油：200克淡奶油中加入1大勺柠檬汁，搅拌均匀后，冷藏半小时后备用,"
    },
    {
      "text": "奶油奶酪加糖，隔热水用打蛋器打至顺滑无颗粒状,"
    },
    {
      "text": "分次加入鸡蛋，搅拌均匀,"
    },
    {
      "text": "加入120克酸奶油，搅拌均匀,"
    },
    {
      "text": "加入香草精搅拌均匀,"
    },
    {
      "text": "拌好的芝士糊倒入模中，烤箱预热后，烤盘中倒入热水170度水浴烘焙30分钟后，取出烤盘，将模子放置烤网上150度再烘焙30分钟。烤好后取出蛋糕静置20分钟,"
    },
    {
      "text": "待蛋糕表面呈凹陷状，剩余的80克酸奶油加15克白糖搅拌均匀后，淋在蛋糕表面的凹处，再次入烤箱150度烘烤10分钟，取出冷却后，入冰箱冷藏后脱模装饰"
    }
  ],
