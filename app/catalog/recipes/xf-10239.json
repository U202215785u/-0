  "steps": [
    {
      "text": "将卤水材料加入清水1300毫升，大火煮开后转小火煮20分钟,"
    },
    {
      "text": "将牛肉顺纹理切成1厘米厚度大片,"
    },
    {
      "text": "锅内烧开水，放入牛肉片煮至起泡，捞起冲净，沥干水份,"
    },
    {
      "text": "将氽烫过的牛肉片放入卤肉锅内，大火煮开后，加盖小火煮约60分钟,"
    },
    {
      "text": "至水份差不多收干，用筷子大力可以插入肉块中,"
    },
    {
      "text": "捞起肉块，切成5厘米长条状,"
    },
    {
      "text": "锅子烧热，放入白芝麻，小火炒至表面微黄,"
    },
    {
      "text": "加入辣椒粉，花椒粉，五香粉小火炒出香味，盛出备用,"
    },
    {
      "text": "将生抽，砂糖，鸡精在碗内混合均匀,"
    },
    {
      "text": "锅内放2大匙，加入牛肉片小火炒至表面微干,"
    },
    {
      "text": "1"
    },
    {
      "text": "倒出里面的油，加入调好的酱汁，继续炒至水份干燥,"
    },
    {
      "text": "1"
    },
    {
      "text": "加入炒好的白芝麻，辣椒粉，花椒粉混合均匀即可"
    }
  ],
