  "steps": [
    {
      "text": "锅内放入黄油、水、糖、盐，小火加热,"
    },
    {
      "text": "煮制沸腾时关火,"
    },
    {
      "text": "倒入过筛后的低筋面粉,"
    },
    {
      "text": "搅拌成均匀的面团,"
    },
    {
      "text": "继续开小火，不断搅拌至锅底出现一层薄膜（约2分钟）,"
    },
    {
      "text": "关火，取出面团，放置不烫手,"
    },
    {
      "text": "分4~5次加入蛋液，每次都要拌至完全吸收再加下一次,"
    },
    {
      "text": "用勺子舀起面糊，面糊呈现倒三角形流动即可,"
    },
    {
      "text": "将1/5的面糊装入裱花袋，前端装小号圆嘴,"
    },
    {
      "text": "挤出天鹅的头颈，放入170度烤箱烤制6~8分钟,"
    },
    {
      "text": "1"
    },
    {
      "text": "剩余面糊挤出大小均匀的水滴状,"
    },
    {
      "text": "1"
    },
    {
      "text": "用叉子沾水画出纹路，放入190度的烤箱烤制25分钟,"
    },
    {
      "text": "1"
    },
    {
      "text": "取出待凉，将一半的水滴泡芙纵剖开，做为翅膀,"
    },
    {
      "text": "1"
    },
    {
      "text": "淡奶油加入白砂糖,"
    },
    {
      "text": "1"
    },
    {
      "text": "搅打至全发，装入裱花袋中，使用大花嘴,"
    },
    {
      "text": "1"
    },
    {
      "text": "在水滴泡芙上挤上淡奶油,"
    },
    {
      "text": "1"
    },
    {
      "text": "两旁贴上纵剖开的“翅膀,"
    },
    {
      "text": "1"
    },
    {
      "text": "插上“头颈”，即可食用"
    }
  ],
