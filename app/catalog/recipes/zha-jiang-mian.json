{
  "id": "zha-jiang-mian",
  "title": "炸酱面",
  "ingredients": [
    { "name": "干黄酱", "amount": 60.0, "unit": "毫升", "category": "调味料", "pantry": false, "mergeKey": "yellow-soybean-paste" },
    { "name": "甜面酱（或海鲜酱）", "amount": 15.0, "unit": "毫升", "category": "调味料", "pantry": false, "mergeKey": "sweet-bean-sauce" },
    { "name": "清水", "amount": 300.0, "unit": "毫升", "category": "其他", "pantry": true, "mergeKey": "water" },
    { "name": "食用油", "amount": 30.0, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "cooking-oil" },
    { "name": "八角", "amount": 1.0, "unit": "个", "category": "调味料", "pantry": false, "mergeKey": "star-anise" },
    { "name": "葱", "amount": 2.0, "unit": "根", "category": "蔬菜", "pantry": false, "mergeKey": "scallion" },
    { "name": "姜末", "amount": 5.0, "unit": "毫升", "category": "蔬菜", "pantry": false, "mergeKey": "ginger" },
    { "name": "猪肉丁", "amount": 200.0, "unit": "克", "category": "肉类", "pantry": false, "mergeKey": "pork" },
    { "name": "绍兴料酒", "amount": 5.0, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "shaoxing-wine" },
    { "name": "豆芽", "amount": 150.0, "unit": "克", "category": "蔬菜", "pantry": false, "mergeKey": "beansprouts" },
    { "name": "毛豆（鲜青豆）", "amount": 150.0, "unit": "克", "category": "蔬菜", "pantry": false, "mergeKey": "edamame" },
    { "name": "黄瓜", "amount": 1.0, "unit": "根", "category": "蔬菜", "pantry": false, "mergeKey": "cucumber" },
    { "name": "萝卜", "amount": 6.0, "unit": "根", "category": "蔬菜", "pantry": false, "mergeKey": "radish" },
