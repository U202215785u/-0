  ],
  "steps": [
    { "text": "碗中把干黄酱和甜面酱（或海鲜酱）用三百毫升清水化开，备用。", "ingredientNames": ["干黄酱", "甜面酱（或海鲜酱）", "清水"] },
    { "text": "炒锅中火烧热油，放入八角、葱的绿色部分和姜末爆香，加入猪肉丁和绍兴料酒，翻炒至肉色变白（建议选用带一点肥肉的猪肉，也可改用肉末或牛肉、羊肉、鸡肉、豆腐、香菇）。", "ingredientNames": ["食用油", "八角", "葱", "姜末", "猪肉丁", "绍兴料酒"] },
    { "text": "倒入化开的酱料，煮开后转小火熬二十分钟。", "timerSeconds": 1200, "ingredientNames": ["干黄酱", "甜面酱（或海鲜酱）"] },
    { "text": "转大火把酱汁收浓至合适的稠度，拌入葱的白色部分。", "ingredientNames": ["葱"] },
    { "text": "烧一锅开水，把豆芽和毛豆（鲜青豆）焯水后捞出沥干，黄瓜切丝、萝卜切片生食备用。", "ingredientNames": ["豆芽", "毛豆（鲜青豆）", "黄瓜", "萝卜"] },
    { "text": "用同一锅水煮面条（干面条每人约一百克），捞出过冷水几秒后沥干。", "ingredientNames": ["鲜面条（或干面条）"] },
    { "text": "把面条分装入四个碗中，浇上炸酱，再码上豆芽、毛豆、黄瓜丝和萝卜片等配菜，拌匀食用。" }
  ],
