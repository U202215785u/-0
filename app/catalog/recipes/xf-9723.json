{
  "id": "xf-9723",
  "title": "葱香椒盐芋艿",
  "ingredients": [
    {
      "name": "芋奶",
      "mergeKey": "taro",
      "category": "蔬菜"
    },
    {
      "name": "葱花",
      "mergeKey": "scallion",
      "category": "蔬菜"
    },
    {
      "name": "椒盐粉",
      "mergeKey": "spiced-salt",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "食用油",
      "mergeKey": "cooking-oil",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "芋奶用刷子刷洗干净，放水里煮熟（用筷子可以轻松插入）,"
    },
    {
      "text": "煮熟的芋奶剥皮切块，葱切成葱花，准备椒盐粉,"
    },
    {
      "text": "锅里多点油，油热了把芋奶块炸几分钟，至表面稍稍出现金黄即可,"
    },
    {
      "text": "捞出沥油,"
    },
    {
      "text": "锅里油倒出，用余油把芋奶和葱花煸炒下，撒上椒盐粉出锅"
    }
  ],
