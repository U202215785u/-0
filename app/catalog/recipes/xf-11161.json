  "steps": [
    {
      "text": "黄瓜、山药、蒜洗净去皮，木瓜洗净去皮、去籽,"
    },
    {
      "text": "用花刀将其切成大小均匀的片状,"
    },
    {
      "text": "热锅凉油，油五成热放入蒜片略炒,"
    },
    {
      "text": "放入山药翻炒几下，接着放入黄瓜翻炒，加一点清水继续翻炒至黄瓜变色,"
    },
    {
      "text": "倒入木瓜翻炒几下,"
    },
    {
      "text": "淋一点明油即可装盘"
    }
  ],
