      "name": "鸡腿",
      "mergeKey": "chicken",
      "amount": 3,
      "unit": "只",
      "category": "肉类"
    },
    {
      "name": "菠萝",
      "mergeKey": "pineapple",
      "amount": 0.5,
      "unit": "只",
