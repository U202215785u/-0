{
  "id": "xf-11563",
  "title": "南瓜糯米糍",
  "ingredients": [
    {
      "name": "去皮老南瓜南瓜",
      "mergeKey": "pumpkin",
      "amount": 180,
      "unit": "克",
      "category": "蔬菜"
    },
    {
      "name": "糯米粉",
      "mergeKey": "glutinous-rice-flour",
      "amount": 150,
      "unit": "克",
      "category": "米面主食",
      "pantry": true
    },
    {
      "name": "澄粉",
      "mergeKey": "wheat-starch",
      "amount": 30,
      "unit": "克",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "色拉油",
      "mergeKey": "cooking-oil",
      "amount": 15,
      "unit": "毫升",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "豆沙馅",
      "mergeKey": "red-bean-paste",
      "quantityText": "适量",
      "category": "其他"
    },
    {
      "name": "椰蓉",
      "mergeKey": "coconut-flakes",
      "quantityText": "少量",
      "category": "干货",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "去皮老南瓜切成小丁，入锅蒸熟,"
    },
    {
      "text": "蒸熟的南瓜丁取出（蒸的时候盘里会有些水，把这些水倒掉），按压成南瓜泥,"
    },
    {
      "text": "加入糯米粉、澄粉和色拉油，揉合成光滑面团,"
    },
    {
      "text": "把南瓜面团分成每份20克、豆沙馅分成每份15克,"
    },
    {
      "text": "取一份南瓜面团，搓圆压扁包入豆沙馅，收口搓圆。排入垫了蒸笼布的蒸笼,"
    },
    {
      "text": "入锅蒸，水开后10分钟左右即可。出锅后，趁热在表面滚上一层椰蓉即可开动啦"
    }
  ],
