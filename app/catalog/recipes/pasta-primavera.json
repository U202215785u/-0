  "steps": [
    {
      "text": "大锅盐水煮中等意面，比包装建议时间少煮约2分钟至很有嚼劲；捞出并保留约1杯面汤。",
      "ingredientNames": [
        "中等意面",
        "食盐"
      ]
    },
    {
      "text": "厚底锅中小火加橄榄油，加入洋葱、蒜、少量食盐和黑胡椒，常搅拌炒8至10分钟至洋葱透明变软。",
      "ingredientNames": [
        "特级初榨橄榄油",
        "白洋葱",
        "蒜",
        "食盐",
        "黑胡椒"
      ]
    },
    {
      "text": "加入西葫芦炒约5分钟至变软，再加入芦笋、西兰花、豌豆、淡奶油、意面和半杯面汤，翻炒约5分钟至蔬菜变软、奶油裹住面条。",
      "ingredientNames": [
        "西葫芦",
        "芦笋",
        "冷冻西兰花",
        "冷冻豌豆",
        "淡奶油",
        "中等意面"
      ]
    },
    {
      "text": "离火，加入帕玛森奶酪、罗勒、柠檬汁和黄油，用力翻拌至奶酪融化、酱汁顺滑发亮；需要时补面汤。盛盘后撒罗勒。",
      "ingredientNames": [
        "帕玛森奶酪",
        "罗勒",
        "柠檬汁",
        "无盐黄油"
      ]
    }
  ],
  "baseServings": 4,
