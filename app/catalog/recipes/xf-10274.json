{
  "id": "xf-10274",
  "title": "自制枣泥馅",
  "ingredients": [
    {
      "name": "红枣",
      "mergeKey": "red-date",
      "amount": 500,
      "unit": "克",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "冰糖",
      "mergeKey": "rock-sugar",
      "amount": 50,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "葵花籽油",
      "mergeKey": "cooking-oil",
      "amount": 30,
      "unit": "毫升",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "澄粉",
      "mergeKey": "wheat-starch",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "小麦淀粉",
      "mergeKey": "wheat-starch",
      "amount": 30,
      "unit": "克",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "清水",
      "mergeKey": "water",
      "amount": 50,
      "unit": "毫升",
      "category": "其他"
    }
  ],
  "steps": [
    {
      "text": "红枣洗净泡1小时，冰糖砸碎，澄粉或玉米淀粉，葵花油或其他食用油均可,"
    },
    {
      "text": "将红枣放入锅内，清水要没过红枣，开锅后中火煮30分钟，煮好的枣用凉水清洗干净后再用凉水泡一会，凉透将每个枣剥皮去核,"
    },
    {
      "text": "将枣肉放在一个筛子里过滤，如果怕麻烦可以省去这一步，不过过筛的枣泥特细腻,"
    },
    {
      "text": "锅里放50克清水将冰糖融化，接着放油炒几下，再将枣泥、澄粉放入，炒至浓稠即可"
    }
  ],
