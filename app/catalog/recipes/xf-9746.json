  "steps": [
    {
      "text": "派皮,"
    },
    {
      "text": "黄油室温软化后，加入糖份搅打均匀,"
    },
    {
      "text": "加入蛋液搅打均匀,"
    },
    {
      "text": "加入过筛的面粉，翻拌均匀,"
    },
    {
      "text": "将面团放入保鲜袋中，放入冰箱冷藏30分钟,"
    },
    {
      "text": "将冷藏后的面团擀成3毫米厚的薄片,"
    },
    {
      "text": "将面皮移到派模上，用擀面杖擀去多余的面皮,"
    },
    {
      "text": "将面皮放入冰箱冷藏15分钟,"
    },
    {
      "text": "松弛后的面团用叉子叉上小孔，放上一张烘焙纸，然后倒入红豆，防止塔皮在烤焙时膨胀,"
    },
    {
      "text": "入预热180℃的烤箱，中层，上下火，15分钟，然后把豆子取出来，再烤10分钟,"
    },
    {
      "text": "1"
    },
    {
      "text": "馅料,"
    },
    {
      "text": "1"
    },
    {
      "text": "奶酪加糖隔热水搅打至顺滑无颗粒状,"
    },
    {
      "text": "1"
    },
    {
      "text": "加入鸡蛋搅打均匀,"
    },
    {
      "text": "1"
    },
    {
      "text": "加入淡奶油，牛奶搅打均匀,"
    },
    {
      "text": "1"
    },
    {
      "text": "加入柠檬汁搅匀,"
    },
    {
      "text": "1"
    },
    {
      "text": "筛入低粉拌匀,"
    },
    {
      "text": "1"
    },
    {
      "text": "将用朗姆酒泡发的蔓越莓沥干水分，加入拌匀,"
    },
    {
      "text": "1"
    },
    {
      "text": "将馅料倒入事先烤好的派皮中，9分满，放入预热好的烤箱170度下层烤35分钟，待乳酪馅凝固即可"
    }
  ],
