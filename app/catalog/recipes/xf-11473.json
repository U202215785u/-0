{
  "id": "xf-11473",
  "title": "黄油小饼干",
  "ingredients": [
    {
      "name": "黄油",
      "mergeKey": "butter",
      "amount": 240,
      "unit": "克",
      "category": "乳制品"
    },
    {
      "name": "糖粉",
      "mergeKey": "sugar",
      "amount": 120,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "蛋黄",
      "mergeKey": "egg-yolk",
      "amount": 48,
      "unit": "克",
      "category": "蛋类"
    },
    {
      "name": "低粉",
      "mergeKey": "flour",
      "amount": 360,
      "unit": "克",
      "category": "米面主食"
    },
    {
      "name": "盐",
      "mergeKey": "salt",
      "quantityText": "少许",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "香草精",
      "mergeKey": "vanilla-extract",
      "quantityText": "少许",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "黄油切丁放入干净的盆子里室温软化后（能轻易的用手戳出一个小洞的程度）搅打均匀，再加糖粉搅打均匀,"
    },
    {
      "text": "分次加入蛋黄液搅打均匀,"
    },
    {
      "text": "加入几滴香草精搅打均匀,"
    },
    {
      "text": "加入过筛的低粉和盐拌匀成黄油面团后，分块压扁裹入保鲜膜或保鲜袋放冰箱冷藏30分钟,"
    },
    {
      "text": "将变硬的面团在案板上洒许高筋粉（防止粘牢，中筋粉也可以），擀成3毫米左右厚的薄片，（面团要擀的很均匀），用饼干模压成型后，移入放好油纸或锡纸的烤盘,"
    },
    {
      "text": "将饼干放入180度预热的烤箱，中层烤10分钟，边缘上色即可（这步很重要，一定要呆在旁边自己观察，看到饼干边有点变黄变焦就可以了），过头很容易烤焦哦"
    }
  ],
