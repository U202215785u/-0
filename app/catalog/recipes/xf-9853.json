  "steps": [
    {
      "text": "奶酪加牛奶隔温水搅打均匀成无颗粒的液体,"
    },
    {
      "text": "蛋白分次加糖打至湿性发泡,"
    },
    {
      "text": "蛋黄加糖打至浓稠状,"
    },
    {
      "text": "分次加入色拉油，每次加入后都要搅打均匀,"
    },
    {
      "text": "将蛋黄糊和奶酪糊搅拌均匀,"
    },
    {
      "text": "将低粉和盐的混合物过筛两次后加入蛋黄糊中,"
    },
    {
      "text": "用橡皮刮刀将粉翻拌均匀,"
    },
    {
      "text": "将蛋白糊和蛋黄糊分次翻拌均匀倒入模中"
    }
  ],
