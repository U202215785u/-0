  "title": "咖哩牛腩",
  "ingredients": [
    {
      "name": "牛腩",
      "mergeKey": "beef-brisket",
      "category": "肉类"
    },
    {
      "name": "胡萝卜",
      "mergeKey": "carrot",
      "category": "蔬菜"
    },
    {
      "name": "土豆",
      "mergeKey": "potato",
