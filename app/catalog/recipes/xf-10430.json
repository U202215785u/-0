  "steps": [
    {
      "text": "茶干、风肉切片，芹菜切段，黑木耳切小，红椒和葱切细备用,"
    },
    {
      "text": "砂锅里面放上大部分芹菜,"
    },
    {
      "text": "起油锅把风肉煸炒一下倒入茶干和木耳翻炒一下，一起倒入砂锅,"
    },
    {
      "text": "砂锅里面放上酱油、糖和少量的耗油一起大火开后转小火焖10-15分钟，加入红椒和葱和一点味精就可以了"
    }
  ],
