  "steps": [
    {
      "text": "消化饼擀成细粉状,"
    },
    {
      "text": "加入融化的黄油,"
    },
    {
      "text": "搅拌均匀即为饼底,"
    },
    {
      "text": "将饼底压入模具底部，用力压紧,"
    },
    {
      "text": "量取适量椰浆,"
    },
    {
      "text": "将椰浆放入锅内，小火加热,"
    },
    {
      "text": "此时冰水泡软吉列丁片，挤干水分备用,"
    },
    {
      "text": "将吉列丁片放入椰浆中，小火继续加热搅拌至融化,"
    },
    {
      "text": "加入青柠朗姆酒，拌匀后，离火,"
    },
    {
      "text": "芝士室温放软，加入白砂糖搅打至均匀的糊状,"
    },
    {
      "text": "1"
    },
    {
      "text": "将椰浆混合液倒入芝士中,"
    },
    {
      "text": "1"
    },
    {
      "text": "隔热水搅拌成均匀无颗粒的糊状,"
    },
    {
      "text": "1"
    },
    {
      "text": "加入朗姆酒，拌匀,"
    },
    {
      "text": "1"
    },
    {
      "text": "加入2滴天然蓝色素拌匀即为芝士糊，晾至室温备用,"
    },
    {
      "text": "1"
    },
    {
      "text": "淡奶油打发，加入14的芝士糊中，混合均匀,"
    },
    {
      "text": "1"
    },
    {
      "text": "倒入模具内，冷藏3小时以上至凝固,"
    },
    {
      "text": "1"
    },
    {
      "text": "食用前脱模，用融化的黑巧勾出轮廓,"
    },
    {
      "text": "1"
    },
    {
      "text": "填充彩色奶油或镜面水即可（或用明胶水做法：明胶粉加水搅拌均匀，小火加热至明胶融化，晾凉调色即可），周围撒上消化饼碎及椰蓉"
    }
  ],
