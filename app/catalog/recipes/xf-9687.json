  "steps": [
    {
      "text": "锅内放少许油，加葱姜蒜粒爆香,"
    },
    {
      "text": "下辣白菜翻炒，加足量水，沸腾后加入咖喱块融化,"
    },
    {
      "text": "加适量生抽、料酒、糖调味,"
    },
    {
      "text": "沸腾后，加喜欢的食材煮炖即可"
    }
