{
  "id": "egg-fried-rice",
  "title": "蛋炒饭",
  "ingredients": [
    { "name": "冷白米饭（煮熟冷藏）", "amount": 400.0, "unit": "克", "category": "米面主食", "pantry": false, "mergeKey": "cooked-rice" },
    { "name": "鸡蛋", "amount": 2.0, "unit": "个", "category": "蛋类", "pantry": false, "mergeKey": "egg" },
    { "name": "食用油（味道中性）", "amount": 22.5, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "cooking-oil" },
    { "name": "大蒜（切末）", "amount": 2.0, "unit": "瓣", "category": "蔬菜", "pantry": false, "mergeKey": "garlic" },
    { "name": "小葱（切碎）", "amount": 1.0, "unit": "根", "category": "蔬菜", "pantry": false, "mergeKey": "green-onion" },
    { "name": "生抽", "amount": 5.0, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "soy-sauce" },
    { "name": "香油", "amount": 2.5, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "sesame-oil" },
    { "name": "盐", "amount": 1.25, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "salt" },
    { "name": "白胡椒粉", "amount": 1.0, "unit": "撮", "category": "调味料", "pantry": true, "mergeKey": "white-pepper" }
