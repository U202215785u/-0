  "title": "芦笋百合扇贝",
  "ingredients": [
    {
      "name": "冰冻小扇贝",
      "mergeKey": "scallop",
      "category": "水产"
    },
    {
      "name": "芦笋",
      "mergeKey": "asparagus",
      "category": "蔬菜"
    },
    {
      "name": "百合",
      "mergeKey": "lily",
