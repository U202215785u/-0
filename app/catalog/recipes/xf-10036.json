  "steps": [
    {
      "text": "黄瓜，胡萝卜切粒。金枪鱼，玉米粒沥干水分，所有材料混合挤入沙拉酱拌匀,"
    },
    {
      "text": "取一片土司，上面铺上拌好的沙拉,"
    },
    {
      "text": "再在上面盖上一片土司,"
    },
    {
      "text": "三明治制作器放上面，压下,"
    },
    {
      "text": "对角切开"
    }
  ],
