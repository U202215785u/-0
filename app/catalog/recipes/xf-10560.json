  "steps": [
    {
      "text": "锅内放入细砂糖，小火加热,"
    },
    {
      "text": "至琥珀色时，立即关火，小心加入水、葡萄干,"
    },
    {
      "text": "继续开小火煮至沸腾，关火，盛出，即为焦糖葡萄干,"
    },
    {
      "text": "室温软化黄油，加入细砂糖，搅拌至羽毛状,"
    },
    {
      "text": "分3次加入蛋液，每次都要拌匀再加下一次,"
    },
    {
      "text": "低粉、奶粉、泡打粉混合过筛，加入5中，切拌至无干粉粒,"
    },
    {
      "text": "取1/2的焦糖葡萄干加入面糊中，拌匀,"
    },
    {
      "text": "将面糊装入裱花袋,"
    },
    {
      "text": "挤入纸杯中五分满，撒上剩余的焦糖葡萄干，放入预热190度的烤箱，烤制20~25分钟即可"
    }
  ],
