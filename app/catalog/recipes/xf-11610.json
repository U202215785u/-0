      "pantry": true
    },
    {
      "name": "色拉油",
      "mergeKey": "cooking-oil",
      "amount": 40,
      "unit": "毫升",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "牛奶",
      "mergeKey": "milk",
      "amount": 30,
      "unit": "毫升",
      "category": "乳制品"
    },
    {
      "name": "几滴香草精",
      "mergeKey": "vanilla-extract",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "牛奶+油+糖15克搅打成稀糊状,"
    },
    {
      "text": "加入南瓜泥搅拌均匀,"
    },
    {
      "text": "加入过筛两次的低粉，拌至无干粉,"
    },
    {
      "text": "分两次加入蛋黄，拌至顺滑,"
    },
    {
      "text": "拌好的南瓜蛋黄糊,"
    },
    {
      "text": "烤盘铺好油纸，均匀撒上蜜红豆,"
    },
    {
      "text": "蛋白分三次加入45克糖打到湿性发泡,"
    },
    {
      "text": "取三分之一蛋白拌入蛋黄糊里。再倒回蛋白盆里，用刮刀翻拌均匀,"
    },
    {
      "text": "拌好的面糊倒入烤盘中，以刮刀抹平,"
    },
    {
      "text": "度，中层，上下火22分钟左右。出炉后立即把底面朝上，撕掉油纸,"
    },
    {
      "text": "1"
    },
    {
      "text": "再把正面朝上，放在烤网上晾凉,"
    },
    {
      "text": "1"
    },
    {
      "text": "凉透的蛋糕再翻面，在下面铺油纸。蛋糕涂上打发好的奶油，外边缘留一部分不涂。我这个用的是打发的法式白脱奶油,"
    },
    {
      "text": "1"
    },
    {
      "text": "以擀面杖把底纸向后卷，同时把蛋糕片向前推着卷起。用纸包着放冰箱冷藏30分钟左右，取出"
    }
  ],
