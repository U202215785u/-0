  "title": "花胶鹿筋煲",
  "ingredients": [
    {
      "name": "花胶",
      "mergeKey": "fish-maw",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "鹿筋",
      "mergeKey": "deer-tendon",
