  "steps": [
    {
      "text": "将牛肉用腌肉调料拌匀，腌制20分钟,"
    },
    {
      "text": "锅内油烧至4成热，下入牛肉炒至7分熟捞起备用,"
    },
    {
      "text": "锅内烧开水，放入草菇略烫，捞起沥净水,"
    },
    {
      "text": "锅内冷油，放入姜，蒜蓉，葱白碎爆香,"
    },
    {
      "text": "加入烫过的草菇，蚝油，盐，鸡精略炒,"
    },
    {
      "text": "加入炒好的牛肉，再翻炒至牛肉10分熟时即可"
    }
  ],
