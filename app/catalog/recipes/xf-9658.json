  "title": "沙茶尖椒牛柳",
  "ingredients": [
    {
      "name": "牛里脊肉",
      "mergeKey": "beef-tenderloin",
      "category": "肉类"
    },
    {
      "name": "沙茶酱",
      "mergeKey": "shacha-sauce",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "小尖椒",
      "mergeKey": "chili-pepper",
      "category": "蔬菜"
    },
    {
      "name": "老抽",
      "mergeKey": "dark-soy-sauce",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "白糖",
      "mergeKey": "sugar",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "生粉",
      "mergeKey": "cornstarch",
