  "steps": [
    {
      "text": "去骨刺鱼肉切丝，用盐、料酒、白胡椒粉、淀粉拌匀腌制，韭黄切段，青红椒切丝,"
    },
    {
      "text": "锅烧热，倒油，下入鱼丝，用筷子划散，鱼肉变色时盛起备用,"
    },
    {
      "text": "锅中留底油，放入韭黄段，青红椒丝稍炒几秒钟时放少许盐和鸡精,"
    },
    {
      "text": "倒入鱼丝翻炒均匀即可起锅"
    }
  ],
