{
  "id": "xf-10444",
  "title": "杏仁银耳煲猪腱",
  "ingredients": [
    {
      "name": "猪腱子肉",
      "mergeKey": "pork",
      "amount": 500,
      "unit": "克",
      "category": "肉类"
    },
    {
      "name": "南杏仁",
      "mergeKey": "apricot-kernel",
      "amount": 20,
      "unit": "克",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "北杏仁",
      "mergeKey": "bitter-apricot-kernel",
      "amount": 10,
      "unit": "克",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "银耳",
      "mergeKey": "tremella",
      "amount": 10,
      "unit": "克",
