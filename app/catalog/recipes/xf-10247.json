  "steps": [
    {
      "text": "鸡翅清洗干净，每只斩成2块；香芋削皮，切成方块；姜、蒜切片,"
    },
    {
      "text": "鸡翅中加入姜片、蒜片、盐焗鸡粉5毫升、酒5毫升、生抽10毫升、白糖5毫升,"
    },
    {
      "text": "腌20分钟入味,"
    },
    {
      "text": "锅里放多一点油，烧热，把沥干水分的芋头放进去，中火煎至金黄,"
    },
    {
      "text": "翻面后继续煎至两面金黄,"
    },
    {
      "text": "加入鸡翅、姜、蒜片,"
    },
    {
      "text": "把材料尽量平铺在锅上，稍煎一下，翻炒均匀,"
    },
    {
      "text": "把所有材料盛进砂锅，倒进刚才腌鸡翅的腌料，加入150毫升清水,"
    },
    {
      "text": "大火煮开后，转中小火煮10~12分钟，撒上葱花即可"
    }
  ],
