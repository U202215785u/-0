  "steps": [
    {
      "text": "鸡翅洗净擦干表面水分，用刀在鸡翅上横切几刀，方便入味,"
    },
    {
      "text": "把鸡翅放进容器中，放姜丝，葱段和一汤匙料酒，然后加一大勺豆瓣酱,"
    },
    {
      "text": "所有材料拌匀，腌制,"
    },
    {
      "text": "～1个小时,"
    },
    {
      "text": "烧开锅中水，把腌制好的鸡翅放入大火蒸10分钟左右即可"
    }
  ],
