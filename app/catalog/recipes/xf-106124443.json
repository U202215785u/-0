  "steps": [
    {
      "text": "肉切丝备用"
    },
    {
      "text": "芹菜洗干净切段备用，姜切末"
    },
    {
      "text": "锅里倒入适量油，放姜爆香"
    },
    {
      "text": "加入肉丝翻炒加点料酒去腥"
    },
    {
      "text": "炒到有点微黄下芹菜"
    },
    {
      "text": "翻炒一分钟左右"
    },
    {
      "text": "加入耗油生抽和盐调味"
    },
    {
      "text": "翻炒均匀即可出锅"
    },
    {
      "text": "装盘"
    }
  ],
