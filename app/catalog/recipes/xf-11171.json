  "steps": [
    {
      "text": "将日月贝洗净从壳中取出、用盐、胡椒粉、绍酒腌渍,"
    },
    {
      "text": "韩国泡菜切小块,"
    },
    {
      "text": "香葱切末将其他原料准备好,"
    },
    {
      "text": "打好的鸡蛋液加入面粉、玉米粉和盐后，搅拌均匀，打成糊待用,"
    },
    {
      "text": "把泡菜和其他辅料放入和好的面粉团中,"
    },
    {
      "text": "轻轻搅拌均匀待用,"
    },
    {
      "text": "电饼铛烧热后放入油，也可以用煎锅,"
    },
    {
      "text": "把和好的面糊用勺子盛入饼铛,"
    },
    {
      "text": "再将腌渍好的日月贝放在面糊上撒上香葱,"
    },
    {
      "text": "两面煎熟即可"
    }
  ],
