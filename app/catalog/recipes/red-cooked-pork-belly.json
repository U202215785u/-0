  "steps": [
    { "text": "五花肉切成二至三厘米见方的块，放入锅中加水煮至沸腾。", "ingredientNames": ["五花肉"] },
    { "text": "水煮沸后撇去浮沫，捞出沥水，用冷水冲洗干净。", "ingredientNames": ["五花肉"] },
    { "text": "锅中倒入绍兴黄酒和热水（水量以刚没过肉为宜），加入生抽、老抽、姜、八角和香叶。", "ingredientNames": ["绍兴黄酒", "生抽", "老抽", "姜", "八角", "香叶"] },
    { "text": "大火将汤汁煮至完全沸腾，盖上锅盖转小火慢炖一至一个半小时，直到肉用叉子可轻松戳透。", "timerSeconds": 3600, "ingredientNames": ["五花肉"] },
    { "text": "开盖加入冰糖，转大火让汤汁猛烈沸腾收汁，期间不时搅拌，直到汤汁收至刚好能盖住锅底。", "ingredientNames": ["冰糖"] }
  ],
  "baseServings": 4,
