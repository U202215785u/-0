  "steps": [
    {
      "text": "将紫薯切小叮,"
    },
    {
      "text": "将泰国米饭、木薯粉、盐、糖和椰浆一起搅拌均匀，成米浆状,"
    },
    {
      "text": "将拌混好的原料一起倒入模具中,"
    },
    {
      "text": "放入蒸笼用大火蒸15分钟,"
    },
    {
      "text": "待碗中的蒸糕凝固后，放上椰丝，改中火继续蒸3分钟；取出放凉，冷藏后食用即可"
    }
  ],
