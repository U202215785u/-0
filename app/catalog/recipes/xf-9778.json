{
  "id": "xf-9778",
  "title": "东北大乱炖",
  "ingredients": [
    {
      "name": "五花肉",
      "mergeKey": "pork-belly",
      "category": "肉类"
    },
    {
      "name": "四季豆",
      "mergeKey": "green-bean",
      "category": "蔬菜"
    },
    {
      "name": "胡萝卜",
      "mergeKey": "carrot",
      "category": "蔬菜"
    },
    {
      "name": "黄豆酱",
      "mergeKey": "soybean-paste",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "将五花肉切块，放入冷水中，煮沸后略煮一会，捞出洗净,"
    },
    {
      "text": "四季豆切长段，胡萝卜切滚刀块备用,"
    },
    {
      "text": "焯好水的五花肉重新倒回锅中，将黄豆酱加清水稀释后加入（水量已没过肉即可），大火煮开后，转小火炖40分钟左右，然后放入四季豆和胡萝卜，再炖15-20分钟即可"
    }
  ],
