  "steps": [
    {
      "text": "原料：新鲜鲑鱼800克、枸杞一把、姜丝、葱丝、蒜，黄酒2勺，盐5克,"
    },
    {
      "text": "用刀在鱼的背部划3道，用姜、葱、黄酒、蒜片、盐、枸杞，涂抹均匀,"
    },
    {
      "text": "蒸锅水烧开后，连盘放入。大火蒸20分钟,"
    },
    {
      "text": "关火后闷5分钟再开盖就可以了。鱼肉汁鲜嫩，口味清淡，很鲜美"
    }
  ],
