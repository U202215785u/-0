{
  "id": "xf-11328",
  "title": "发面蒸葱饼",
  "ingredients": [
    {
      "name": "中筋面粉",
      "mergeKey": "flour",
      "amount": 300,
      "unit": "克",
      "category": "米面主食"
    },
    {
      "name": "/3小勺约3克盐",
      "mergeKey": "salt",
      "amount": 3,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "3克酵母",
      "mergeKey": "yeast",
      "amount": 1,
      "unit": "小勺",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "葱花",
      "mergeKey": "scallion",
      "amount": 30,
      "unit": "克",
      "category": "蔬菜"
    },
    {
      "name": "水",
      "mergeKey": "water",
      "amount": 150,
      "unit": "毫升",
      "category": "其他"
    },
    {
      "name": "猪油",
      "mergeKey": "lard",
      "quantityText": "适量",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "把所有材料放在一起，揉成面团,"
    },
    {
      "text": "揉好的面团放在盆里盖保鲜膜发酵至两倍大,"
    },
    {
      "text": "发酵好之后在案板上揉出空气，分割成三个面团。盖上保鲜膜松弛十分钟,"
    },
    {
      "text": "擀开，呈长方形（向四个角擀开，容易成长方型,"
    },
    {
      "text": "翻面，涂上猪油（色拉油，熟鸭油也行,"
    },
    {
      "text": "折成三折,"
    },
    {
      "text": "用擀面杖再稍稍压平,"
    },
    {
      "text": "摆入涂了油的蒸帘上。盖上盖子静置20分钟,"
    },
    {
      "text": "凉水开蒸，10分钟后关火，关火后三分钟再开盖。吃的时候可切成小块"
    }
  ],
