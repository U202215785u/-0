  "steps": [
    {
      "text": "蔓越莓切小丁,"
    },
    {
      "text": "撒上少许干粉，抓匀,"
    },
    {
      "text": "筛去多余面粉，备用,"
    },
    {
      "text": "植物油+水，搅拌成米汤状,"
    },
    {
      "text": "加入30克糖、盐，搅拌均匀,"
    },
    {
      "text": "筛入低粉，稍加搅拌至无干粉粒,"
    },
    {
      "text": "逐个加入蛋黄，改用刮刀切拌,"
    },
    {
      "text": "切拌拌匀后即为蛋黄面糊,"
    },
    {
      "text": "蛋白用手动打蛋器打出大泡，加入20克白砂糖,"
    },
    {
      "text": "继续搅打至出现细泡，再加入20克白砂糖,"
    },
    {
      "text": "1"
    },
    {
      "text": "继续搅打至细腻，加入剩下的20克白砂糖,"
    },
    {
      "text": "1"
    },
    {
      "text": "持续手动搅打，直至打蛋器取出时出现小弯钩（即7~8分发），即为蛋白霜,"
    },
    {
      "text": "1"
    },
    {
      "text": "将蛋白霜分三次加入蛋黄糊中，切拌均匀,"
    },
    {
      "text": "1"
    },
    {
      "text": "加入裹干粉的蔓越莓丁，稍加搅拌,"
    },
    {
      "text": "1"
    },
    {
      "text": "倒入铺油纸的方形模，轻磕几下，放入预热180度的烤箱，20~25分钟,"
    },
    {
      "text": "1"
    },
    {
      "text": "蛋糕出炉后倒扣放凉至温热,"
    },
    {
      "text": "1"
    },
    {
      "text": "横剖开成2片,"
    },
    {
      "text": "1"
    },
    {
      "text": "热水+糖拌匀至糖融化，稍凉后加入朗姆酒，拌匀,"
    },
    {
      "text": "1"
    },
    {
      "text": "将糖酒液均匀刷在蛋糕片表面,"
    },
    {
      "text": "1"
    },
    {
      "text": "卷起，包保鲜膜放入冰箱冷藏20分钟,"
    },
    {
      "text": "2"
    },
    {
      "text": "取出，切除两边，将1小块蛋糕卷放在上端,"
    },
    {
      "text": "2"
    },
    {
      "text": "淡奶油打发，加入巧克力酱拌匀，即为巧克力奶油,"
    },
    {
      "text": "2"
    },
    {
      "text": "将巧克力奶油抹在蛋糕表面，用融化的黑巧画出树轮,"
    },
    {
      "text": "2"
    },
    {
      "text": "装饰草莓及草莓小雪人，即可"
    }
  ],
