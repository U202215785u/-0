  "steps": [
    {
      "text": "四季豆，香菇，胡萝卜，土豆，米饭,"
    },
    {
      "text": "将材料分别切成小丁,"
    },
    {
      "text": "锅内热油，放入土豆，胡萝卜丁炒至熟,"
    },
    {
      "text": "加入香菇丁及四季豆丁，加入盐，炒至熟,"
    },
    {
      "text": "加入白米饭翻炒均匀,"
    },
    {
      "text": "最后加入生抽即可出锅"
    }
