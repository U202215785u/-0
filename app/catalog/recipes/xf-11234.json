  "steps": [
    {
      "text": "排骨500克，切成5厘米长的段，洗净沥干,"
    },
    {
      "text": "烧热锅子，下橄榄油，以小火把排骨煎至两面微焦,"
    },
    {
      "text": "加入冰糖、葱姜、豆腐乳和腐乳汁、八角、米酒，翻炒一分钟，至糖化开，上色均匀,"
    },
    {
      "text": "加入一小碗水或高汤，大火烧开转小火，炖煮20分钟左右,"
    },
    {
      "text": "煮至汤汁浓稠（最后可以用大火收一下汁,"
    },
    {
      "text": "倒入洗净沥干的豌豆苗，迅速翻炒3钞钟关火，以余温继续炒至豆苗软身。起锅，装盘"
    }
  ],
