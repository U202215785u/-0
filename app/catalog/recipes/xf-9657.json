    },
    {
      "name": "蒜",
      "mergeKey": "garlic",
      "amount": 25,
      "unit": "克",
      "category": "蔬菜"
    },
    {
      "name": "色拉油",
      "mergeKey": "cooking-oil",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "盐",
      "mergeKey": "salt",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "鸡精",
      "mergeKey": "chicken-powder",
      "category": "调味料",
      "pantry": true
    },
    {
