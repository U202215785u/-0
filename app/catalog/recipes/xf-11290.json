    },
    {
      "name": "红辣椒",
      "mergeKey": "red-chili",
      "category": "蔬菜"
    },
    {
      "name": "小葱",
      "mergeKey": "scallion",
      "category": "蔬菜"
    },
    {
      "name": "盐",
      "mergeKey": "salt",
