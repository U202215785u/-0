  "title": "腐竹炒木耳",
  "ingredients": [
    {
      "name": "水发黑木耳",
      "mergeKey": "wood-ear",
      "category": "菌菇",
      "pantry": false,
      "amount": 3,
      "unit": "朵"
    },
    {
      "name": "腐竹",
      "mergeKey": "tofu-skin",
      "category": "豆制品",
      "pantry": true,
      "quantityText": "3-4根"
    },
    {
      "name": "青蒜",
      "mergeKey": "garlic-sprout",
      "category": "蔬菜",
      "pantry": false,
      "amount": 1,
      "unit": "根"
    },
    {
      "name": "芹菜",
      "mergeKey": "celery",
      "category": "蔬菜",
