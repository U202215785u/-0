  "steps": [
    {
      "text": "锅内热油，放入猪绞肉小火煸炒,"
    },
    {
      "text": "至猪肉出油脂时，放入姜、蒜、葱花、泡椒炒香,"
    },
    {
      "text": "注入清水或高汤半杯,"
    },
    {
      "text": "加入所有调味料，及切块豆腐,"
    },
    {
      "text": "中火煮开后，转小火煮至汤汁快收干时，加入水淀粉,"
    },
    {
      "text": "至汤汁浓稠时洒上葱花即可"
    }
  ],
