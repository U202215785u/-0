      "pantry": true
    },
    {
      "name": "料酒",
      "mergeKey": "cooking-wine",
      "amount": 15,
      "unit": "毫升",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "生抽",
      "mergeKey": "soy-sauce",
      "amount": 7.5,
      "unit": "毫升",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "白糖",
      "mergeKey": "sugar",
      "quantityText": "一点点",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "鸡精",
      "mergeKey": "chicken-powder",
      "quantityText": "一点",
      "category": "调味料",
