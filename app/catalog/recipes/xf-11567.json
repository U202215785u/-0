  "title": "蚝油杏鲍菇",
  "ingredients": [
    {
      "name": "杏鲍菇",
      "mergeKey": "king-oyster-mushroom",
      "category": "菌菇"
    },
    {
      "name": "蚝油",
      "mergeKey": "oyster-sauce",
      "amount": 15,
      "unit": "毫升",
