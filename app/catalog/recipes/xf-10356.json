  "title": "朗姆酒芝士焗虾",
  "ingredients": [
    {
      "name": "马苏里拉芝士",
      "mergeKey": "mozzarella",
      "category": "乳制品"
    },
    {
      "name": "大对虾",
      "mergeKey": "shrimp",
      "category": "水产"
    },
    {
      "name": "朗姆酒",
      "mergeKey": "rum",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "盐",
      "mergeKey": "salt",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "白胡椒粉",
      "mergeKey": "white-pepper",
      "category": "调味料",
