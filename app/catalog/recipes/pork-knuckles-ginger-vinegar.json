  "steps": [
    {
      "text": "姜可去皮或保留外皮；若保留外皮，彻底刷洗后切片。猪脚剁块。",
      "ingredientNames": [
        "姜",
        "猪脚"
      ]
    },
    {
      "text": "猪脚冷水下锅焯水，去除浮沫和杂质后捞出洗净。",
      "ingredientNames": [
        "猪脚"
      ]
    },
    {
      "text": "无油中火炒锅放入姜片，翻动烘香约5分钟，至颜色变深、边缘微焦。",
      "ingredientNames": [
        "姜"
      ]
    },
    {
      "text": "加入甜黑醋，中火搅匀；放入猪脚、镇江香醋、冰糖和食盐，煮沸后转小火慢炖。",
      "ingredientNames": [
        "甜黑醋",
        "猪脚",
        "镇江香醋",
        "冰糖",
        "食盐"
      ]
    },
    {
      "text": "鸡蛋另锅煮熟、剥壳，加入醋汁中继续炖煮，直至猪脚软烂、鸡蛋入味。砂锅或其他非反应性锅具均可使用。",
      "ingredientNames": [
        "鸡蛋",
        "猪脚",
        "甜黑醋"
      ]
    }
  ],
  "baseServings": 10,
