  "steps": [
    {
      "text": "鸡胸洗净，去筋膜，切"
    },
    {
      "text": "5厘米见方的小块，用盐，料酒，胡椒碎，蒜泥拌匀腌制10分钟；鸡蛋打碎,"
    },
    {
      "text": "腌制好的鸡肉拍一层生粉,"
    },
    {
      "text": "沾蛋液,"
    },
    {
      "text": "最外层沾一层面包糠,"
    },
    {
      "text": "锅内烧热油放入鸡块炸熟，捞出,"
    },
    {
      "text": "油再次烧热复炸至表面酥脆金黄即可"
    }
  ],
