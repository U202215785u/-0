  "steps": [
    {
      "text": "黄油室温软化后，加入糖粉打至松发,"
    },
    {
      "text": "加入一个蛋黄，用打蛋器搅打均匀,"
    },
    {
      "text": "再加入第二个蛋黄，用打蛋器搅打均匀。（此时烤箱180℃预热,"
    },
    {
      "text": "所有粉类（ 低筋面粉、玉米淀粉、吉士粉、奶粉、泡打粉）混合拌匀，过筛加入,"
    },
    {
      "text": "用橡皮刮刀切拌均匀成面团,"
    },
    {
      "text": "取一小块搓成小圆球，码在铺了油布的烤盘中。入预热好的烤箱，烤10分钟左右至表面上色即可"
    }
  ],
