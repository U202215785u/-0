{
  "id": "xf-11481",
  "title": "韭菜春笋炒蛏子",
  "ingredients": [
    {
      "name": "新鲜蛏子",
      "mergeKey": "razor-clam",
      "quantityText": "少许",
      "category": "水产"
    },
    {
      "name": "韭菜",
      "mergeKey": "chives",
      "category": "蔬菜"
    },
    {
      "name": "春笋",
      "mergeKey": "bamboo-shoot",
