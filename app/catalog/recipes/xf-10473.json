{
  "id": "xf-10473",
  "title": "香浓奶香玉米汁",
  "ingredients": [
    {
      "name": "三花淡奶",
      "mergeKey": "evaporated-milk",
      "amount": 10,
      "unit": "毫升",
      "category": "乳制品"
    },
    {
      "name": "甜玉米",
      "mergeKey": "corn",
      "amount": 3,
      "unit": "个",
      "category": "蔬菜"
    },
    {
      "name": "清水",
      "mergeKey": "water",
      "amount": 500,
      "unit": "毫升",
      "category": "其他"
    },
    {
      "name": "白糖",
      "mergeKey": "sugar",
      "amount": 50,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "将甜玉米去皮洗净后，用刀顺着玉米棒子，将玉米粒切下来,"
    },
    {
      "text": "把倒入玉米粒倒入锅中，再倒入清水，大火煮开后，撇掉浮沫，改成中小火煮10分钟左右,"
    },
    {
      "text": "将玉米和汤，一起倒入搅拌机中（1次倒不下就分成2次），搅拌至呈茸状,"
    },
    {
      "text": "将打好的玉米茸过筛，用勺子按压漏网中的玉米茸，使玉米汁尽量多的过滤出来,"
    },
    {
      "text": "最后在玉米汁里加入白糖，三花淡奶搅匀即可"
    }
  ],
