  "steps": [
    {
      "text": "用刀贴着翅根没肉的那头把肉皮往肉多的那头刮，露出骨头棒，形成捶子样，并用牙签在肉上扎些小洞，让腌料渗进去,"
    },
    {
      "text": "将腌料汁和鸡翅根放入碗中，搅抖均匀腌制2小时，中途给它们按摩、翻动，青红椒切粒备用,"
    },
    {
      "text": "将腌好的翅根上的干辣椒段，大葱片，姜片摘下，均匀地给翅根拍上一层簿生粉,"
    },
    {
      "text": "锅中倒油，烧热，开中小火，放入翅根炸,"
    },
    {
      "text": "炸至呈金黄色时，捞出鸡翅，将锅中的油倒出,"
    },
    {
      "text": "锅中放少许油，放入放鸡翅根,"
    },
    {
      "text": "撒上孜然粉、花椒粉、辣椒粉、白芝麻翻炒均匀即可"
    }
  ],
