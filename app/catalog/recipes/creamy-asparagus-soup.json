  "steps": [
    {
      "text": "厚底锅中火融化无盐黄油，加入切薄片的红葱头，翻炒约5分钟至变软。",
      "ingredientNames": [
        "无盐黄油",
        "红葱头"
      ]
    },
    {
      "text": "加入切成约5厘米段的芦笋、食盐和芫荽粉，翻炒1分钟；倒入蔬菜高汤，压下芦笋使其大部分浸没。煮沸后转小火，常搅拌煮8至10分钟至芦笋变软，稍微放凉。",
      "ingredientNames": [
        "芦笋",
        "食盐",
        "芫荽粉",
        "低钠蔬菜高汤"
      ]
    },
    {
      "text": "分批用搅拌机将汤打至非常顺滑，倒回锅中，加入1杯清水，用黑胡椒和食盐调味，小火保温。",
      "ingredientNames": [
        "黑胡椒",
        "食盐"
      ]
    },
    {
      "text": "小碗中混合鲜奶油奶酪、柠檬皮屑、柠檬汁和少量食盐。",
      "ingredientNames": [
        "鲜奶油奶酪",
        "柠檬皮屑",
        "柠檬汁",
        "食盐"
      ]
    },
    {
      "text": "汤盛入碗中，放一勺柠檬奶油，淋特级初榨橄榄油，撒黑胡椒。",
      "ingredientNames": [
        "鲜奶油奶酪",
        "柠檬皮屑",
        "柠檬汁",
        "特级初榨橄榄油",
        "黑胡椒"
      ]
    }
  ],
  "baseServings": 6,
