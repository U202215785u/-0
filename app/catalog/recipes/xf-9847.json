  "steps": [
    {
      "text": "黄油室温放置软化,"
    },
    {
      "text": "加入糖粉快速搅打至羽毛状,"
    },
    {
      "text": "分次加入蛋白，搅打至完全混合,"
    },
    {
      "text": "筛入低粉、泡打粉、玉米淀粉的混合粉类,"
    },
    {
      "text": "以不规则方式切拌成团，包保鲜膜静置30分钟,"
    },
    {
      "text": "取出适量手指饼干,"
    },
    {
      "text": "将静置好的面团平均分成若干小球,"
    },
    {
      "text": "用手指饼干在小面团上压出直径相同的洞,"
    },
    {
      "text": "洞口朝下排入烤盘，放入预热150度的烤箱20分钟，再余温焖5分钟,"
    },
    {
      "text": "隔水融化黑巧克力,"
    },
    {
      "text": "1"
    },
    {
      "text": "用融化的黑巧克力将饼干球和手指饼干粘合，并在表层涂上适量巧克力,"
    },
    {
      "text": "1"
    },
    {
      "text": "撒上彩珠糖，用巧克力画出眉眼即可：）"
    }
  ],
