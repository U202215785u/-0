  "steps": [
    {
      "text": "鸡腿肉解冻切成小块，放入老抽，生抽，盐，淀粉，味精，鸡精，料酒。充分按摩后静置20分钟左右"
    },
    {
      "text": "葱姜蒜切好"
    },
    {
      "text": "锅内放入油加热后，放入葱姜蒜炒香"
    },
    {
      "text": "放入腌制好的鸡腿肉，翻炒均匀。"
    },
    {
      "text": "放入青椒炒一会儿"
    },
    {
      "text": "炒好装盘就ok啦～"
    }
  ],
