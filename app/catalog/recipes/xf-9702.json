  "title": "微波鸡肉串",
  "ingredients": [
    {
      "name": "鸡脯肉",
      "mergeKey": "chicken-breast",
      "category": "肉类"
    },
    {
      "name": "炸鸡粉",
      "mergeKey": "frying-powder",
