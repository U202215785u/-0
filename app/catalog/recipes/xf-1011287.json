  "steps": [
    {
      "text": "尖椒洗净，切丝"
    },
    {
      "text": "猪肉，切丝"
    },
    {
      "text": "葱花姜丝准备好"
    },
    {
      "text": "热锅入油，放入葱姜爆锅，然后放切好的肉丝"
    },
    {
      "text": "加蚝油、生抽和一点点酱油，快速翻炒使肉丝入味"
    },
    {
      "text": "放尖椒进去，翻炒"
    },
    {
      "text": "加盐，出锅"
    }
