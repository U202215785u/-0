  "steps": [
    {
      "text": "三文鱼切成长度相等的块，擦干表面。",
      "ingredientNames": [
        "三文鱼"
      ]
    },
    {
      "text": "两面均匀撒蒜盐和白胡椒粉，静置几分钟。",
      "ingredientNames": [
        "三文鱼",
        "蒜盐",
        "白胡椒粉"
      ]
    },
    {
      "text": "玉米淀粉铺在盘中，三文鱼肉面、皮面及四边轻薄裹粉。",
      "ingredientNames": [
        "三文鱼",
        "玉米淀粉"
      ]
    },
    {
      "text": "锅烧热加食用油，三文鱼皮面朝下煎约2分钟，肉面煎约3分钟，再煎四边各约30秒；表面金黄、内部达到需要的熟度后出锅，淋料酒。",
      "ingredientNames": [
        "食用油",
        "三文鱼",
        "料酒"
      ]
    }
  ],
  "baseServings": 4,
