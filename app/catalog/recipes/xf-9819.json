{
  "id": "xf-9819",
  "title": "果酱小饼干",
  "ingredients": [
    {
      "name": "无盐黄油",
      "mergeKey": "unsalted-butter",
      "amount": 150,
      "unit": "克",
      "category": "乳制品"
    },
    {
      "name": "低筋面粉",
      "mergeKey": "cake-flour",
      "amount": 300,
      "unit": "克",
      "category": "米面主食"
    },
    {
      "name": "盐",
      "mergeKey": "salt",
      "amount": 1,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "糖粉",
      "mergeKey": "icing-sugar",
      "amount": 100,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "全蛋",
      "mergeKey": "egg",
      "amount": 45,
      "unit": "克",
      "category": "蛋类"
    },
    {
      "name": "牛奶",
      "mergeKey": "milk",
      "amount": 50,
      "unit": "毫升",
      "category": "乳制品"
    }
  ],
  "steps": [
    {
      "text": "黄油温室软化，加糖粉打发，分次加入蛋液打发，分次加入牛奶打发,"
    },
    {
      "text": "加入过筛盐和低粉拌成面团，入冰箱冷藏30分,"
    },
    {
      "text": "取出擀平，用摸压出形状，在另外一片饼干上压出空心，平的一面刷上蛋液，把另外空心放上，挤入果酱，烤箱预热180度,"
    },
    {
      "text": "入烤箱上下火180度烤约15-20分，（温度尽供参考）"
    }
  ],
