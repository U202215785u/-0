  "title": "黄金杏鲍菇",
  "ingredients": [
    {
      "name": "杏鲍菇",
      "mergeKey": "king-oyster",
      "category": "菌菇"
    },
    {
      "name": "咸蛋黄",
      "mergeKey": "salted-egg-yolk",
      "category": "蛋类"
    },
    {
      "name": "鸡蛋",
      "mergeKey": "egg",
      "category": "蛋类"
    },
    {
      "name": "盐",
      "mergeKey": "salt",
