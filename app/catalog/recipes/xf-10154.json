      "pantry": true
    },
    {
      "name": "生粉",
      "mergeKey": "cornstarch",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "食用油",
      "mergeKey": "cooking-oil",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "杏鲍菇洗净切条，咸蛋黄蒸熟捣碎备用,"
    },
    {
      "text": "锅内加适量水和两勺盐，烧开后放杏鲍菇条煮5分钟左右，拿出沥干水分,"
    },
    {
      "text": "倒入蛋液和杏鲍菇条搅拌均匀，每条杏鲍菇均匀蘸上一层生粉,"
    },
    {
      "text": "锅内加油烧至八成热，放杏鲍菇条炸到金黄盛出,"
    },
    {
      "text": "再起油锅，倒入咸蛋黄泥炒散，根据咸淡加盐,"
    },
    {
      "text": "把炸好的杏鲍菇条倒入，均匀裹上一层蛋黄就可以了"
    }
  ],
