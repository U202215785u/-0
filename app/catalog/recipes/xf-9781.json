      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "笋干用温水泡软后，洗净，切成细末,"
    },
    {
      "text": "豇豆切末，放入沸水中焯1分钟后捞出沥干水分备用；（豇豆焯水后再炒比较容易熟，而且颜色也比较好看）,"
    },
    {
      "text": "热锅热油，放入肉末炒至变色，倒入少许料酒，生抽，翻炒均匀后，放入豇豆和笋干，翻炒3-5分钟，最后加盐、鸡精调味即可"
    }
  ],
