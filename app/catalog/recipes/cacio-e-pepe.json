      "amount": 43,
      "unit": "克",
      "category": "乳制品"
    }
  ],
  "steps": [
    {
      "text": "大锅烧开加盐的水，下意大利面，偶尔搅拌，煮到明显有嚼劲，时间比包装说明少约2分钟。捞出前保留约360毫升面汤。",
      "ingredientNames": [
        "意大利面",
        "食盐"
      ]
    },
    {
      "text": "同时，取高边平底锅，中火融化约14克无盐黄油。加入粗磨黑胡椒，转动锅子加热约1分钟，炒出香气。",
      "timerSeconds": 60,
      "ingredientNames": [
        "无盐黄油",
        "粗磨黑胡椒"
      ]
    },
    {
      "text": "向锅中倒入约180毫升保留的面汤，煮至微沸。加入意大利面和剩余黄油，转小火，加入格拉纳帕达诺奶酪或帕玛森奶酪，边翻拌边加热约2分钟，直到奶酪融化且面条达到合适熟度。",
      "timerSeconds": 120,
      "ingredientNames": [
        "意大利面",
        "无盐黄油",
        "格拉纳帕达诺奶酪或帕玛森奶酪"
      ]
    },
    {
      "text": "离火，加入佩科里诺罗马诺奶酪并翻拌；如果酱汁偏干，少量补入面汤，直到奶酪融化、酱汁均匀裹住面条。装入温热的碗中，按口味补磨黑胡椒，立即食用。",
      "ingredientNames": [
        "佩科里诺罗马诺奶酪",
        "粗磨黑胡椒"
      ]
    }
  ],
  "baseServings": 2,
