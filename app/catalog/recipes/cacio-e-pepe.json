    },
    {
      "name": "粗磨黑胡椒",
      "mergeKey": "black-pepper",
      "amount": 7.5,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "格拉纳帕达诺奶酪或帕玛森奶酪",
      "mergeKey": "parmesan-cheese",
      "amount": 85,
