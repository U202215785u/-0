  "steps": [
    {
      "text": "将老豆腐切成约2.5厘米见方的小块。",
      "ingredientNames": [
        "老豆腐"
      ]
    },
    {
      "text": "把中筋面粉、玉米淀粉和泡打粉筛入大盘，加入半茶匙椒盐，拌匀。",
      "ingredientNames": [
        "中筋面粉",
        "玉米淀粉",
        "泡打粉（可选）",
        "椒盐"
      ]
    },
    {
      "text": "用干净的厨房毛巾或厨房纸把豆腐块拍干，放入面粉混合物中，均匀且薄薄地裹上每一面，用手抖掉多余的粉。",
      "ingredientNames": [
        "老豆腐"
      ]
    },
    {
      "text": "锅中倒入食用油，中高火烧热（油要足量覆盖整个锅底），轻轻放入豆腐块（不要挤在一起，必要时分两批煎）。放入后豆腐周围应立即冒泡，否则说明油温还不够。",
      "ingredientNames": [
        "食用油",
        "老豆腐"
      ]
    },
    {
      "text": "用筷子或夹子多次翻动豆腐，使各面均匀煎炸，全部金黄后夹出，放到垫有厨房纸的盘上吸去多余油分。",
      "ingredientNames": [
        "老豆腐"
      ]
    },
    {
      "text": "倒出大部分油，锅内留约半汤匙。放入红葱头、辣椒和大蒜，中火炒约1分钟。",
      "timerSeconds": 60,
      "ingredientNames": [
        "红葱头",
        "辣椒",
        "大蒜"
      ]
    },
    {
      "text": "加入煎好的豆腐块、葱花和半茶匙椒盐（或按口味），快速翻匀调味，装盘趁热食用。",
      "ingredientNames": [
        "老豆腐",
        "小葱",
        "椒盐"
      ]
    },
    {
      "text": "将花椒、八角、芝麻、小茴香和盐放入锅中，小火烘烤，不时翻动。",
      "ingredientNames": [
        "花椒",
        "八角",
        "芝麻",
        "小茴香",
        "盐"
      ]
    },
    {
      "text": "待盐的颜色略微变深、香料香味浓郁时离火，用研钵或香料研磨器磨成粉即可。",
      "ingredientNames": [
        "盐"
      ]
    }
  ],
  "baseServings": 2,
