  "steps": [
    {
      "text": "准备材料"
    },
    {
      "text": "鲜虾洗净去除虾线"
    },
    {
      "text": "鹌鹑蛋清洗后煮熟后浸泡凉水"
    },
    {
      "text": "鹌鹑蛋去皮，圆溜溜真可爱！"
    },
    {
      "text": "烧开一锅水，水中放一小勺盐，金针菇去根和木耳焯水后投凉捞出控水"
    },
    {
      "text": "藕和豆腐干煮熟"
    },
    {
      "text": "准备好葱姜蒜"
    },
    {
      "text": "锅中放两勺油，油烧热后，将葱姜蒜下锅煸香"
    },
    {
      "text": "加入鲜虾翻炒六成熟"
    },
    {
      "text": "取出麻辣香锅的调料"
    },
    {
      "text": "1"
    },
    {
      "text": "调料加入锅内"
    },
    {
      "text": "1"
    },
    {
      "text": "调料的用量看自己的口味调剂"
    },
    {
      "text": "1"
    },
    {
      "text": "加入去壳的鹌鹑蛋蛋"
    },
    {
      "text": "1"
    },
    {
      "text": "加入焯水控干水分的食材"
    },
    {
      "text": "1"
    },
    {
      "text": "加入青红椒翻炒均匀"
    },
    {
      "text": "1"
    },
    {
      "text": "翻炒至出香味"
    },
    {
      "text": "1"
    },
    {
      "text": "根据咸淡加适量食盐"
    },
    {
      "text": "1"
    },
    {
      "text": "略微加点糖会更加提味"
    },
    {
      "text": "1"
    },
    {
      "text": "出锅喽！"
    },
    {
      "text": "1"
    },
    {
      "text": "来碗米饭，就是一顿美餐！"
    },
    {
      "text": "2"
    },
    {
      "text": "堂妈和大头哥吃光一盆麻辣香锅还意犹未尽"
    }
