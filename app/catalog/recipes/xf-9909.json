  "steps": [
    {
      "text": "将猪里脊肉切细丝，加老抽、生抽、料酒、水淀粉抓匀，腌制十几分钟,"
    },
    {
      "text": "韭黄切段,"
    },
    {
      "text": "锅中油六七成热时，放入肉丝，翻炒至完全变色盛出,"
    },
    {
      "text": "锅中放少许许，油热后放入韭黄段，炒至稍稍变软,"
    },
    {
      "text": "放入炒好的肉丝，翻炒均匀，加盐调味即可"
    }
  ],
