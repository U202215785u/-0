  "steps": [
    {
      "text": "牛肉剁成末，调入少许生粉及盐腌制"
    },
    {
      "text": "豆腐切成丁，姜蒜切成末，葱切葱花"
    },
    {
      "text": "锅中放油烧热，爆香姜蒜末"
    },
    {
      "text": "爆香姜蒜后，接着放入肉末打散翻少，调入适量的辣豆豉酱继续翻炒，稍后加入豆腐小心的推翻"
    },
    {
      "text": "加半碗水没过豆腐烧煮一会，调入盐，鸡精，汤汁略干时倒入湿淀粉勾芡，撒上葱花及胡椒粉即可"
    }
  ],
