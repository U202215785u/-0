  "steps": [
    {
      "text": "先用刀将翅根划上几个口子，方便入味,"
    },
    {
      "text": "锅底倒少许油，放入翅根，用小火煎,"
    },
    {
      "text": "待一面变色后，翻动翅根，煎至表面金黄,"
    },
    {
      "text": "加入2勺料酒、2勺生抽、1勺老抽、1勺咖喱粉，翻炒均匀,"
    },
    {
      "text": "加入适量热水（没过翅根即可），大火烧开后，转中火炖至汤汁浓稠即可"
    }
  ],
