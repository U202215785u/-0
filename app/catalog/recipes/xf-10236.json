  "steps": [
    {
      "text": "猪肉，韭苗，豆干，红椒，姜分别切细丝，蒜头切片,"
    },
    {
      "text": "将猪肉，姜丝，用料酒1大匙，生抽1大匙，沙拉油1茶匙腌制15分钟,"
    },
    {
      "text": "锅内放少许油，冷油放入大蒜片爆至出香味,"
    },
    {
      "text": "放入豆干丝，慢火煸炒至表面变金黄色,"
    },
    {
      "text": "投入韭苗段，红椒丝，盐1/2茶匙，砂糖1/2茶匙,"
    },
    {
      "text": "快速翻炒约1分钟，盛出备用,"
    },
    {
      "text": "锅内再放入一匙油，放入腌好的肉丝，姜丝,"
    },
    {
      "text": "慢火煸炒至表面变金黄色,"
    },
    {
      "text": "最后把倒入韭苗，豆干混合，再炒约2分钟即可"
    }
  ],
