  "steps": [
    {
      "text": "猪肉切几刀，焯水洗净，加水炖开，加葱段，姜片，香叶，八角小火炖3个小时以上,"
    },
    {
      "text": "捞出晾凉，撕成越细越好的肉丝,"
    },
    {
      "text": "锅里热油，倒入肉丝，转小火,"
    },
    {
      "text": "加盐，五香粉，白糖，生抽慢慢翻炒约30分钟至肉丝蓬松"
    }
  ],
