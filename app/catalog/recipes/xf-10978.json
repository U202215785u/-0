  "steps": [
    {
      "text": "黄蚬洗净沥干，青红椒切块，葱切段，姜切片,"
    },
    {
      "text": "烧热油锅，放油，油温上来放姜葱爆出香味，再放小米泡椒炒香，放青红椒片翻炒几下,"
    },
    {
      "text": "放黄蚬入锅，喷点料酒,"
    },
    {
      "text": "翻炒一会儿，加一点水,"
    },
    {
      "text": "盖上锅盖，30秒,"
    },
    {
      "text": "打开锅盖，加点盐和鸡精调好味，翻炒至黄蚬基本都开口即可"
    }
  ],
