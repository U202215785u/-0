  "steps": [
    {
      "text": "豆腐切一厘米厚片。鸡蛋加盐打散。姜、蒜切末。红椒切段。葱切花。香菇切厚片,"
    },
    {
      "text": "把豆腐块在玉米淀粉里滚一下，使均匀沾上干粉,"
    },
    {
      "text": "再把裹好干粉的豆腐放蛋液里沾一下,"
    },
    {
      "text": "放入锅中，小火煎至两面金黄取出待用,"
    },
    {
      "text": "热锅凉油，小火爆香干椒段，姜、蒜末,"
    },
    {
      "text": "倒入猪肉馅炒散，至变色,"
    },
    {
      "text": "倒入香菇片，炒软,"
    },
    {
      "text": "倒入煎好的豆腐块，轻手略炒,"
    },
    {
      "text": "加入一小碗高汤或水，加入生抽、蚝油和盐适量，白糖一小勺，烧开改小火略煮,"
    },
    {
      "text": "煮至汤汁快收干时，调入鸡精，再以少量水淀粉勾芡，撒上葱花即可"
    }
  ],
