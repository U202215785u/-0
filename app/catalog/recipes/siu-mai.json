  "steps": [
    {
      "text": "猪肩肉切片、切条后切碎，浸水并按摩1至2分钟，静置10至15分钟后沥干挤水。虾用纸巾挤干后切碎；香菇热水泡10至15分钟，挤干切碎；胡萝卜切碎。",
      "ingredientNames": [
        "猪肩肉",
        "虾",
        "干香菇",
        "胡萝卜"
      ]
    },
    {
      "text": "将生抽、蚝油、食盐、白糖、玉米淀粉、小苏打、鸡粉、清水和白胡椒粉混合成腌料。",
      "ingredientNames": [
        "生抽",
        "蚝油",
        "食盐",
        "白糖",
        "玉米淀粉",
        "小苏打",
        "鸡粉",
        "清水",
        "白胡椒粉"
      ]
    },
    {
      "text": "腌料与猪肉搅拌约2至3分钟，静置约10分钟；加入虾、香菇、橄榄油和芝麻油再拌1至2分钟，盖好后冷藏腌制4至8小时。",
      "ingredientNames": [
        "猪肩肉",
        "虾",
        "干香菇",
        "橄榄油",
        "芝麻油"
      ]
    },
    {
      "text": "烧卖皮放在掌心，放入约28克馅料，收拢皮边形成开口烧卖，旋转并压实馅料，重复至馅料用完。",
      "ingredientNames": [
        "烧卖皮",
        "猪肩肉",
        "虾",
        "干香菇"
      ]
    },
    {
      "text": "蒸锅加约2杯水烧开，烧卖彼此分开摆在蒸架上，盖盖蒸10分钟；用普通锅和蒸架时蒸约12分钟，出锅后用胡萝卜碎装饰。",
      "ingredientNames": [
        "烧卖皮",
        "清水",
        "胡萝卜"
      ]
    }
  ],
