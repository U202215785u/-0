  ],
  "steps": [
    {
      "text": "将脆排剁成小块,"
    },
    {
      "text": "将剁好的脆排放上淀粉、鸡蛋盐、绍酒、胡椒粉和匀挂糊,"
    },
    {
      "text": "将红绿彩椒切成菱形块、洋葱切块,"
    },
    {
      "text": "煎锅内放少许油将排骨放入逐块煎炸,"
    },
    {
      "text": "一面煎至金黄色翻面煎另一面，两面煎至金黄，出锅时油温高点，防止排骨吸入太多的油，将煎好的排骨放在吸油纸上吸一下,"
    },
    {
      "text": "锅内做油煸香花椒,"
    },
    {
      "text": "放入洋葱、辣椒煸出香味,"
    },
    {
      "text": "放入煎好的排骨煸炒,"
    },
    {
      "text": "放入青红椒块煸炒出香味加盐、白糖、生抽调味,"
    },
    {
      "text": "最后，倒入小米锅巴一起煸炒出锅装盘"
    }
  ],
