  "steps": [
    {
      "text": "锅里放油，烧热，倒进牛肉，尽量把牛肉铺开，煎至变色,"
    },
    {
      "text": "翻面，同样铺开，煎至变色后盛起备用,"
    },
    {
      "text": "锅洗干净，重新热油，放下蒜蓉爆香,"
    },
    {
      "text": "放进沥干水分的豆角，大火爆炒,"
    },
    {
      "text": "边炒边洒水，把豆角煸炒至全部转青绿色，加入3汤匙水，盖上锅盖大火煮3分钟,"
    },
    {
      "text": "加入牛肉，翻炒均匀，放适量盐（牛肉腌过的，盐要适量），放一点点白糖提鲜,"
    },
    {
      "text": "翻炒至盐、糖融化,"
    },
    {
      "text": "装碟上桌"
    }
  ],
