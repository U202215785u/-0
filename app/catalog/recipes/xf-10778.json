  "title": "成长果冻果汁杯",
  "ingredients": [
    {
      "name": "奇异果",
      "mergeKey": "kiwi",
      "category": "蔬菜"
    },
    {
      "name": "橙子",
      "mergeKey": "orange",
      "category": "蔬菜"
    },
    {
      "name": "苹果",
      "mergeKey": "apple",
