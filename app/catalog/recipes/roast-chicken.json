{
  "id": "roast-chicken",
  "title": "黄油烤鸡",
  "ingredients": [
    {
      "name": "粗盐",
      "mergeKey": "salt",
      "amount": 15,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "整鸡",
      "mergeKey": "chicken",
      "amount": 1814,
      "unit": "克",
      "category": "肉类"
    },
    {
      "name": "无盐黄油",
      "mergeKey": "butter",
      "amount": 57,
      "unit": "克",
      "category": "乳制品"
    },
    {
      "name": "清水",
      "mergeKey": "water",
