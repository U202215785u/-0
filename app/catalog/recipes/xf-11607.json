{
  "id": "xf-11607",
  "title": "玛格丽特小饼",
  "ingredients": [
    {
      "name": "黄油",
      "mergeKey": "butter",
      "amount": 100,
      "unit": "克",
      "category": "乳制品"
    },
    {
      "name": "低粉",
      "mergeKey": "flour",
      "amount": 100,
      "unit": "克",
      "category": "米面主食",
      "pantry": true
    },
    {
      "name": "玉米淀粉",
      "mergeKey": "cornstarch",
      "amount": 100,
      "unit": "克",
      "category": "干货",
      "pantry": true
    },
    {
      "name": "糖粉",
      "mergeKey": "powdered-sugar",
      "amount": 60,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "熟蛋黄",
      "mergeKey": "egg-yolk",
      "amount": 2,
      "unit": "个",
      "category": "蛋类"
    }
  ],
  "steps": [
    {
      "text": "可以做40个左右,"
    },
    {
      "text": "黄油室温软化后加入糖粉打至颜色变浅，体积变大,"
    },
    {
      "text": "煮熟的鸡蛋取出蛋黄，过筛后加入黄油中，搅拌均匀,"
    },
    {
      "text": "低粉和玉米淀粉混合后筛入2中,"
    },
    {
      "text": "用手将黄油和面粉揉成一个光滑的面团,"
    },
    {
      "text": "将面团放入冰箱冷藏1小时（时间紧张的话可以省略这一步）,"
    },
    {
      "text": "冷藏后的面团取小份，10克左右，搓成一个小圆球,"
    },
    {
      "text": "放在烤盘上，用手指轻轻压下，一圈会呈现自然的裂纹,"
    },
    {
      "text": "放入175度预热的烤箱，中层烘烤15分钟左右，待饼干边缘上色即可"
    }
  ],
