  "steps": [
    {
      "text": "洗净鸡翅，加黑胡椒、黄酒、生抽、叉烧酱、蜂蜜、老抽入一会味,"
    },
    {
      "text": "烤箱预热200度，放中层烤15分钟,"
    },
    {
      "text": "翻一下面再烤15分钟,"
    },
    {
      "text": "喜欢吃干一点的，可以中途打开风门"
