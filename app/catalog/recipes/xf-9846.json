  "steps": [
    {
      "text": "猪肉剁成小颗粒，蒜苔切小段，红椒，豆豉，大蒜切碎,"
    },
    {
      "text": "锅内热1小匙油，放入蒜苔，盐，1大匙水炒至8成熟，盛出备用,"
    },
    {
      "text": "锅内热1/2大匙油，放入红椒，豆豉，蒜蓉炒出香味,"
    },
    {
      "text": "放入猪肉碎，小火煸炒至出油脂,"
    },
    {
      "text": "加入生抽，砂糖，鸡精炒至水份干,"
    },
    {
      "text": "加入炒好的蒜苔，炒至10成熟（蒜苔表面微皱即可）"
    }
  ],
