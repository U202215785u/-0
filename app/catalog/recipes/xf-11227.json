  "steps": [
    {
      "text": "鸡胸肉两块，青红椒各一，干辣椒，陴县豆瓣酱，姜,"
    },
    {
      "text": "青红椒切小块，姜切片，干辣椒切段,"
    },
    {
      "text": "鸡肉切小方块，加入胡椒粉，米酒，蛋清一个，盐，少量生抽，鸡精，生粉上浆，略腌十分钟,"
    },
    {
      "text": "锅烧热油，下鸡丁滑熟（全部变白就差不多了,"
    },
    {
      "text": "另起一锅，入油。油热，小火爆香花椒粒。出香味后，滤出花椒不要,"
    },
    {
      "text": "小火下姜片，干辣椒段和豆瓣酱翻炒,"
    },
    {
      "text": "倒入青红椒翻炒，同时加入料酒，盐,"
    },
    {
      "text": "倒入滑熟的鸡丁，翻炒均匀，勾薄芡即可"
    }
  ],
