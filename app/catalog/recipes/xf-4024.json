  "steps": [
    {
      "text": "猪肉切小丁后粗斩成肉馅，红葱头切片,"
    },
    {
      "text": "锅内1大匙油，冷油放入红葱头片爆至金黄色,"
    },
    {
      "text": "加入猪肉馅，小火煸炒约5分钟至出油,"
    },
    {
      "text": "将猪肉馅装入小锅内，放入熟鸡蛋及所有调味料，清水250毫升,"
    },
    {
      "text": "用中火煮开后，转小火加盖煮约25-30分钟，至肉剩少量汤汁,"
    },
    {
      "text": "鲜虾去头，去壳（备用）虾仁洗净备用,"
    },
    {
      "text": "锅内1小匙油，冷油放入虾头及虾壳，姜片炒至变色,"
    },
    {
      "text": "注入清水500毫升,煮至汤色转微白。撇去泡沫，加入盐，白胡椒粉调味,"
    },
    {
      "text": "锅内放少量盐，烧开水，放入面条，中途加3次冷水煮至熟，捞起备用,"
    },
    {
      "text": "剩下的面汤，分别将虾仁，豆芽菜烫熟即可,"
    },
    {
      "text": "1"
    },
    {
      "text": "最后将面条放入虾高汤，摆虾仁，豆芽菜，卤蛋切半，淋上卤肉燥即可"
    }
  ],
