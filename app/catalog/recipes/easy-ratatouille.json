  "steps": [
    {
      "text": "茄子切成约1.3厘米块，放入滤篮，撒约四分之三茶匙食盐拌匀，静置至少20分钟、最多1小时；用厨房巾擦干并挤出多余水分。",
      "ingredientNames": [
        "茄子",
        "食盐"
      ]
    },
    {
      "text": "锅中中高火加3汤匙橄榄油，放一半茄子，常翻炒5至7分钟至变软金黄，盛出；再加3汤匙橄榄油炒另一半茄子。",
      "ingredientNames": [
        "特级初榨橄榄油",
        "茄子"
      ]
    },
    {
      "text": "转大火，加入切块西葫芦、红洋葱、红甜椒、罗勒枝、蒜、圣女果、百里香、食盐、黑胡椒和剩余橄榄油，常翻炒10至12分钟至蔬菜变软。",
      "ingredientNames": [
        "西葫芦",
        "红洋葱",
        "红甜椒",
        "罗勒",
        "蒜",
        "圣女果",
        "百里香",
        "食盐",
        "黑胡椒",
        "特级初榨橄榄油"
      ]
    },
    {
      "text": "转中高火，茄子回锅，加入干白葡萄酒和半杯清水，翻炒约5分钟至酒液吸收、汤汁变成炖菜状。离火，捞出罗勒枝，拌入红酒醋，按口味补盐和黑胡椒。",
      "ingredientNames": [
        "茄子",
        "干白葡萄酒",
        "红酒醋",
        "食盐",
        "黑胡椒"
      ]
    },
    {
      "text": "温热或室温食用，顶部放罗勒叶。",
      "ingredientNames": [
        "罗勒"
      ]
    }
  ],
