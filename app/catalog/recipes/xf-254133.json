      "quantityText": "（熟的）"
    }
  ],
  "steps": [
    {
      "text": "取姜汁"
    },
    {
      "text": "打蛋，取蛋清"
    },
    {
      "text": "里脊肉切长条"
    },
    {
      "text": "放适量盐"
    },
    {
      "text": "适量白胡椒粉"
    },
    {
      "text": "适量蛋清"
    },
    {
      "text": "放姜汁"
    },
    {
      "text": "拌匀，腌制一会儿"
    },
    {
      "text": "腌制好的里脊沾上生粉"
    },
    {
      "text": "入油锅炸，表面生粉变色"
    },
    {
      "text": "捞出"
    },
    {
      "text": "再复炸一次，表面微焦变脆"
    },
    {
      "text": "捞出滤油"
    },
    {
      "text": "另起一锅，放适量番茄酱"
    },
    {
      "text": "适量白糖"
    },
    {
      "text": "少许清水，煮开"
    },
    {
      "text": "加少许淀粉水（生粉+清水）"
    },
    {
      "text": "煮到汤汁变稠关火"
    },
    {
      "text": "快速倒入炸好的里脊肉"
    },
    {
      "text": "拌炒均匀"
    },
    {
      "text": "撒芝麻"
    },
    {
      "text": "出锅！啃吧"
    }
  ],
