{
  "id": "xf-11110",
  "title": "紫薯慕斯",
  "ingredients": [
    {
      "name": "戚风蛋糕片",
      "mergeKey": "chiffon-cake",
      "amount": 2,
      "unit": "片",
      "category": "米面主食"
    },
    {
      "name": "紫薯泥",
      "mergeKey": "purple-sweet-potato",
      "amount": 150,
      "unit": "克",
      "category": "蔬菜"
    },
    {
      "name": "牛奶",
      "mergeKey": "milk",
      "amount": 200,
      "unit": "毫升",
      "category": "乳制品"
    },
    {
      "name": "淡奶油",
      "mergeKey": "cream",
      "amount": 150,
      "unit": "毫升",
      "category": "乳制品"
    },
    {
      "name": "糖",
      "mergeKey": "sugar",
      "amount": 50,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    },
    {
      "name": "吉利丁片",
      "mergeKey": "gelatin",
      "amount": 10,
      "unit": "克",
      "category": "干货",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "紫薯切片微波炉高火叮5-10分钟后，用勺子压成泥然后过筛备用,"
    },
    {
      "text": "过筛后的紫薯泥，加35克糖，加150克牛奶混合均匀,"
    },
    {
      "text": "吉利丁片放入冰水中泡软后沥干水分，放入50克牛奶中，加热至吉利丁片融化,"
    },
    {
      "text": "将2+3混合均匀,"
    },
    {
      "text": "淡奶油加剩下的糖打发至纹路出现，再与4混合均匀即成慕斯糊,"
    },
    {
      "text": "蛋糕模底铺入一片蛋糕片，倒入一半的慕斯糊，再铺入一片蛋糕片，倒入剩下的慕斯糊，放入冰箱冷藏4小时以上,"
    },
    {
      "text": "装饰的小花是将紫薯泥擀成薄片，再用小的模子压出形状即可"
    }
  ],
