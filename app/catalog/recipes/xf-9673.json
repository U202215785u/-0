  "steps": [
    {
      "text": "鲜藕用刷子刷净泥沙，切成丝，胡萝卜切丝，芹菜切段,"
    },
    {
      "text": "锅内热1又1/2大匙油，放入藕丝翻炒约1分钟,"
    },
    {
      "text": "加入胡萝卜丝、芹菜段，放入盐1/3小匙,"
    },
    {
      "text": "再迅速翻炒均匀即可出锅"
    }
  ],
