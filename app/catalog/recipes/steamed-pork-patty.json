  "steps": [
    {
      "text": "猪肩肉修去多余肥油，切条、切片，再剁成小粒；榨菜和马蹄切碎，葱切末备用。",
      "ingredientNames": [
        "猪肩肉",
        "榨菜",
        "马蹄",
        "葱"
      ]
    },
    {
      "text": "猪肉挤去多余水分，加入蚝油、白糖、玉米淀粉、芝麻油、鸡粉和白胡椒粉，用筷子搅拌约1分钟，至肉馅黏稠。",
      "ingredientNames": [
        "猪肩肉",
        "蚝油",
        "白糖",
        "玉米淀粉",
        "芝麻油",
        "鸡粉",
        "白胡椒粉"
      ]
    },
    {
      "text": "盘面薄薄抹食用油，将肉馅压成均匀肉饼。",
      "ingredientNames": [
        "食用油",
        "猪肩肉"
      ]
    },
    {
      "text": "炒锅加水和蒸架，大火烧沸，水面刚接触盘底即可。",
      "ingredientNames": []
    },
    {
      "text": "放入肉饼，盖盖蒸15分钟；取出后撒葱末。",
      "ingredientNames": [
        "葱"
      ]
    }
  ],
