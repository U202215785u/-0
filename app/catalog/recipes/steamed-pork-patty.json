{
  "id": "steamed-pork-patty",
  "title": "榨菜蒸猪肉饼",
  "ingredients": [
    { "name": "猪肩肉", "amount": 336.0, "unit": "克", "category": "肉类", "pantry": false, "mergeKey": "pork-shoulder" },
    { "name": "榨菜", "amount": 42.0, "unit": "克", "category": "蔬菜", "pantry": false, "mergeKey": "pickled-mustard" },
    { "name": "马蹄", "amount": 112.0, "unit": "克", "category": "蔬菜", "pantry": false, "mergeKey": "water-chestnut" },
    { "name": "葱", "amount": 2.0, "unit": "根", "category": "蔬菜", "pantry": false, "mergeKey": "green-onion" },
    { "name": "蚝油", "amount": 15.0, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "oyster-sauce" },
    { "name": "白糖", "amount": 5.0, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "sugar" },
    { "name": "玉米淀粉", "amount": 30.0, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "cornstarch" },
    { "name": "香油", "amount": 5.0, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "sesame-oil" },
    { "name": "鸡粉", "amount": 5.0, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "chicken-bouillon" },
    { "name": "白胡椒粉", "amount": 1.25, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "white-pepper" },
    { "name": "玉米油", "amount": 5.0, "unit": "毫升", "category": "调味料", "pantry": true, "mergeKey": "corn-oil" }
  ],
  "steps": [
    { "text": "将猪肩肉剔去较肥的油脂，先切条、切片，再切成小丁，放入清水盆中轻轻揉洗去血水，捞入漏勺沥水（也可用较肥的五花肉，但避免猪排、里脊等过瘦部位）。", "ingredientNames": ["猪肩肉"] },
    { "text": "榨菜切成细条；马蹄用刀背或锅铲压成小块（切丁口感偏硬）；葱切小段，葱白与葱绿分开，葱白拌入肉馅，葱绿留作点缀。", "ingredientNames": ["榨菜", "马蹄", "葱"] },
    { "text": "再次用力挤干猪肉中的水分，加入蚝油、白糖、玉米淀粉、香油、鸡粉和白胡椒粉。", "ingredientNames": ["猪肩肉", "蚝油", "白糖", "玉米淀粉", "香油", "鸡粉", "白胡椒粉"] },
    { "text": "用筷子将猪肉与调料充分搅拌约一分钟至肉馅发黏起胶，再加入葱白、马蹄和榨菜拌匀约两分钟。", "timerSeconds": 180, "ingredientNames": ["猪肩肉", "葱", "马蹄", "榨菜"] },
    { "text": "盘面抹一半玉米油防粘，另一半玉米油拌入肉馅；将肉馅倒入盘中，用勺子压平成饼状，表面再抹少许油增亮。", "ingredientNames": ["玉米油"] },
    { "text": "炒锅大火烧开足量清水，放入蒸架，水面刚好没过蒸架或触及盘底；水开后放入肉饼盘，盖盖蒸十五分钟（若用金属盘可减两三分钟）。", "timerSeconds": 900, "ingredientNames": ["猪肩肉"] },
    { "text": "小心取出盘子，撒上预留的葱绿点缀，趁热上桌。", "ingredientNames": ["葱"] }
  ],
  "baseServings": 4,
  "durationMinutes": 45,
  "difficulty": "简单",
