  "steps": [
    {
      "text": "黄油加热至融化,"
    },
    {
      "text": "加糖搅拌至糖融化,"
    },
    {
      "text": "分5次加入蛋液，每次都要搅拌均匀,"
    },
    {
      "text": "加入朗姆酒，拌匀,"
    },
    {
      "text": "加入蜂蜜，拌匀,"
    },
    {
      "text": "加入淡奶油，拌匀,"
    },
    {
      "text": "筛入低粉、泡打粉,"
    },
    {
      "text": "沿不规则方向切拌成均匀的糊状,"
    },
    {
      "text": "将面糊装入裱花袋,"
    },
    {
      "text": "挤入模具中约八九分满,"
    },
    {
      "text": "1"
    },
    {
      "text": "放入预热180度的烤箱，烤制25~30分钟,"
    },
    {
      "text": "1"
    },
    {
      "text": "出炉，晾凉后用融化的黑巧克力装饰，即可"
    }
  ],
