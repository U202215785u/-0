  "steps": [
    {
      "text": "准备好所需材料,"
    },
    {
      "text": "蛋液打散，加入一大匙温水，搅拌均匀,"
    },
    {
      "text": "加入白芝麻、火腿丁，搅拌均匀,"
    },
    {
      "text": "锅内放入植物油,"
    },
    {
      "text": "油热后，倒入蛋液，加少量盐,"
    },
    {
      "text": "用筷子搅拌成蛋碎，盛出备用,"
    },
    {
      "text": "在一片土司上放上生菜,"
    },
    {
      "text": "加入一大匙火腿蛋碎,"
    },
    {
      "text": "盖上另一片土司，轻压,"
    },
    {
      "text": "压上土司模,"
    },
    {
      "text": "1"
    },
    {
      "text": "除去边角，取出压好的三文治胚,"
    },
    {
      "text": "1"
    },
    {
      "text": "用融化的黑巧、白巧、番茄沙司装饰即可"
    }
  ],
