  "steps": [
    {
      "text": "五香豆干切成细丁，朝天红椒切成小圈,"
    },
    {
      "text": "锅内烧开水，放入毛豆煮至水开捞起沥净水备用,"
    },
    {
      "text": "锅内热少许油，放入猪绞肉小火煸炒至出油,"
    },
    {
      "text": "加入豆干丁，及红椒圈炒出香味,"
    },
    {
      "text": "加入烫过的毛豆，及所有调味料,"
    },
    {
      "text": "再翻炒至毛豆的水份收干即可"
    }
  ],
