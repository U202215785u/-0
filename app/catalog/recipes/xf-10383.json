  "steps": [
    {
      "text": "黄油室温放软，加入绵白糖、盐,"
    },
    {
      "text": "搅打至完全融合，呈现羽毛状,"
    },
    {
      "text": "分2次加入蛋，搅拌均匀,"
    },
    {
      "text": "分3次加入淡奶油,"
    },
    {
      "text": "搅拌至均匀的糊状,"
    },
    {
      "text": "低粉、泡打粉、可可粉混合过筛，加入5中,"
    },
    {
      "text": "将面糊以不规则方式搅拌均匀，装入裱花袋中,"
    },
    {
      "text": "入模具中七分满，放入预热180度的烤箱40分钟,"
    },
    {
      "text": "取出，放凉后，用融化的白巧、彩珠糖、巧克力豆装饰即可"
    }
  ],
