  "title": "香肠沙拉酱吐司",
  "ingredients": [
    {
      "name": "白土司片",
      "mergeKey": "toast",
      "category": "米面主食"
    },
    {
      "name": "香肠",
      "mergeKey": "sausage",
      "category": "肉类"
    },
    {
      "name": "沙拉酱",
      "mergeKey": "mayonnaise",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "烤箱200度预热。香肠切片（不要太薄，否则会烤焦），铺在白土司上,"
    },
    {
      "text": "入预热好的烤箱，200度烤箱上层，烤8分钟左右至土司边缘稍稍发黄发酥即可。取出，在吃之前挤上沙拉酱即可"
    }
  ],
