  "steps": [
    {
      "text": "撕开绢豆腐盒的封口，盖上几层厨房纸后倒扣，放在平整台面上，让厨房纸吸走多余水分。",
      "ingredientNames": ["绢豆腐"]
    },
    {
      "text": "趁等待时调酱汁：小锅中加入油、葱花和大蒜（留部分葱花作装饰），小火熬至香料微黄，关火后拌入辣椒碎（如用），最后加入生抽、黑米醋和糖，充分拌匀。",
      "ingredientNames": ["食用油", "小葱", "大蒜", "辣椒碎（可选）", "生抽", "黑米醋", "糖"]
    },
    {
      "text": "把豆腐翻正，小心揭去厨房纸。将餐盘倒扣在豆腐盒开口上，整体翻转后轻轻提起盒子，让豆腐落在盘中。",
      "ingredientNames": ["绢豆腐"]
    },
    {
      "text": "把酱汁淋在豆腐上，撒上葱花和熟白芝麻作点缀。",
      "ingredientNames": ["小葱", "熟白芝麻"]
    }
  ],
  "baseServings": 2,
  "durationMinutes": 10,
