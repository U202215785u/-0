  "steps": [
    {
      "text": "鸡胸肉切成约1.3厘米厚的片，逆纹切更嫩；用刀背交叉拍松两面。",
      "ingredientNames": [
        "鸡胸肉"
      ]
    },
    {
      "text": "蚝油、白糖、蒜盐、玉米淀粉和清水调匀，加入鸡胸肉按摩入味。",
      "ingredientNames": [
        "蚝油",
        "白糖",
        "蒜盐",
        "玉米淀粉",
        "清水",
        "鸡胸肉"
      ]
    },
    {
      "text": "把鸡胸肉两面薄薄裹上玉米淀粉。",
      "ingredientNames": [
        "鸡胸肉",
        "玉米淀粉"
      ]
    },
    {
      "text": "锅大火烧热加食用油，油面有波纹后转小火，放入鸡胸肉煎至两面金黄且熟透，趁热装盘。",
      "ingredientNames": [
        "食用油",
        "鸡胸肉"
      ]
    }
  ],
