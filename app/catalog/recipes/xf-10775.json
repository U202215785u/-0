  "steps": [
    {
      "text": "虾洗净放冰箱速冻半个小时，取出剥壳去虾肠（留下尾巴 最后一段的虾壳,"
    },
    {
      "text": "用少许盐，料酒和淀粉腌制剥好的虾仁，放冰箱冷藏十分钟取出待用,"
    },
    {
      "text": "芦笋浸泡洗净后，削去老皮，斜切成段。姜切丝，葱切段,"
    },
    {
      "text": "炒锅烧热，放油，煸炒姜丝和葱段至出香味后，把姜丝葱段捞出扔掉,"
    },
    {
      "text": "把虾仁放入油锅滑炒至变色，入芦笋一起煸炒片刻，加少许盐调味出锅"
    }
  ],
