  "steps": [
    {
      "text": "厚底锅中高火加橄榄油，去掉肠衣的意大利香肠分成约2.5厘米块，单层放入，静置煎3分钟，再翻动煎3至4分钟至全身上色且刚熟，捞出。",
      "ingredientNames": [
        "特级初榨橄榄油",
        "意大利香肠"
      ]
    },
    {
      "text": "原锅加入洋葱和食盐，翻炒约3分钟至略软并开始上色；加入切片蒜和番茄膏，常搅拌炒约3分钟至番茄膏变深并开始粘锅。加入2杯清水，刮起锅底焦香。",
      "ingredientNames": [
        "洋葱",
        "食盐",
        "蒜",
        "浓缩番茄膏"
      ]
    },
    {
      "text": "倒入鸡汤和食盐，大火煮沸；加入掰成约5至8厘米段的千层面，常搅拌煮约9分钟至很有嚼劲。",
      "ingredientNames": [
        "低钠鸡汤",
        "干千层面",
        "食盐"
      ]
    },
    {
      "text": "乳清干酪加食盐和黑胡椒拌匀。",
      "ingredientNames": [
        "全脂乳清干酪",
        "食盐",
        "黑胡椒"
      ]
    },
    {
      "text": "汤中再加2杯清水，放回香肠，转小火煮约5分钟至肉热透。离火拌入菠菜，按口味调盐和胡椒。盛入碗中，放一勺乳清干酪。",
      "ingredientNames": [
        "意大利香肠",
        "嫩菠菜",
        "食盐",
        "黑胡椒",
        "全脂乳清干酪"
      ]
    }
  ],
  "baseServings": 4,
