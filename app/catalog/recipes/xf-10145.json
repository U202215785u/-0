  "steps": [
    {
      "text": "腰花买一破二，把中间白色的地方去掉，外面的一层膜去掉。用花刀切好，用盐腌制一下,"
    },
    {
      "text": "木耳发好，番茄切片,"
    },
    {
      "text": "把腰花焯水去味,"
    },
    {
      "text": "起油锅把木耳番茄炒一下加鸡汤烧开后，小火炖10分钟，放腰花后炖5分钟，打一个鸡蛋进去就可以了"
    }
  ],
