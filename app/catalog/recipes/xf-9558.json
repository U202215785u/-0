  "steps": [
    {
      "text": "准备材料,"
    },
    {
      "text": "青椒洗净后，去籽用手撕成小块，三文鱼切成片，香菇切成小片,"
    },
    {
      "text": "碗中放入少许料酒，浸泡三文鱼片10分钟,"
    },
    {
      "text": "锅中放油，倒入葱末，姜末爆香,"
    },
    {
      "text": "倒入三文鱼片,"
    },
    {
      "text": "倒入青椒片，炒二三下即可"
    }
  ],
