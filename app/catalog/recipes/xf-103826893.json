  "steps": [
    {
      "text": "肉切片备用！"
    },
    {
      "text": "鸡蛋炒熟备用"
    },
    {
      "text": "木耳提前泡好！胡萝卜，黄瓜切片"
    },
    {
      "text": "起锅，烧油，蒜葱炝锅"
    },
    {
      "text": "加入肉片炒至变色"
    },
    {
      "text": "加料酒，酱油，蚝油，盐翻炒均匀"
    },
    {
      "text": "倒入配菜翻炒"
    },
    {
      "text": "淀粉加一点水，盐，几滴醋和香油，搅拌均匀！倒入锅中勾芡！翻炒均匀！"
    },
    {
      "text": "出锅！"
    }
  ],
