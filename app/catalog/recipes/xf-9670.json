  ],
  "steps": [
    {
      "text": "锅内热1又1/2大匙沙拉油，放入包菜及胡萝卜片,"
    },
    {
      "text": "加入2大匙清水，盐，铁锅水放多些，不锈钢锅可少放水，或不放水,"
    },
    {
      "text": "煮至包菜叶变软时，加入香水芹菜,"
    },
    {
      "text": "再混合均匀即可起锅"
    }
  ],
