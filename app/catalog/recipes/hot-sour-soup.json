  "steps": [
    { "text": "洗净所有蔬菜并切好：番茄、胡萝卜、海鲜菇、杏鲍菇、香菇、木耳、红甜椒、豆腐、小葱；干木耳提前用温水泡发约十分钟。", "timerSeconds": 600, "ingredientNames": ["番茄", "胡萝卜", "海鲜菇", "杏鲍菇", "香菇", "干木耳", "红甜椒", "豆腐", "小葱"] },
    { "text": "碗中把玉米淀粉和水拌成均匀芡汁；另一个碗磕入鸡蛋打散；两碗都留待下锅前再搅匀。", "ingredientNames": ["玉米淀粉", "水", "鸡蛋"] },
    { "text": "提前把水烧开备用。", "ingredientNames": ["水"] },
    { "text": "炉灶开最大火热锅，加入玉米油和干辣椒，把辣椒在油里翻炒约一分钟让油带辣香，之后捞出辣椒不用。", "timerSeconds": 60, "ingredientNames": ["玉米油", "干辣椒"] },
    { "text": "下入番茄丁炒三十到六十秒，然后加入烧开的水。", "timerSeconds": 45, "ingredientNames": ["番茄", "水"] },
    { "text": "加入白胡椒粉搅拌十五到三十秒；再加入盐、糖、生抽和老抽，继续搅拌十五到三十秒；最后加入豆腐、菌菇和蔬菜（小葱除外），轻轻搅拌五到十秒。", "timerSeconds": 30, "ingredientNames": ["白胡椒粉", "盐", "糖", "生抽", "老抽", "豆腐", "海鲜菇", "杏鲍菇", "香菇", "干木耳", "红甜椒", "胡萝卜"] },
    { "text": "盖上锅盖（用稍小的锅盖能更快烧开），约三到四分钟烧开。", "timerSeconds": 210, "ingredientNames": [] },
    { "text": "开盖后先把芡汁再搅匀，边搅拌边于五十到六十秒内缓缓倒入；再把蛋液重新打散，沿锅边于二十到三十秒内缓缓倒入（倒蛋时不必搅拌）；最后加入醋和香油，醋放最后才能保留风味；尝味调整。", "timerSeconds": 60, "ingredientNames": ["玉米淀粉", "水", "鸡蛋", "醋", "香油"] },
    { "text": "关火，把汤盛入碗中，撒上葱花点缀即可。", "ingredientNames": ["小葱"] }
  ],
  "baseServings": 4,
  "durationMinutes": 30,
  "difficulty": "中等",
  "tags": ["煮", "汤羹", "家常菜", "素菜"],
