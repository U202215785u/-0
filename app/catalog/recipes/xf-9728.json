  "steps": [
    {
      "text": "排骨切寸段，用料酒，蚝油，葱姜，生抽，蒸鱼豉油和压碎的豆豉拌匀腌制2小时,"
    },
    {
      "text": "挑出葱姜，倒入干淀粉搅匀,"
    },
    {
      "text": "锅内烧开水，把拌匀的排骨放到蒸屉上中小火蒸1小时即可"
    }
