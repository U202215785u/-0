  "steps": [
    {
      "text": "五花肉切成约2.5厘米小块；粽叶清洗后煮软，再浸泡保持柔韧。",
      "ingredientNames": [
        "五花肉",
        "粽叶"
      ]
    },
    {
      "text": "糯米、绿豆、花生、虾米、腊肠、咸蛋黄和干香菇分别清洗、浸泡、切配；五花肉用食盐、五香粉、生抽、鸡粉和绍兴酒腌制。",
      "ingredientNames": [
        "糯米",
        "去皮绿豆",
        "花生",
        "虾米",
        "腊肠",
        "咸蛋黄",
        "干香菇",
        "五花肉",
        "食盐",
        "五香粉",
        "生抽",
        "鸡粉",
        "绍兴酒"
      ]
    },
    {
      "text": "糯米、绿豆和花生分别按来源页面分组加食盐、白糖和橄榄油调味，馅料分份备好。",
      "ingredientNames": [
        "糯米",
        "去皮绿豆",
        "花生",
        "食盐",
        "白糖",
        "橄榄油"
      ]
    },
    {
      "text": "粽叶折成漏斗形，依次填入糯米、绿豆、花生、肉和其他馅料，再覆盖糯米，折叶封口并用棉绳扎紧。",
      "ingredientNames": [
        "粽叶",
        "糯米",
        "去皮绿豆",
        "花生",
        "五花肉",
        "腊肠",
        "咸蛋黄",
        "干香菇"
      ]
    },
    {
      "text": "粽子放入大锅，加冷水完全没过，大火煮沸后保持沸腾约3小时，捞出沥水。",
      "ingredientNames": [
        "粽叶"
      ]
    }
  ],
  "baseServings": 4,
