  "steps": [
    {
      "text": "黑巧克力和牛油分别溶化，糖、盐一起搅拌,"
    },
    {
      "text": "慢慢加入蜂蜜、鸡蛋搅拌均匀,"
    },
    {
      "text": "加入过筛的可可粉与低筋粉搅拌均匀,"
    },
    {
      "text": "把面糊放入裱花袋，挤成长条形，在成型的饼胚上放一些腰果,"
    },
    {
      "text": "烤箱预热，用170℃烤制12分钟出炉"
    }
  ],
