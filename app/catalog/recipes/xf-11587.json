{
  "id": "xf-11587",
  "title": "虾仁厚蛋烧",
  "ingredients": [
    {
      "name": "鸡蛋",
      "mergeKey": "egg",
      "amount": 3,
      "unit": "个",
      "category": "蛋类"
    },
    {
      "name": "虾仁",
      "mergeKey": "shrimp",
      "amount": 100,
      "unit": "克",
      "category": "水产"
    },
    {
      "name": "牛奶",
      "mergeKey": "milk",
      "amount": 50,
      "unit": "毫升",
      "category": "乳制品"
    },
    {
      "name": "盐",
      "mergeKey": "salt",
      "amount": 2,
      "unit": "克",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "虾仁用一点料酒腌制10分钟，切成小粒，再稍微剁几下,"
    },
    {
      "text": "鸡蛋打散后加入牛奶和虾仁粒以及盐搅匀,"
    },
    {
      "text": "平底锅放两小勺油，中小火加热，倒入一些蛋液，能摊满锅底的量即可,"
    },
    {
      "text": "锅底蛋液未完全凝结时，用锅铲和筷子帮助把蛋饼卷起来，放在锅子一边,"
    },
    {
      "text": "在锅子空出的地方再倒些蛋液,"
    },
    {
      "text": "蛋液半凝结马上把刚才卷号的蛋饼在卷过去。重复上面的步骤，直到蛋液全部用完，卷起成厚蛋烧。关火在锅中稍微放一会儿定型。然后取出用刀切段装盘"
    }
  ],
