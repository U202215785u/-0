    {
      "name": "料酒",
      "mergeKey": "cooking-wine",
      "category": "调味料",
      "pantry": true
    }
  ],
  "steps": [
    {
      "text": "糯米与菠萝肉混合（不放糖）放进菠萝碗中，隔水蒸30分钟,"
    },
    {
      "text": "虾仁先用盐、料酒腌10分钟，锅中放水烧开， 将豌豆、虾仁分别焯一下水沥干,"
    },
    {
      "text": "锅内放少许油烧热，倒入焯水过的豌豆、虾仁和菠萝丁、西红柿丁翻炒一下，加调料勾上薄欠起锅，取两大勺与蒸好的菠萝饭拌合即可"
    }
  ],
