  "title": "香咸菠萝饭",
  "ingredients": [
    {
      "name": "菠萝",
      "mergeKey": "pineapple",
      "amount": 0.5,
      "unit": "只",
      "category": "蔬菜"
    },
    {
      "name": "糯米",
      "mergeKey": "glutinous-rice",
      "category": "米面主食"
    },
    {
      "name": "虾仁",
      "mergeKey": "shrimp",
      "category": "水产"
    },
    {
      "name": "豌豆",
      "mergeKey": "pea",
      "category": "蔬菜"
    },
    {
      "name": "西红柿",
      "mergeKey": "tomato",
