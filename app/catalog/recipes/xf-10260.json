  "steps": [
    {
      "text": "冬瓜去皮，切成方块，并在表皮上打上深1厘米的花刀,"
    },
    {
      "text": "青椒切成小块，大蒜去皮切块，豆豉洗净沥干水,"
    },
    {
      "text": "锅内热2大匙油，放入冬瓜煎至表面微黄色,"
    },
    {
      "text": "将冬瓜块拨到一边，放入豆豉大蒜煸炒出香味,"
    },
    {
      "text": "倒入高汤或清水1/2杯，盐 1/2茶匙，煮开后加盖转小火焖,"
    },
    {
      "text": "焖至冬瓜软烂，加入鸡精 1/2茶匙,"
    },
    {
      "text": "加入青椒煮至青椒断生即可"
    }
  ],
