  "steps": [
    {
      "text": "排骨放入冷水中煮沸后略滚一会，除去血水,"
    },
    {
      "text": "砂锅里重新倒入适量热水，放入排骨，放少许料酒，大火煮沸后，转小火炖30分钟,"
    },
    {
      "text": "放入菌菇，继续炖15分钟,"
    },
    {
      "text": "最后放入豆腐，再炖10分钟，放少许盐调味，关火"
    }
  ],
