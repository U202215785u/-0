    "steps": [
      {
        "text": "Slice flank steak into medium or 1/4-inch slices. Rinse in room-temperature water, then drain and squeeze out excess water.",
        "ingredientNames": [
          "flank steak"
        ]
      },
      {
        "text": "Slice yellow onion to 1/4-inch thickness. Wash the bean sprouts. Cut scallions into 1-inch pieces and separate white from green parts.",
        "ingredientNames": [
          "yellow onion",
          "bean sprouts",
          "scallions"
        ]
      },
      {
        "text": "Mix the marinade ingredients except cooking oil. Coat the beef, then mix in cooking oil.",
        "ingredientNames": [
          "cooking oil",
          "flank steak"
        ]
      },
      {
        "text": "Loosen fresh flat rice noodles completely before heating the wok. Mix the chow fun sauce in a small bowl.",
        "ingredientNames": [
          "fresh flat rice noodles"
        ]
      },
      {
        "text": "Heat the wok on the highest heat for ~1.5 minutes. Add cooking oil; heat about ~30 seconds until it ripples. Stir-fry the beef for 40 to 60 seconds; remove it while still slightly red.",
        "ingredientNames": [
          "cooking oil",
          "flank steak"
        ]
      },
      {
        "text": "Wipe down the wok. Fry onion and scallion whites for 20 to 30 seconds until fragrant. Add noodles and disturb them as little as possible.",
        "ingredientNames": [
          "yellow onion",
          "scallions",
          "fresh flat rice noodles"
        ]
      },
      {
        "text": "Cook noodles for ~2 minutes until golden and aromatic. Add the prepared sauce and cook ~1 minute until coated.",
        "ingredientNames": [
          "fresh flat rice noodles",
          "tamari or dark soy sauce",
          "soy sauce",
          "oyster sauce"
        ]
      },
      {
        "text": "Add bean sprouts and scallion greens; cook for 30 to 45 seconds. Return the beef, cook ~1 minute, turn off the heat, and add sesame oil.",
        "ingredientNames": [
          "bean sprouts",
          "scallions",
          "flank steak",
          "sesame oil"
        ]
      }
    ],
